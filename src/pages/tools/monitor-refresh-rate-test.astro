                                            let totalStallMs = 0;
                                            while (tick < totalSpan) {
                                                while (gi < gpuTimes.length && gpuTimes[gi] <= tick) gi++;
                                                const missed = gi > 0 && gpuTimes[gi - 1] < tick - fixedInterval;
                                                if (missed) {
                                                    missedCount++;
                                                    totalStallMs += tick - fixedInterval - gpuTimes[gi - 1];
                                                }
                                                fCtx.fillStyle = missed ? "#ef4444" : "#f59e0b";
                                                fCtx.globalAlpha = 0.85;
                                                fCtx.fillRect(x, 20, Math.max(barWf - 2, 1), 50);
                                                x += barWf;
                                                tick += fixedInterval;
                                            }
                                            fCtx.globalAlpha = 1;

                                            const missedEl = document.getElementById("vrr-missed");
                                            const stallEl = document.getElementById("vrr-stall");
                                            const ontimeEl = document.getElementById("vrr-ontime");
                                            const sampleEl = document.getElementById("vrr-sample");
                                            const metricsBox = document.getElementById("vrr-metrics");
                                            if (missedEl) missedEl.textContent = String(missedCount);
                                            if (stallEl) stallEl.textContent = totalStallMs.toFixed(1) + " ms";
                                            if (ontimeEl) ontimeEl.textContent = "100%";
                                            if (sampleEl) sampleEl.textContent = `${recentIntervals.length} real frames`;
                                            if (metricsBox) metricsBox.style.display = "grid";

                                            lastVrrMissed = missedCount;
                                            lastVrrStallMs = totalStallMs;

                // Variable refresh: bar drawn right at each frame's ready time
                vCtx.clearRect(0, 0, varCvs.width, 90);
                const scaleX = varCvs.width / totalSpan;
                let prevT = 0;
                gpuTimes.forEach((t) => {
                    const bw = Math.max((t - prevT) * scaleX - 2, 2);
                    vCtx.fillStyle = "#22c55e";
                    vCtx.globalAlpha = 0.85;
                    vCtx.fillRect(prevT * scaleX, 20, bw, 50);
                    prevT = t;
                });
                vCtx.globalAlpha = 1;

                showToast("Simulation updated — try running it again for a new pattern");
            });

            document.addEventListener(
                "astro:before-swap",
                () => {
                    if (st.rafId) cancelAnimationFrame(st.rafId);
                    if (motionRaf) cancelAnimationFrame(motionRaf);
                    window.removeEventListener("resize", resizeChart);
                },
                { once: true },
            );
        });
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(featureListSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Base>
