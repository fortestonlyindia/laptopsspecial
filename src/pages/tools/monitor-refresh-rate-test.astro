    <script>
        interface RefreshState {
            frameTimes: number[]; // for chart, capped at 150
            allIntervals: number[]; // full session for stats
            lastTs: number | null;
            rafId: number | null;
            startTime: number | null;
            droppedCount: number;
        }

        function gradeFromConsistency(pct: number): { grade: string; cls: string } {
            if (pct >= 95) return { grade: "A", cls: "grade-A" };
            if (pct >= 85) return { grade: "B", cls: "grade-B" };
            if (pct >= 70) return { grade: "C", cls: "grade-C" };
            if (pct >= 60) return { grade: "D", cls: "grade-D" };
            return { grade: "F", cls: "grade-F" };
        }

        function nearestStandard(hz: number): string {
            const standards = [60, 75, 90, 120, 144, 165, 180, 240, 360];
            let closest = standards[0];
            let diff = Math.abs(hz - closest);
            for (const s of standards) {
                const d = Math.abs(hz - s);
                if (d < diff) {
                    diff = d;
                    closest = s;
                }
            }
            return `${closest}Hz`;
        }
        function getDiagSessionId(): string {
            let id = sessionStorage.getItem("ls_diag_session");
            if (!id) {
                id = `${Date.now()}-${Math.random().toString(36).slice(2)}`;
                sessionStorage.setItem("ls_diag_session", id);
            }
            return id;
        }

        function isFromThisSession(key: string): boolean {
            try {
                const raw = localStorage.getItem(key);
                if (!raw) return false;
                const parsed = JSON.parse(raw);
                return parsed.sessionId === getDiagSessionId();
            } catch {
                return false;
            }
        }

        function startFreshDiagSession() {
            try {
                localStorage.removeItem("ls_diag_monitor");
                localStorage.removeItem("ls_diag_keyboard");
                localStorage.removeItem("ls_diag_mouse");
                sessionStorage.removeItem("ls_diag_session");
            } catch (e) {
                // storage unavailable — ignore
            }
            location.reload();
        }
        document.addEventListener("astro:page-load", () => {
            const els = {
                current: document.getElementById("live-hz-display"),
                sCurrent: document.getElementById("s-current"),
                sAvg: document.getElementById("s-avg"),
                sMinMax: document.getElementById("s-minmax"),
                sGrade: document.getElementById("s-grade"),
                sGradeSub: document.getElementById("s-grade-sub"),
                mFrametime: document.getElementById("m-frametime"),
                mDropped: document.getElementById("m-dropped"),
                mJitter: document.getElementById("m-jitter"),
                mFrames: document.getElementById("m-frames"),
                mDuration: document.getElementById("m-duration"),
                mNearest: document.getElementById("m-nearest"),
                diagBox: document.getElementById("diag-box"),
                diagList: document.getElementById("diag-list"),
                toast: document.getElementById("toast"),
            };

            const chartCvs = document.getElementById("frame-chart") as HTMLCanvasElement | null;
            const cCtx = chartCvs?.getContext("2d") || null;

            let toastTimer: number | null = null;
            function showToast(msg: string) {
                if (!els.toast) return;
                els.toast.textContent = msg;
                els.toast.classList.add("show");
                if (toastTimer !== null) clearTimeout(toastTimer);
                toastTimer = window.setTimeout(() => els.toast?.classList.remove("show"), 2200);
            }

            let st: RefreshState = {
                            frameTimes: [],
                            allIntervals: [],
                            lastTs: null,
                            rafId: null,
                            startTime: null,
                            droppedCount: 0,
                        };
                        let lastAvgHz: number | null = null;
                        let lastStabilityPct: number | null = null;
                        let lastVrrMissed: number | null = null;
                        let lastVrrStallMs: number | null = null;

            function resizeChart() {
                if (!chartCvs) return;
                chartCvs.width = chartCvs.offsetWidth;
                chartCvs.height = 80;
                drawChart();
            }

            function drawChart() {
                if (!cCtx || !chartCvs) return;
                const w = chartCvs.width, h = chartCvs.height;
                cCtx.clearRect(0, 0, w, h);
                const data = st.frameTimes;
                if (data.length < 2) return;
                const barW = w / data.length;
                const maxT = Math.max(...data, 20);
                data.forEach((t, i) => {
                    const barH = Math.min((t / maxT) * h, h);
                    cCtx.fillStyle = t > 20 ? "#ef4444" : "#22c55e";
                    cCtx.globalAlpha = t > 20 ? 0.9 : 0.55;
                    cCtx.fillRect(i * barW, h - barH, Math.max(barW - 1, 1), barH);
