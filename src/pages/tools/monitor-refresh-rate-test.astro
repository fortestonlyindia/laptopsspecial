                <tr><td>120–144 Hz</td><td>6.9–8.3 ms</td><td>Mainstream competitive gaming</td><td><span class="badge badge-amber">Great</span></td></tr>
                <tr><td>240 Hz</td><td>4.17 ms</td><td>Esports / professional play</td><td><span class="badge badge-amber">Elite</span></td></tr>
                <tr><td>360 Hz+</td><td>&lt;2.8 ms</td><td>Top-tier competitive FPS</td><td><span class="badge badge-amber">Pro</span></td></tr>
