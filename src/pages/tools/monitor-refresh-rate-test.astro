---
import Base from "@layouts/Base.astro";
import { getProductsByPage, urlFor } from "../../lib/sanity";

let products: any[] = [];
try {
    products = (await getProductsByPage("monitor")) || [];
} catch (e) {
    products = [];
}

const pageUrl = "https://laptopsspecial.com/tools/monitor-refresh-rate-test/";
const siteUrl = "https://laptopsspecial.com/";

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: [
        {
            "@type": "Question",
            name: "Why does it show 60Hz when my monitor is 144Hz?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "Most common causes: your OS display setting hasn't been switched from the 60Hz default, you're using a cable that can't carry the full bandwidth, browser hardware acceleration is off, or your laptop is in a power-saving mode.",
            },
        },
        {
            "@type": "Question",
            name: "How accurate is a browser-based refresh rate test?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "requestAnimationFrame is tied to your display's vsync, so under normal conditions readings are accurate to within ±1–2Hz. Background tabs, high CPU load, or OS-level frame pacing can cause temporary dips, which the stability grade and frame-time chart are designed to surface.",
            },
        },
        {
            "@type": "Question",
            name: "What does the Stability Grade actually measure?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "It's the percentage of frames that land within ±15% of your session's median frame interval. A high average Hz with a low grade usually means your setup is technically capable but not consistently hitting that rate.",
            },
        },
        {
            "@type": "Question",
            name: "What's the difference between the VRR simulator and real G-Sync/FreeSync?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "This simulator is a visual explainer, not a hardware test, since your browser can't control your monitor's actual variable refresh window. It illustrates why VRR eliminates the stutter/tear pattern you'd get from a fixed refresh rate when frame times fluctuate.",
            },
        },
        {
            "@type": "Question",
            name: "Is the difference between 60Hz and 144Hz really noticeable?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "Yes, very much so, and it's most visible when scrolling quickly or dragging windows. At 144Hz edges stay sharp; at 60Hz there's clear motion blur. Improvements above 144Hz follow diminishing returns for most people.",
            },
        },
    ],
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: siteUrl,
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Monitor Refresh Rate Test",
            item: pageUrl,
        },
    ],
};

const featureListSchema = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "@id": `${pageUrl}#features`,
    name: "Monitor Refresh Rate Test — Key Features",
    itemListElement: [
        { "@type": "ListItem", position: 1, name: "Live Hz detection via requestAnimationFrame" },
        { "@type": "ListItem", position: 2, name: "Frame-time consistency chart with dropped-frame flagging" },
        { "@type": "ListItem", position: 3, name: "Stability grade (A–F) based on frame timing consistency" },
        { "@type": "ListItem", position: 4, name: "3-speed motion clarity test" },
        { "@type": "ListItem", position: 5, name: "VRR / G-Sync / FreeSync visual simulator" },
        { "@type": "ListItem", position: 6, name: "Shareable PNG result card export" },
        { "@type": "ListItem", position: 7, name: "Raw JSON data export" },
        { "@type": "ListItem", position: 8, name: "Fullscreen test mode" },
    ],
};

const softwareAppSchema = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": `${pageUrl}#software`,
    name: "Monitor Refresh Rate Test",
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
    url: pageUrl,
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    publisher: { "@id": `${siteUrl}#organization` },
    isPartOf: { "@id": `${siteUrl}#website` },
};

const webPageSchema = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: "Monitor Refresh Rate Test — Check Your Screen's Real Hz Online",
    description:
        "Test your monitor's real-time refresh rate, frame consistency and stability grade. Includes motion clarity test, VRR/G-Sync simulator, and shareable result card. Free, no download.",
    isPartOf: { "@id": `${siteUrl}#website` },
    about: { "@id": `${pageUrl}#software` },
    breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
    mainEntity: { "@id": `${pageUrl}#software` },
};
---

<Base
    title="Monitor Refresh Rate Test — Check Your Screen's Real Hz Online"
    description="Test your monitor's real-time refresh rate, frame consistency and stability grade. Includes motion clarity test, VRR/G-Sync simulator, and shareable result card. Free, no download."
    canonical="https://laptopsspecial.com/tools/monitor-refresh-rate-test/"
>
    <style>
        .hero {
            text-align: center;
            padding: 3rem 1.5rem 1.5rem;
        }
        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: rgba(245, 158, 11, 0.12);
            border: 1px solid rgba(245, 158, 11, 0.3);
            color: #f59e0b;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 0.3rem 0.8rem;
            border-radius: 100px;
            margin-bottom: 1.25rem;
        }
        [data-theme="light"] .hero-badge {
            color: #b45309;
            border-color: rgba(180, 83, 9, 0.35);
        }
        .hero h1 {
            font-size: clamp(1.75rem, 4vw, 2.75rem);
            font-weight: 700;
            color: var(--text);
            margin-bottom: 0.75rem;
        }
        .hero h1 span {
            color: #f59e0b;
        }
        [data-theme="light"] .hero h1 span {
            color: #b45309;
        }
        .hero p {
            color: var(--text2);
            font-size: 1rem;
            max-width: 560px;
            margin: 0 auto;
        }

        /* STATS */
        .stats-row {
            display: flex;
            justify-content: center;
            gap: 1rem;
            flex-wrap: wrap;
            padding: 1.5rem;
            max-width: 1080px;
            margin: 0 auto;
        }
        .stat-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1rem 1.4rem;
            text-align: center;
            min-width: 130px;
            flex: 1;
            transition: border-color 0.2s;
        }
        .stat-card:hover {
            border-color: rgba(245, 158, 11, 0.35);
        }
        .stat-label {
            font-size: 0.65rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--muted);
            margin-bottom: 0.4rem;
        }
        .stat-value {
            font-family: var(--font-mono);
            font-size: 1.55rem;
            font-weight: 700;
            color: #f59e0b;
        }
        [data-theme="light"] .stat-value {
            color: #b45309;
        }
        .stat-unit {
            font-size: 0.72rem;
            color: var(--muted);
            margin-top: 0.1rem;
        }
        .grade-value {
            font-family: var(--font-mono);
            font-size: 1.55rem;
            font-weight: 700;
        }
        .grade-A { color: #22c55e; }
        .grade-B { color: #84cc16; }
        .grade-C { color: #f59e0b; }
        .grade-D { color: #f97316; }
        .grade-F { color: #ef4444; }

        /* TOOL */
        .tool-container {
            max-width: 1080px;
            margin: 0 auto;
            padding: 0 1.5rem 1.5rem;
        }
        .tool-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
        }
        .tool-header {
            padding: 0.9rem 1.5rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
        .tool-title {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text2);
        }
        .tool-actions {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        .btn-sm {
            background: none;
            border: 1px solid var(--border);
            color: var(--muted);
            font-family: var(--font-display);
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.35rem 0.85rem;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.15s;
        }
        .btn-sm:hover {
            border-color: var(--muted);
            color: var(--text);
        }
        .btn-amber {
            border-color: rgba(245, 158, 11, 0.4);
            color: #f59e0b;
        }
        [data-theme="light"] .btn-amber {
            color: #b45309;
            border-color: rgba(180, 83, 9, 0.4);
        }
        .btn-amber:hover {
            background: rgba(245, 158, 11, 0.1);
        }
        .btn-amber.active {
            background: rgba(245, 158, 11, 0.15);
            border-color: #f59e0b;
        }

        /* TABS */
        .mode-tabs {
            display: flex;
            gap: 0.4rem;
            padding: 0.9rem 1.5rem 0;
            flex-wrap: wrap;
        }
        .mode-tab {
            background: none;
            border: 1px solid var(--border);
            color: var(--muted);
            font-family: var(--font-display);
            font-size: 0.78rem;
            font-weight: 600;
            padding: 0.5rem 1rem;
            border-radius: 8px 8px 0 0;
            cursor: pointer;
            transition: all 0.15s;
        }
        .mode-tab.active {
            color: #f59e0b;
            border-color: rgba(245, 158, 11, 0.4);
            background: rgba(245, 158, 11, 0.08);
        }
        [data-theme="light"] .mode-tab.active {
            color: #b45309;
        }

        /* LIVE PANEL */
        .test-panel {
            display: none;
        }
        .test-panel.active {
            display: block;
        }
        .live-zone {
            position: relative;
            min-height: 220px;
            background: #0a1020;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            text-align: center;
        }
        [data-theme="light"] .live-zone {
            background: #e8edf5;
        }
        .live-hz {
            font-family: var(--font-mono);
            font-size: clamp(3rem, 10vw, 5rem);
            font-weight: 700;
            color: #f59e0b;
            line-height: 1;
        }
        [data-theme="light"] .live-hz {
            color: #b45309;
        }
        .live-hz-unit {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--muted);
            margin-top: 0.4rem;
        }
        .live-prompt {
            color: var(--text2);
            font-size: 0.85rem;
            margin-top: 0.75rem;
            max-width: 380px;
        }

        /* FRAME TIME CHART */
        .chart-section {
            padding: 1rem 1.5rem 1.25rem;
            border-top: 1px solid var(--border);
        }
        .chart-label {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--muted);
            margin: 0 0 0.6rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .chart-legend {
            display: flex;
            gap: 0.9rem;
            font-size: 0.68rem;
            font-weight: 600;
            text-transform: none;
            letter-spacing: 0;
        }
        .leg-dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 2px;
            margin-right: 0.25rem;
        }
        #frame-chart {
            width: 100%;
            height: 80px;
            display: block;
        }

        /* METRICS GRID */
        .metrics-section {
            padding: 0.9rem 1.5rem 1.25rem;
            border-top: 1px solid var(--border);
        }
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 0.75rem;
        }
        .metric-item {
            background: var(--bg3);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 0.75rem 1rem;
        }
        .metric-name {
            font-size: 0.65rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--muted);
            margin-bottom: 0.3rem;
        }
        .metric-val {
            font-family: var(--font-mono);
            font-size: 0.95rem;
            font-weight: 700;
            color: #f59e0b;
        }
        [data-theme="light"] .metric-val {
            color: #b45309;
        }

        /* MOTION TEST */
        .motion-zone {
            position: relative;
            height: 240px;
            background: #05070d;
            overflow: hidden;
        }
        [data-theme="light"] .motion-zone {
            background: #dbe2ec;
        }
        .motion-track {
            position: relative;
            height: 70px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            display: flex;
            align-items: center;
        }
        .motion-track-label {
            position: absolute;
            left: 10px;
            top: 6px;
            font-size: 0.68rem;
            font-weight: 700;
            color: var(--muted);
            z-index: 2;
        }
        .motion-block {
            position: absolute;
            width: 46px;
            height: 46px;
            border-radius: 6px;
            top: 12px;
            left: 0;
            will-change: transform;
        }
        .mb-1x { background: #f59e0b; }
        .mb-2x { background: #22c55e; }
        .mb-4x { background: #00d4ff; }

        .motion-controls {
            padding: 1rem 1.5rem;
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }
        .motion-controls p {
            font-size: 0.8rem;
            color: var(--text2);
            margin: 0;
            flex: 1;
            min-width: 220px;
        }

        /* VRR SIM */
        .vrr-zone {
            padding: 1.5rem;
            background: #0a1020;
        }
        [data-theme="light"] .vrr-zone {
            background: #e8edf5;
        }
        .vrr-row {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 1rem;
        }
        .vrr-col {
            flex: 1;
            min-width: 260px;
            background: var(--bg3);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 1rem;
        }
        .vrr-col h4 {
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 0.5rem;
        }
        .vrr-canvas {
            width: 100%;
            height: 90px;
            display: block;
            border-radius: 6px;
        }
        .vrr-desc {
            font-size: 0.74rem;
            color: var(--muted);
            margin-top: 0.5rem;
            line-height: 1.5;
        }

        /* DIAGNOSTIC */
        .diag-box {
            margin: 0 1.5rem 1.5rem;
            padding: 1rem 1.2rem;
            border-radius: 10px;
            border: 1px solid rgba(245, 158, 11, 0.3);
            background: rgba(245, 158, 11, 0.06);
            display: none;
        }
        .diag-box.show {
            display: block;
        }
        .diag-title {
            font-size: 0.82rem;
            font-weight: 700;
            color: #f59e0b;
            margin-bottom: 0.5rem;
        }
        [data-theme="light"] .diag-title {
            color: #b45309;
        }
        .diag-box ul {
            font-size: 0.8rem;
            color: var(--text2);
            line-height: 1.7;
            padding-left: 1.2rem;
        }

        /* TOAST */
        .toast {
            position: fixed;
            bottom: 1.5rem;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            background: var(--bg3);
            border: 1px solid var(--border);
            color: var(--text);
            font-size: 0.82rem;
            font-weight: 600;
            padding: 0.65rem 1.1rem;
            border-radius: 8px;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s ease, transform 0.2s ease;
            z-index: 100;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
        }
        .toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        /* CTA */
        .cta-banner {
            max-width: 1080px;
            margin: 1.5rem auto;
            padding: 0 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }
        .cta-inner {
            background: linear-gradient(135deg, rgba(0, 212, 255, 0.08), rgba(124, 58, 237, 0.08));
            border: 1px solid rgba(0, 212, 255, 0.2);
            border-radius: 12px;
            padding: 1.1rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }
        .cta-text {
            font-size: 0.88rem;
            color: var(--text2);
        }
        .cta-text strong {
            color: var(--text);
        }
        .cta-btn {
            background: var(--accent);
            color: #0a0e1a;
            font-family: var(--font-display);
            font-size: 0.83rem;
            font-weight: 700;
            padding: 0.55rem 1.2rem;
            border-radius: 8px;
            text-decoration: none;
            transition: opacity 0.15s;
            white-space: nowrap;
        }
        .cta-btn:hover {
            opacity: 0.85;
        }

        /* CONTENT */
        .content-section {
            max-width: 1080px;
            margin: 0 auto;
            padding: 2rem 1.5rem;
        }
        .content-section h2 {
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 0.7rem;
            color: var(--text);
        }
        .content-section p {
            color: var(--text2);
            line-height: 1.75;
            font-size: 0.88rem;
            margin-bottom: 0.75rem;
        }
        .rate-table {
            width: 100%;
            border-collapse: collapse;
            margin: 1rem 0;
            font-size: 0.84rem;
        }
        .rate-table th {
            background: var(--bg3);
            color: var(--muted);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            padding: 0.6rem 1rem;
            text-align: left;
        }
        .rate-table td {
            padding: 0.6rem 1rem;
            border-bottom: 1px solid var(--border);
            color: var(--text2);
        }
        .rate-table tr:last-child td {
            border-bottom: none;
        }
        .badge {
            display: inline-block;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
        }
        .badge-green { background: rgba(34, 197, 94, 0.15); color: #22c55e; }
        .badge-blue { background: rgba(0, 212, 255, 0.12); color: var(--accent); }
        .badge-amber { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
        [data-theme="light"] .badge-amber { color: #b45309; }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin: 1rem 0;
        }
        .info-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 1rem;
        }
        .info-card-icon { font-size: 1.2rem; margin-bottom: 0.45rem; }
        .info-card-title { font-size: 0.83rem; font-weight: 600; color: var(--text); margin-bottom: 0.3rem; }
        .info-card-desc { font-size: 0.78rem; color: var(--text2); line-height: 1.55; }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1rem;
            margin: 1rem 0;
        }
        .product-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            transition: border-color 0.2s, transform 0.2s;
        }
        .product-card:hover {
            border-color: rgba(245, 158, 11, 0.35);
            transform: translateY(-2px);
        }
        .product-img { width: 100%; aspect-ratio: 3/2; object-fit: cover; }
        .product-body { padding: 1rem; }
        .product-name { font-size: 0.9rem; font-weight: 700; color: var(--text); margin-bottom: 0.4rem; }
        .product-desc { font-size: 0.78rem; color: var(--text2); line-height: 1.5; margin-bottom: 0.6rem; }
        .product-cta { font-size: 0.78rem; font-weight: 600; color: #f59e0b; }
        [data-theme="light"] .product-cta { color: #b45309; }

        .faq-list {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            margin-top: 1rem;
        }
        .faq-item {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 1rem;
        }
        .faq-q { font-size: 0.875rem; font-weight: 600; color: var(--text); margin-bottom: 0.35rem; }
        .faq-a { font-size: 0.82rem; color: var(--text2); line-height: 1.65; }

        @media (max-width: 640px) {
            .live-hz { font-size: 3rem; }
        }
        .confidence-badge {
            display: none;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.8rem;
            font-weight: 700;
            padding: 0.45rem 0.9rem;
            border-radius: 100px;
            margin: 0.75rem auto 0;
            width: fit-content;
        }
        .confidence-badge.show { display: flex; }
        .confidence-dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        .confidence-badge.status-good {
            background: rgba(34, 197, 94, 0.12);
            border: 1px solid rgba(34, 197, 94, 0.3);
            color: #22c55e;
        }
        .confidence-badge.status-good .confidence-dot { background: #22c55e; }

        .confidence-badge.status-check {
            background: rgba(245, 158, 11, 0.12);
            border: 1px solid rgba(245, 158, 11, 0.3);
            color: #f59e0b;
        }
        .confidence-badge.status-check .confidence-dot { background: #f59e0b; }

        .confidence-badge.status-investigate {
            background: rgba(239, 68, 68, 0.12);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #ef4444;
        }
