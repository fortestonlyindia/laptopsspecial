    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script>
        interface RefreshState {
            frameTimes: number[]; // for chart, capped at 150
            allIntervals: number[]; // full session for stats
            lastTs: number | null;
            rafId: number | null;
            startTime: number | null;
            droppedCount: number;
        }

        function gradeFromConsistency(pct: number): { grade: string; cls: string } {
            if (pct >= 95) return { grade: "A", cls: "grade-A" };
            if (pct >= 85) return { grade: "B", cls: "grade-B" };
            if (pct >= 70) return { grade: "C", cls: "grade-C" };
            if (pct >= 60) return { grade: "D", cls: "grade-D" };
            return { grade: "F", cls: "grade-F" };
        }

        function nearestStandard(hz: number): string {
            const standards = [60, 75, 90, 120, 144, 165, 180, 240, 360];
            let closest = standards[0];
            let diff = Math.abs(hz - closest);
            for (const s of standards) {
                const d = Math.abs(hz - s);
                if (d < diff) {
                    diff = d;
                    closest = s;
                }
            }
            return `${closest}Hz`;
        }

        document.addEventListener("astro:page-load", () => {
            const els = {
                current: document.getElementById("live-hz-display"),
                sCurrent: document.getElementById("s-current"),
                sAvg: document.getElementById("s-avg"),
                sMinMax: document.getElementById("s-minmax"),
                sGrade: document.getElementById("s-grade"),
                sGradeSub: document.getElementById("s-grade-sub"),
                mFrametime: document.getElementById("m-frametime"),
                mDropped: document.getElementById("m-dropped"),
                mJitter: document.getElementById("m-jitter"),
                mFrames: document.getElementById("m-frames"),
                mDuration: document.getElementById("m-duration"),
                mNearest: document.getElementById("m-nearest"),
                diagBox: document.getElementById("diag-box"),
                diagList: document.getElementById("diag-list"),
                toast: document.getElementById("toast"),
            };

            const chartCvs = document.getElementById("frame-chart") as HTMLCanvasElement | null;
            const cCtx = chartCvs?.getContext("2d") || null;

            let toastTimer: number | null = null;
            function showToast(msg: string) {
                if (!els.toast) return;
                els.toast.textContent = msg;
                els.toast.classList.add("show");
                if (toastTimer !== null) clearTimeout(toastTimer);
                toastTimer = window.setTimeout(() => els.toast?.classList.remove("show"), 2200);
            }

            let st: RefreshState = {
                frameTimes: [],
                allIntervals: [],
                lastTs: null,
                rafId: null,
                startTime: null,
                droppedCount: 0,
            };

            function resizeChart() {
                if (!chartCvs) return;
                chartCvs.width = chartCvs.offsetWidth;
                chartCvs.height = 80;
                drawChart();
            }

            function drawChart() {
                if (!cCtx || !chartCvs) return;
                const w = chartCvs.width, h = chartCvs.height;
                cCtx.clearRect(0, 0, w, h);
                const data = st.frameTimes;
                if (data.length < 2) return;
                const barW = w / data.length;
                const maxT = Math.max(...data, 20);
                data.forEach((t, i) => {
                    const barH = Math.min((t / maxT) * h, h);
                    cCtx.fillStyle = t > 20 ? "#ef4444" : "#22c55e";
                    cCtx.globalAlpha = t > 20 ? 0.9 : 0.55;
                    cCtx.fillRect(i * barW, h - barH, Math.max(barW - 1, 1), barH);
                });
                cCtx.globalAlpha = 1;
            }

            function computeStats() {
                const ints = st.allIntervals;
                if (ints.length < 5) return;
                const hzVals = ints.map((i) => 1000 / i);
                const avgHz = hzVals.reduce((a, b) => a + b, 0) / hzVals.length;
                const minHz = Math.min(...hzVals);
                const maxHz = Math.max(...hzVals);

                if (els.sAvg) els.sAvg.textContent = String(Math.round(avgHz));
                if (els.sMinMax) els.sMinMax.textContent = `${Math.round(minHz)} / ${Math.round(maxHz)}`;

                const sorted = [...ints].sort((a, b) => a - b);
                const median = sorted[Math.floor(sorted.length / 2)];
                const withinRange = ints.filter((i) => Math.abs(i - median) <= median * 0.15).length;
                const pct = (withinRange / ints.length) * 100;
                const { grade, cls } = gradeFromConsistency(pct);
                if (els.sGrade) {
                    els.sGrade.textContent = grade;
                    els.sGrade.className = "grade-value " + cls;
                }
                if (els.sGradeSub) els.sGradeSub.textContent = `${pct.toFixed(0)}% frames consistent`;

                const mean = ints.reduce((a, b) => a + b, 0) / ints.length;
                const variance = ints.reduce((a, b) => a + (b - mean) ** 2, 0) / ints.length;
                const jitter = Math.sqrt(variance);
                if (els.mFrametime) els.mFrametime.textContent = mean.toFixed(2) + " ms";
                if (els.mJitter) els.mJitter.textContent = jitter.toFixed(3) + " ms";
                if (els.mDropped) els.mDropped.textContent = String(st.droppedCount);
                if (els.mFrames) els.mFrames.textContent = String(ints.length + 1);
                if (els.mNearest) els.mNearest.textContent = nearestStandard(avgHz);

                if (st.startTime) {
                    const dur = (performance.now() - st.startTime) / 1000;
                    if (els.mDuration) els.mDuration.textContent = dur.toFixed(1) + "s";
                }

                // Diagnostics
                const diagMsgs: string[] = [];
                if (avgHz < 65 && avgHz > 55) {
                    diagMsgs.push("Reading near 60Hz — if your monitor is rated higher, check your OS display settings are set to max refresh rate.");
                }
                if (pct < 70) {
                    diagMsgs.push("Low stability — close background apps/tabs, ensure your laptop is in high-performance power mode, and disable browser power-saving throttle if present.");
                }
                if (jitter > 3) {
                    diagMsgs.push("High jitter detected — this can indicate an inadequate cable standard or GPU driver issue rather than a monitor problem.");
                }
                if (diagMsgs.length > 0 && els.diagBox && els.diagList) {
                    els.diagList.innerHTML = diagMsgs.map((m) => `<li>${m}</li>`).join("");
                    els.diagBox.classList.add("show");
                } else if (els.diagBox) {
                    els.diagBox.classList.remove("show");
                }
            }

            function loop(ts: number) {
                st.rafId = requestAnimationFrame(loop);
                if (st.lastTs !== null) {
                    const dt = ts - st.lastTs;
                    if (dt > 0 && dt < 500) {
                        st.allIntervals.push(dt);
                        if (st.allIntervals.length > 2000) st.allIntervals.shift();
                        st.frameTimes.push(dt);
                        if (st.frameTimes.length > 150) st.frameTimes.shift();
                        if (dt > 20) st.droppedCount++;

                        const liveHz = Math.round(1000 / dt);
                        if (els.current) els.current.textContent = String(liveHz);
                        if (els.sCurrent) els.sCurrent.textContent = String(liveHz);
                    }
                }
                st.lastTs = ts;
                if (st.startTime === null) st.startTime = ts;

                if (st.allIntervals.length % 8 === 0) {
                    drawChart();
                    computeStats();
                }
            }

            resizeChart();
            window.addEventListener("resize", resizeChart);
            st.rafId = requestAnimationFrame(loop);

            // ---- Tabs ----
            const tabs = document.querySelectorAll(".mode-tab");
            const panels = document.querySelectorAll(".test-panel");
            tabs.forEach((tab) => {
                tab.addEventListener("click", () => {
                    tabs.forEach((t) => {
                        t.classList.remove("active");
                        t.setAttribute("aria-selected", "false");
                    });
                    tab.classList.add("active");
                    tab.setAttribute("aria-selected", "true");
                    const target = tab.getAttribute("data-panel");
                    panels.forEach((p) => p.classList.toggle("active", p.id === target));
                });
            });

            // ---- Fullscreen ----
            document.getElementById("btn-fullscreen")?.addEventListener("click", () => {
                const el = document.querySelector(".tool-card") as HTMLElement | null;
                if (!el) return;
                if (!document.fullscreenElement) {
                    el.requestFullscreen?.().catch(() => showToast("Fullscreen not supported"));
                } else {
                    document.exitFullscreen?.();
                }
            });

            // ---- Reset ----
            document.getElementById("btn-reset")?.addEventListener("click", () => {
                st.frameTimes = [];
                st.allIntervals = [];
                st.droppedCount = 0;
                st.startTime = performance.now();
                if (els.sAvg) els.sAvg.textContent = "0";
                if (els.sMinMax) els.sMinMax.textContent = "—";
                if (els.sGrade) {
                    els.sGrade.textContent = "—";
                    els.sGrade.className = "grade-value";
                }
                if (els.sGradeSub) els.sGradeSub.textContent = "run test first";
                if (els.mDropped) els.mDropped.textContent = "0";
                if (els.mFrames) els.mFrames.textContent = "0";
                if (els.diagBox) els.diagBox.classList.remove("show");
                drawChart();
                showToast("Test data reset");
            });

            // ---- Export JSON ----
            function downloadBlob(blob: Blob, filename: string) {
                const url = URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                a.remove();
                URL.revokeObjectURL(url);
            }

            document.getElementById("btn-json")?.addEventListener("click", () => {
                if (st.allIntervals.length < 5) {
                    showToast("Let the test run a couple seconds first");
                    return;
                }
                const ints = st.allIntervals;
                const hzVals = ints.map((i) => 1000 / i);
                const avgHz = hzVals.reduce((a, b) => a + b, 0) / hzVals.length;
                const data = {
                    generatedAt: new Date().toISOString(),
                    averageHz: Math.round(avgHz),
                    minHz: Math.round(Math.min(...hzVals)),
                    maxHz: Math.round(Math.max(...hzVals)),
                    droppedFrames: st.droppedCount,
                    totalFrames: ints.length + 1,
                    frameIntervalsMs: ints,
                };
                const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
                downloadBlob(blob, `refresh-rate-test-${Date.now()}.json`);
                showToast("Exported results as JSON");
            });

            // ---- Share card (PNG) ----
            document.getElementById("btn-share")?.addEventListener("click", () => {
                if (st.allIntervals.length < 5) {
                    showToast("Let the test run a couple seconds first");
                    return;
                }
                const ints = st.allIntervals;
                const hzVals = ints.map((i) => 1000 / i);
                const avgHz = Math.round(hzVals.reduce((a, b) => a + b, 0) / hzVals.length);
                const grade = els.sGrade?.textContent || "—";

                const cvs = document.createElement("canvas");
                cvs.width = 800;
                cvs.height = 450;
                const ctx = cvs.getContext("2d");
                if (!ctx) return;

                const bgGrad = ctx.createLinearGradient(0, 0, 800, 450);
                bgGrad.addColorStop(0, "#0a0e1a");
                bgGrad.addColorStop(1, "#151b2e");
                ctx.fillStyle = bgGrad;
                ctx.fillRect(0, 0, 800, 450);

                ctx.fillStyle = "#f59e0b";
                ctx.font = "bold 22px sans-serif";
                ctx.fillText("Monitor Refresh Rate Test", 40, 60);

                ctx.fillStyle = "#ffffff";
                ctx.font = "bold 110px monospace";
                ctx.fillText(String(avgHz), 40, 200);
                ctx.font = "bold 32px sans-serif";
                ctx.fillStyle = "#b8c5d6";
                ctx.fillText("Hz average", 40, 235);

                ctx.fillStyle = "#f59e0b";
                ctx.font = "bold 28px sans-serif";
                ctx.fillText(`Stability Grade: ${grade}`, 40, 290);

                ctx.fillStyle = "#8899aa";
                ctx.font = "16px sans-serif";
                ctx.fillText(`Dropped frames: ${st.droppedCount}  |  Total frames: ${ints.length + 1}`, 40, 325);

                ctx.fillStyle = "#00d4ff";
                ctx.font = "bold 18px sans-serif";
                ctx.fillText("laptopsspecial.com/monitor-refresh-rate-test", 40, 410);

                cvs.toBlob((blob) => {
                    if (blob) {
                        downloadBlob(blob, `refresh-rate-result-${Date.now()}.png`);
                        showToast("Shareable result card downloaded");
                    }
                }, "image/png");
            });

            // ---- Motion test ----
            let motionRunning = true;
            let motionRaf: number | null = null;
            function animateMotion(ts: number) {
                motionRaf = requestAnimationFrame(animateMotion);
                if (!motionRunning) return;
                const zone = document.getElementById("motion-zone");
                const w = zone ? zone.clientWidth - 46 : 600;
                const cycle = 2200; // ms for 1x to cross
                const t = ts % (cycle * 4);

                const b1 = document.getElementById("block-1x");
                const b2 = document.getElementById("block-2x");
                const b4 = document.getElementById("block-4x");

                const pos1 = ((ts % cycle) / cycle) * w;
                const pos2 = ((ts % (cycle / 2)) / (cycle / 2)) * w;
                const pos4 = ((ts % (cycle / 4)) / (cycle / 4)) * w;

                if (b1) b1.style.transform = `translateX(${pos1}px)`;
                if (b2) b2.style.transform = `translateX(${pos2}px)`;
                if (b4) b4.style.transform = `translateX(${pos4}px)`;
            }
            motionRaf = requestAnimationFrame(animateMotion);

            document.getElementById("btn-motion-toggle")?.addEventListener("click", (e) => {
                motionRunning = !motionRunning;
                const btn = e.currentTarget as HTMLElement;
                btn.textContent = motionRunning ? "⏸ Pause" : "▶ Play";
            });

            // ---- VRR Simulator ----
            document.getElementById("btn-vrr-run")?.addEventListener("click", () => {
                const fixedCvs = document.getElementById("vrr-fixed") as HTMLCanvasElement | null;
                const varCvs = document.getElementById("vrr-variable") as HTMLCanvasElement | null;
                if (!fixedCvs || !varCvs) return;
                fixedCvs.width = fixedCvs.offsetWidth;
                fixedCvs.height = 90;
                varCvs.width = varCvs.offsetWidth;
                varCvs.height = 90;
                const fCtx = fixedCvs.getContext("2d");
                const vCtx = varCvs.getContext("2d");
                if (!fCtx || !vCtx) return;

                // Simulated GPU frame-ready times (fluctuating, like real gameplay)
                const frameCount = 24;
                const gpuTimes: number[] = [];
                let acc = 0;
                for (let i = 0; i < frameCount; i++) {
                    acc += 8 + Math.random() * 14; // 8-22ms fluctuating render time
                    gpuTimes.push(acc);
                }
                const totalSpan = gpuTimes[gpuTimes.length - 1];

                // Fixed refresh: locked 60Hz grid (16.67ms) — frames must wait for next tick
                const fixedInterval = 16.67;
                fCtx.clearRect(0, 0, fixedCvs.width, 90);
                let tick = 0;
                let gi = 0;
                const barWf = fixedCvs.width / Math.ceil(totalSpan / fixedInterval);
                let x = 0;
                while (tick < totalSpan) {
                    while (gi < gpuTimes.length && gpuTimes[gi] <= tick) gi++;
                    const missed = gi > 0 && gpuTimes[gi - 1] < tick - fixedInterval;
                    fCtx.fillStyle = missed ? "#ef4444" : "#f59e0b";
                    fCtx.globalAlpha = 0.85;
                    fCtx.fillRect(x, 20, Math.max(barWf - 2, 1), 50);
                    x += barWf;
                    tick += fixedInterval;
                }
                fCtx.globalAlpha = 1;

                // Variable refresh: bar drawn right at each frame's ready time
                vCtx.clearRect(0, 0, varCvs.width, 90);
                const scaleX = varCvs.width / totalSpan;
                let prevT = 0;
                gpuTimes.forEach((t) => {
                    const bw = Math.max((t - prevT) * scaleX - 2, 2);
                    vCtx.fillStyle = "#22c55e";
                    vCtx.globalAlpha = 0.85;
                    vCtx.fillRect(prevT * scaleX, 20, bw, 50);
                    prevT = t;
                });
                vCtx.globalAlpha = 1;

                showToast("Simulation updated — try running it again for a new pattern");
            });

            document.addEventListener(
                "astro:before-swap",
                () => {
                    if (st.rafId) cancelAnimationFrame(st.rafId);
                    if (motionRaf) cancelAnimationFrame(motionRaf);
                    window.removeEventListener("resize", resizeChart);
                },
                { once: true },
            );
        });
    </script>
