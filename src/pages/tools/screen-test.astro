        <div
          id="fs-mb-1"
          style="position:absolute; width:34px; height:34px; border-radius:6px; top:8px; left:0; background:#2dd4bf; will-change:transform;"
        >
        </div>
      </div>
      <div style="position:relative; height:50px;">
        <div
          id="fs-mb-2"
          style="position:absolute; width:34px; height:34px; border-radius:6px; top:8px; left:0; background:#f59e0b; will-change:transform;"
        >
        </div>
      </div>
      <div style="position:relative; height:50px;">
        <div
          id="fs-mb-3"
          style="position:absolute; width:34px; height:34px; border-radius:6px; top:8px; left:0; background:#a78bfa; will-change:transform;"
        >
        </div>
      </div>
    </div>
    <div class="fs-hud">
      <div>
        <div class="fs-hud-label" id="fs-hud-label">Black Screen</div>
        <div class="fs-hud-sub" id="fs-hud-sub">
          Tap anywhere or press Esc to exit
        </div>
      </div>
      <div class="fs-hud-actions" id="fs-hud-actions">
        <button class="fs-btn issue" id="fs-btn-issue">⚠ Mark Issue Here</button
        >
        <button class="fs-btn" id="fs-btn-prev">◀ Prev</button>
        <button class="fs-btn" id="fs-btn-next">Next ▶</button>
        <button class="fs-btn" id="fs-btn-exit">✕ Exit</button>
      </div>
    </div>
    <div class="zoom-loupe" id="zoom-loupe">
      <div class="zoom-loupe-inner" id="zoom-loupe-inner"></div>
    </div>
  </div>

  <!-- SUMMARY MODAL -->
  <div id="summary-modal">
    <div class="summary-card">
      <h3 id="summary-title">Screen Health Check Complete</h3>
      <p style="font-size:0.82rem;color:var(--text2);" id="summary-desc"></p>
      <div class="summary-list" id="summary-list"></div>
      <div class="summary-actions">
        <button class="primary" id="summary-close">Done</button>
        <button class="secondary" id="summary-restart">Run Again</button>
      </div>
    </div>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    interface SeqStep {
      key: string;
      label: string;
      sub: string;
      mode: "color" | "static" | "grayscale" | "motion" | "refresh";
      color?: string;
      durationMs: number;
    }

    document.addEventListener("astro:page-load", () => {
      const overlay = document.getElementById(
        "fs-overlay",
      ) as HTMLElement | null;
      const colorLayer = document.getElementById(
        "fs-color-layer",
      ) as HTMLElement | null;
      const hudLabel = document.getElementById("fs-hud-label");
      const hudSub = document.getElementById("fs-hud-sub");
      const progressFill = document.getElementById(
        "fs-progress-fill",
      ) as HTMLElement | null;
      const refreshDisplay = document.getElementById(
        "fs-refresh-display",
      ) as HTMLElement | null;
      const refreshHz = document.getElementById("fs-refresh-hz");
      const toastEl = document.getElementById("toast");
      const summaryModal = document.getElementById("summary-modal");

      if (!overlay || !colorLayer) return;

      let toastTimer: number | null = null;
      function showToast(msg: string) {
        if (!toastEl) return;
        toastEl.textContent = msg;
        toastEl.classList.add("show");
        if (toastTimer !== null) clearTimeout(toastTimer);
        toastTimer = window.setTimeout(
          () => toastEl.classList.remove("show"),
          2000,
        );
      }

      function getDiagSessionId(): string {
        let id = sessionStorage.getItem("ls_diag_session");
        if (!id) {
          id = `${Date.now()}-${Math.random().toString(36).slice(2)}`;
          sessionStorage.setItem("ls_diag_session", id);
        }
        return id;
      }

      function isFromThisSession(key: string): boolean {
        try {
          const raw = localStorage.getItem(key);
          if (!raw) return false;
          const parsed = JSON.parse(raw);
          return parsed.sessionId === getDiagSessionId();
        } catch {
          return false;
        }
      }

      function startFreshDiagSession() {
        try {
          localStorage.removeItem("ls_diag_monitor");
          localStorage.removeItem("ls_diag_keyboard");
          localStorage.removeItem("ls_diag_mouse");
          localStorage.removeItem("ls_diag_screen");
          localStorage.removeItem("ls_diag_webcam");
          sessionStorage.removeItem("ls_diag_session");
        } catch (e) {
          // storage unavailable — ignore
        }
        location.reload();
      }

      // ---------- Individual swatch click -> single-color fullscreen ----------
      const swatches = document.querySelectorAll<HTMLElement>(".swatch");
      let autoTimer: number | null = null;
      let sequence: SeqStep[] = [];
      let seqIndex = 0;
      let issues: string[] = [];
      let refreshRaf: number | null = null;
      let refreshLastTs: number | null = null;
      let refreshSamples: number[] = [];
      let isSequenceMode = false;
      let lastResult: any = null;
      let fsMotionRaf: number | null = null;
      let zoomModeActive = false;

      function renderStatic(kind: string) {
        colorLayer!.style.background = "";
        colorLayer!.className = "";
        if (kind === "rgb") {
          colorLayer!.style.background =
            "linear-gradient(90deg,#ff0000 0%,#ff0000 33%,#00ff00 33%,#00ff00 66%,#0000ff 66%,#0000ff 100%)";
        } else if (kind === "gradient") {
          colorLayer!.style.background = "linear-gradient(90deg,#000,#fff)";
        } else if (kind === "grayscale") {
          colorLayer!.style.background =
            "linear-gradient(90deg, #000 0%,#000 10%, #1a1a1a 10%,#1a1a1a 20%, #333 20%,#333 30%, #4d4d4d 30%,#4d4d4d 40%, #666 40%,#666 50%, #808080 50%,#808080 60%, #999 60%,#999 70%, #b3b3b3 70%,#b3b3b3 80%, #ccc 80%,#ccc 90%, #fff 90%,#fff 100%)";
        } else if (kind === "checker") {
          colorLayer!.style.backgroundColor = "#fff";
          colorLayer!.style.backgroundImage =
            "linear-gradient(45deg,#000 25%,transparent 25%),linear-gradient(-45deg,#000 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#000 75%),linear-gradient(-45deg,transparent 75%,#000 75%)";
          colorLayer!.style.backgroundSize = "40px 40px";
          colorLayer!.style.backgroundPosition =
            "0 0,0 20px,20px -20px,-20px 0";
        } else if (kind === "banding") {
          colorLayer!.style.background =
            "linear-gradient(90deg,#1a1a1a,#2a2a2a,#3a3a3a,#4a4a4a,#5a5a5a,#6a6a6a)";
        } else if (kind === "banding-red") {
          colorLayer!.style.background =
            "linear-gradient(90deg,#1a0000,#2a0000,#3a0000,#4a0000,#5a0000,#6a0000)";
        } else if (kind === "banding-green") {
          colorLayer!.style.background =
            "linear-gradient(90deg,#001a00,#002a00,#003a00,#004a00,#005a00,#006a00)";
        } else if (kind === "banding-blue") {
          colorLayer!.style.background =
            "linear-gradient(90deg,#00001a,#00002a,#00003a,#00004a,#00005a,#00006a)";
        } else if (kind === "viewingangle") {
          colorLayer!.style.background =
            "linear-gradient(180deg,#1a1a1a 0%,#1a1a1a 20%,#ff0000 20%,#ff0000 40%,#808080 40%,#808080 60%,#0000ff 60%,#0000ff 80%,#333 80%,#333 100%)";
        } else if (kind === "gamma") {
          colorLayer!.style.backgroundImage =
            "linear-gradient(to right, transparent 50%, #808080 50%), repeating-linear-gradient(to bottom, #000 0px, #000 1px, #fff 1px, #fff 2px)";
          colorLayer!.style.backgroundSize = "100% 100%, 100% 2px";
        }
      }

      function openOverlay() {
        overlay!.classList.add("active");
        document.body.style.overflow = "hidden";
      }
      function closeOverlay() {
        overlay!.classList.remove("active");
        document.body.style.overflow = "";
        if (autoTimer !== null) {
          clearTimeout(autoTimer);
          autoTimer = null;
        }
        if (refreshRaf !== null) {
          cancelAnimationFrame(refreshRaf);
          refreshRaf = null;
        }
        refreshDisplay!.style.display = "none";
        stopFsMotion();
        isSequenceMode = false;
        zoomModeActive = false;
        document.getElementById("zoom-loupe")?.classList.remove("active");
        const zoomBtn = document.getElementById("fs-zoom-toggle");
        if (zoomBtn) zoomBtn.textContent = "🔍 Zoom: Off";
      }

      swatches.forEach((sw) => {
        sw.addEventListener("click", () => {
          const mode = sw.dataset.mode;
          const label = sw.dataset.label || "Screen Test";
          const kind = sw.dataset.kind || "";
          hudLabel!.textContent = label;
          hudSub!.textContent =
            kind === "viewingangle"
              ? "Tilt your screen forward/back slowly, watch for color or contrast shift"
              : kind === "gamma"
                ? "Step back ~1-2m and squint — the stripes should blend to match the gray"
                : "Tap anywhere or press Esc to exit";
          progressFill!.style.width = "0%";
          document.getElementById("fs-hud-actions")!.style.display = "none";
          if (mode === "color") {
            colorLayer!.style.background = sw.dataset.color || "#000";
            colorLayer!.style.backgroundImage = "";
            colorLayer!.className = "";
          } else {
            renderStatic(kind);
          }
          openOverlay();
        });
      });

      colorLayer.addEventListener("click", () => {
        if (!isSequenceMode) closeOverlay();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && overlay!.classList.contains("active")) {
          closeOverlay();
        }
      });

      // ---------- Sub-pixel zoom / loupe ----------
      const zoomToggleBtn = document.getElementById("fs-zoom-toggle");
      const zoomLoupe = document.getElementById("zoom-loupe");
      const zoomLoupeInner = document.getElementById("zoom-loupe-inner");

      zoomToggleBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        zoomModeActive = !zoomModeActive;
        zoomToggleBtn.textContent = zoomModeActive
          ? "🔍 Zoom: On"
          : "🔍 Zoom: Off";
        if (!zoomModeActive && zoomLoupe) {
          zoomLoupe.classList.remove("active");
        }
      });

      overlay?.addEventListener("mousemove", (e) => {
        if (!zoomModeActive || !zoomLoupe || !zoomLoupeInner || !colorLayer)
          return;
        const scale = 5;
        const loupeSize = 160;
        const vw = window.innerWidth;
        const vh = window.innerHeight;
        zoomLoupe.classList.add("active");
        zoomLoupe.style.left = `${e.clientX - loupeSize / 2}px`;
        zoomLoupe.style.top = `${e.clientY - loupeSize / 2}px`;

        zoomLoupeInner.style.width = `${vw * scale}px`;
        zoomLoupeInner.style.height = `${vh * scale}px`;
        zoomLoupeInner.style.background = colorLayer.style.background || "#000";
        zoomLoupeInner.style.backgroundImage =
          colorLayer.style.backgroundImage || "none";
        zoomLoupeInner.style.backgroundSize = `${vw * scale}px ${vh * scale}px`;
        zoomLoupeInner.style.left = `${-(e.clientX * scale - loupeSize / 2)}px`;
        zoomLoupeInner.style.top = `${-(e.clientY * scale - loupeSize / 2)}px`;
      });

      overlay?.addEventListener("mouseleave", () => {
        zoomLoupe?.classList.remove("active");
      });

      // ---------- Full Screen Health Check sequence ----------
      function buildSequence(): SeqStep[] {
        return [
          {
            key: "black",
            label: "Dead Pixel — Black Screen",
            sub: "Look for any glowing colored dot",
            mode: "color",
            color: "#000000",
            durationMs: 3500,
          },
          {
            key: "white",
            label: "Dead Pixel — White Screen",
            sub: "Look for any dark dot",
            mode: "color",
            color: "#ffffff",
            durationMs: 3500,
          },
          {
            key: "red",
            label: "Stuck Pixel — Red Screen",
            sub: "Look for any non-red dot",
            mode: "color",
            color: "#ff0000",
            durationMs: 2800,
          },
          {
            key: "green",
            label: "Stuck Pixel — Green Screen",
            sub: "Look for any non-green dot",
            mode: "color",
            color: "#00ff00",
            durationMs: 2800,
          },
          {
            key: "blue",
            label: "Stuck Pixel — Blue Screen",
            sub: "Look for any non-blue dot",
            mode: "color",
            color: "#0000ff",
            durationMs: 2800,
          },
          {
            key: "rgb",
            label: "Colors — RGB Bars",
            sub: "Check color accuracy and saturation",
            mode: "static",
            durationMs: 2800,
          },
          {
            key: "grayscale",
            label: "Grayscale Ramp",
            sub: "Check for smooth steps, no tint",
            mode: "grayscale",
            durationMs: 2800,
          },
          {
            key: "brightness",
            label: "Brightness — Gradient",
            sub: "Check visibility across full dark-to-light range",
            mode: "static",
            durationMs: 2800,
          },
          {
            key: "contrast",
            label: "Contrast — Checkerboard",
            sub: "Check edges stay sharp and black stays black",
            mode: "static",
            durationMs: 2800,
          },
          {
            key: "uniformity",
            label: "Uniformity — 50% Gray",
            sub: "Look for patchy brightness or color tint",
            mode: "color",
            color: "#808080",
            durationMs: 2800,
          },
          {
            key: "banding",
            label: "Color Banding — Dark Gradient Ramp",
            sub: "Look for visible steps instead of smooth gradient",
            mode: "static",
            durationMs: 2800,
          },
          {
            key: "banding-red",
            label: "Color Banding — Red Channel",
            sub: "Look for visible steps in the red gradient",
            mode: "static",
            durationMs: 2400,
          },
          {
            key: "banding-green",
            label: "Color Banding — Green Channel",
            sub: "Look for visible steps in the green gradient",
            mode: "static",
            durationMs: 2400,
          },
          {
            key: "banding-blue",
            label: "Color Banding — Blue Channel",
            sub: "Look for visible steps in the blue gradient",
            mode: "static",
            durationMs: 2400,
          },
          {
            key: "gamma",
            label: "Gamma Test (2.2)",
            sub: "Step back and squint — stripes should blend to match the gray",
            mode: "static",
            durationMs: 3200,
          },
          {
            key: "viewingangle",
            label: "Viewing Angle Test",
            sub: "Tilt your screen forward/back, watch for color or contrast shift",
            mode: "static",
            durationMs: 3200,
          },
          {
            key: "motion",
            label: "Motion Clarity",
            sub: "Watch the moving blocks below (return here after)",
            mode: "motion",
            durationMs: 3200,
          },
          {
            key: "refresh",
            label: "Refresh Rate — Live Hz",
            sub: "Measuring via requestAnimationFrame...",
            mode: "refresh",
            durationMs: 4000,
          },
        ];
      }

      function runRefreshMeasure() {
        refreshDisplay!.style.display = "block";
        refreshSamples = [];
        refreshLastTs = null;
        function loop(ts: number) {
          refreshRaf = requestAnimationFrame(loop);
          if (refreshLastTs !== null) {
            const dt = ts - refreshLastTs;
            if (dt > 0 && dt < 200) {
              refreshSamples.push(dt);
              if (refreshSamples.length > 90) refreshSamples.shift();
              const avg =
                refreshSamples.reduce((a, b) => a + b, 0) /
                refreshSamples.length;
              refreshHz!.textContent = String(Math.round(1000 / avg));
            }
          }
          refreshLastTs = ts;
        }
        refreshRaf = requestAnimationFrame(loop);
      }

      function stopRefreshMeasure() {
        if (refreshRaf !== null) {
          cancelAnimationFrame(refreshRaf);
          refreshRaf = null;
        }
      }

      function startFsMotion() {
        const zone = document.getElementById("fs-motion-zone");
        if (!zone) return;
        const zoneEl = zone;
        zoneEl.style.display = "flex";
        function loop(ts: number) {
          fsMotionRaf = requestAnimationFrame(loop);
          const w = zoneEl.clientWidth - 34;
          const cycle = 2000;
          const b1 = document.getElementById("fs-mb-1");
          const b2 = document.getElementById("fs-mb-2");
          const b3 = document.getElementById("fs-mb-3");
          if (b1)
            b1.style.transform = `translateX(${((ts % cycle) / cycle) * w}px)`;
          if (b2)
            b2.style.transform = `translateX(${((ts % (cycle / 2)) / (cycle / 2)) * w}px)`;
          if (b3)
            b3.style.transform = `translateX(${((ts % (cycle / 4)) / (cycle / 4)) * w}px)`;
        }
        fsMotionRaf = requestAnimationFrame(loop);
      }

      function stopFsMotion() {
        if (fsMotionRaf !== null) {
          cancelAnimationFrame(fsMotionRaf);
          fsMotionRaf = null;
        }
        const zone = document.getElementById("fs-motion-zone");
        if (zone) zone.style.display = "none";
      }

      function renderStep(step: SeqStep) {
        refreshDisplay!.style.display = "none";
        stopRefreshMeasure();
        stopFsMotion();
        hudLabel!.textContent = step.label;
        hudSub!.textContent = step.sub;
        colorLayer!.style.background = "";
        colorLayer!.style.backgroundImage = "";

        if (step.mode === "color") {
          colorLayer!.style.background = step.color || "#000";
        } else if (step.mode === "static" && step.key === "rgb") {
          renderStatic("rgb");
        } else if (step.mode === "static" && step.key === "brightness") {
          renderStatic("gradient");
        } else if (step.mode === "static" && step.key === "contrast") {
          renderStatic("checker");
        } else if (step.mode === "static" && step.key === "banding") {
          renderStatic("banding");
        } else if (step.mode === "static" && step.key === "banding-red") {
          renderStatic("banding-red");
        } else if (step.mode === "static" && step.key === "banding-green") {
          renderStatic("banding-green");
        } else if (step.mode === "static" && step.key === "banding-blue") {
          renderStatic("banding-blue");
        } else if (step.mode === "static" && step.key === "gamma") {
          renderStatic("gamma");
        } else if (step.mode === "static" && step.key === "viewingangle") {
          renderStatic("viewingangle");
        } else if (step.mode === "grayscale") {
          renderStatic("grayscale");
        } else if (step.mode === "motion") {
          colorLayer!.style.background = "#05070d";
          startFsMotion();
        } else if (step.mode === "refresh") {
          colorLayer!.style.background = "#000";
          runRefreshMeasure();
        }
      }

      function goToStep(i: number) {
        if (i < 0) i = 0;
        if (i >= sequence.length) {
          finishSequence();
          return;
        }
        seqIndex = i;
        renderStep(sequence[i]);
        progressFill!.style.width = `${((i + 1) / sequence.length) * 100}%`;
        if (autoTimer !== null) clearTimeout(autoTimer);
        autoTimer = window.setTimeout(
          () => goToStep(seqIndex + 1),
          sequence[i].durationMs,
        );
      }

      function finishSequence() {
        stopRefreshMeasure();
        closeOverlay();
        showSummary();
      }

      document
        .getElementById("fs-btn-next")
        ?.addEventListener("click", () => goToStep(seqIndex + 1));
      document
        .getElementById("fs-btn-prev")
        ?.addEventListener("click", () => goToStep(seqIndex - 1));
      document
        .getElementById("fs-btn-exit")
        ?.addEventListener("click", finishSequence);
      document.getElementById("fs-btn-issue")?.addEventListener("click", () => {
        const step = sequence[seqIndex];
        if (step && !issues.includes(step.label)) {
          issues.push(step.label);
          showToast(`Flagged: ${step.label}`);
        }
      });

      function startHealthCheck() {
        sequence = buildSequence();
        issues = [];
        seqIndex = 0;
        isSequenceMode = true;
        document.getElementById("fs-hud-actions")!.style.display = "flex";
        openOverlay();
        goToStep(0);
      }
      document
        .getElementById("btn-start-healthcheck")
        ?.addEventListener("click", startHealthCheck);

      // ---------- Summary + save result ----------
      function showSummary() {
        const list = document.getElementById("summary-list");
        const desc = document.getElementById("summary-desc");
        if (!list || !desc) return;

        const status: "good" | "check" | "investigate" =
          issues.length === 0
            ? "good"
            : issues.length <= 2
              ? "check"
              : "investigate";
        const score = status === "good" ? 95 : status === "check" ? 70 : 45;

        desc.textContent =
          status === "good"
            ? "No issues flagged during the sequence. Screen looks healthy across all checks."
            : `${issues.length} step(s) were flagged during the test — review below.`;

        list.innerHTML =
          issues.length === 0
            ? `<div class="summary-row">✅ No issues flagged</div>`
            : issues
                .map((i) => `<div class="summary-row flagged">⚠ ${i}</div>`)
                .join("");

        const avgHz = refreshSamples.length
          ? Math.round(
              1000 /
                (refreshSamples.reduce((a, b) => a + b, 0) /
                  refreshSamples.length),
            )
          : null;

        const badge = document.getElementById("screen-confidence");
        const badgeText = document.getElementById("screen-confidence-text");
        if (badge && badgeText) {
          badge.classList.add("show");
          badge.classList.remove(
            "status-good",
            "status-check",
            "status-investigate",
          );
          badge.classList.add(`status-${status}`);
          badgeText.textContent =
            status === "good"
              ? "Good — no issues flagged"
              : status === "check"
                ? `Check — ${issues.length} item(s) flagged`
                : `Investigate — ${issues.length} item(s) flagged`;
        }

        const result = {
          tool: "screen",
          score,
          status,
          metrics: {
            "Issues flagged": String(issues.length),
            "Refresh rate (during check)": avgHz ? `${avgHz} Hz` : "—",
            "Steps completed": `${sequence.length} / ${sequence.length}`,
          },
          timestamp: Date.now(),
          sessionId: getDiagSessionId(),
        };
        lastResult = result;

        try {
          localStorage.setItem("ls_diag_screen", JSON.stringify(result));
        } catch (e) {
          // localStorage unavailable
        }

        refreshNextBanner();
        summaryModal?.classList.add("active");
      }

      document
        .getElementById("summary-close")
        ?.addEventListener("click", () => {
          summaryModal?.classList.remove("active");
        });
      document
        .getElementById("summary-restart")
        ?.addEventListener("click", () => {
          summaryModal?.classList.remove("active");
          startHealthCheck();
        });

      // ---------- Reset ----------
      document.getElementById("btn-reset")?.addEventListener("click", () => {
        issues = [];
        seqIndex = 0;
        refreshSamples = [];
        lastResult = null;
        try {
          localStorage.removeItem("ls_diag_screen");
        } catch (e) {
          // storage unavailable
        }
        const badge = document.getElementById("screen-confidence");
        if (badge) {
          badge.classList.remove(
            "show",
            "status-good",
            "status-check",
            "status-investigate",
          );
        }
        const nextBanner = document.getElementById("next-step-banner");
        if (nextBanner) nextBanner.style.display = "none";
        showToast("Screen test results reset");
      });

      // ---------- Motion blur demo (inline, always running) ----------
      let motionRaf: number | null = null;
      function animateMotion(ts: number) {
        motionRaf = requestAnimationFrame(animateMotion);
        const zone = document.getElementById("motion-zone");
        const w = zone ? zone.clientWidth - 34 : 500;
        const cycle = 2000;
        const pos1 = ((ts % cycle) / cycle) * w;
        const pos2 = ((ts % (cycle / 2)) / (cycle / 2)) * w;
        const pos3 = ((ts % (cycle / 4)) / (cycle / 4)) * w;
        const b1 = document.getElementById("mb-1");
        const b2 = document.getElementById("mb-2");
        const b3 = document.getElementById("mb-3");
        if (b1) b1.style.transform = `translateX(${pos1}px)`;
        if (b2) b2.style.transform = `translateX(${pos2}px)`;
        if (b3) b3.style.transform = `translateX(${pos3}px)`;
      }
      motionRaf = requestAnimationFrame(animateMotion);

      document.getElementById("ppi-calc-btn")?.addEventListener("click", () => {
        const input = document.getElementById(
          "ppi-diagonal",
        ) as HTMLInputElement;
        const diagonal = parseFloat(input.value);
        if (!diagonal || diagonal <= 0) {
          showToast("Enter a valid screen size in inches");
          return;
        }

        const dpr = window.devicePixelRatio || 1;
        const widthPx = window.screen.width * dpr;
        const heightPx = window.screen.height * dpr;
        const diagonalPx = Math.sqrt(widthPx ** 2 + heightPx ** 2);
        const ppi = diagonalPx / diagonal;

        const resEl = document.getElementById("ppi-res");
        const valEl = document.getElementById("ppi-value");
        const dprEl = document.getElementById("ppi-dpr");
        const noteEl = document.getElementById("ppi-note");
        const resultBox = document.getElementById("ppi-result");

        if (resEl) resEl.textContent = `${widthPx} × ${heightPx}`;
        if (valEl) valEl.textContent = `${Math.round(ppi)} PPI`;
        if (dprEl) dprEl.textContent = `${dpr}x`;
        if (noteEl) {
          noteEl.textContent =
            ppi > 200
              ? "This is a high-density (Retina-class) display — text and images will look very sharp."
              : ppi > 120
                ? "This is a standard modern display density — sharp for typical viewing distances."
                : "This is a lower-density display — text may look less sharp up close, common on older or budget monitors.";
        }
        if (resultBox) resultBox.style.display = "flex";
      });

      // ---------- Contrast Ratio Estimator ----------
      const contrastSwatches =
        document.querySelectorAll<HTMLElement>(".contrast-swatch");
      const contrastResult = document.getElementById("contrast-result");
      contrastSwatches.forEach((sw) => {
        sw.addEventListener("click", () => {
          contrastSwatches.forEach((s) => s.classList.remove("selected"));
          sw.classList.add("selected");
          const level = parseInt(sw.dataset.level || "1", 10);
          let label = "";
          let ratio = "";
          if (level <= 2) {
            label = "Excellent";
            ratio = "3000:1+";
          } else if (level <= 3) {
            label = "Very Good";
            ratio = "~1000–1500:1";
          } else if (level <= 5) {
            label = "Good";
            ratio = "~600–900:1";
          } else {
            label = "Average / Low";
            ratio = "~300–500:1";
          }
          if (contrastResult) {
            contrastResult.classList.add("show");
            contrastResult.innerHTML = `<strong>${label}</strong> — estimated contrast ${ratio}. This is a subjective approximation based on how many dark steps you could distinguish, not a measured value.`;
          }
        });
      });

      // ---------- Next-step nudge (links to other diag tools) ----------
      const nextBanner = document.getElementById("next-step-banner");
      const nextText = document.getElementById("next-step-text");
      function refreshNextBanner() {
        if (!nextBanner || !nextText) return;
        if (!isFromThisSession("ls_diag_screen")) return;
        const remaining: { label: string; url: string }[] = [];
        if (!isFromThisSession("ls_diag_monitor"))
          remaining.push({
            label: "monitor",
            url: "/tools/monitor-refresh-rate-test/",
          });
        if (!isFromThisSession("ls_diag_keyboard"))
          remaining.push({
            label: "keyboard",
            url: "/tools/keyboard-latency-tester/",
          });
        if (!isFromThisSession("ls_diag_mouse"))
          remaining.push({ label: "mouse", url: "/tools/mouse-rate-test/" });
        if (!isFromThisSession("ls_diag_webcam"))
          remaining.push({
            label: "webcam/mic/speaker",
            url: "/tools/webcam-mic-speaker-test/",
          });

        let html: string;
        if (remaining.length === 0) {
          html =
            '🎉 Screen test done! <a href="/full-diagnostic-report/" target="_blank" rel="noopener" data-astro-reload style="color:#2dd4bf;font-weight:700;">View your Full Diagnostic Report →</a>';
        } else {
          html = `✅ Screen done. Also worth testing: ${remaining.map((r) => `<a href="${r.url}" data-astro-reload style="color:#2dd4bf;font-weight:700;">${r.label}</a>`).join(" &amp; ")}`;
        }
        nextBanner.style.display = "block";
        nextText.innerHTML = html;
      }
      document
        .getElementById("btn-fresh-start")
        ?.addEventListener("click", startFreshDiagSession);

      // ---------- PDF report ----------
      document.getElementById("btn-pdf")?.addEventListener("click", () => {
        const raw = localStorage.getItem("ls_diag_screen");
        if (!raw) {
          showToast("Run the Full Screen Health Check first");
          return;
        }
        const jsPDFLib = (window as any).jspdf;
        if (!jsPDFLib || !jsPDFLib.jsPDF) {
          showToast("Report generator still loading — try again");
          return;
        }
        const result = JSON.parse(raw);
        const { jsPDF } = jsPDFLib;
        const doc = new jsPDF({ unit: "pt", format: "a4" });
        const pageWidth = doc.internal.pageSize.getWidth();
        const margin = 48;
        let y = 56;

        doc.setFillColor(10, 14, 26);
        doc.rect(0, 0, pageWidth, 90, "F");
        doc.setTextColor(255, 255, 255);
        doc.setFont("helvetica", "bold");
        doc.setFontSize(18);
        doc.text("Laptops Special — Hardware Diagnostic Report", margin, 40);
        doc.setFont("helvetica", "normal");
        doc.setFontSize(10);
        doc.setTextColor(180, 190, 210);
        doc.text("Device: Screen", margin, 60);
        doc.text(`Generated: ${new Date().toLocaleString()}`, margin, 75);

        y = 120;
        const statusLabel =
          result.status === "good"
            ? "Good"
            : result.status === "check"
              ? "Check"
              : "Investigate";
        const statusColor: [number, number, number] =
          result.status === "good"
            ? [34, 197, 94]
            : result.status === "check"
              ? [245, 158, 11]
              : [239, 68, 68];
        doc.setFillColor(...statusColor);
        doc.roundedRect(margin, y, 90, 22, 4, 4, "F");
        doc.setTextColor(255, 255, 255);
        doc.setFont("helvetica", "bold");
        doc.setFontSize(11);
        doc.text(statusLabel, margin + 45, y + 15, { align: "center" });

        y += 45;
        doc.setDrawColor(220, 220, 225);
        doc.line(margin, y, pageWidth - margin, y);
        y += 22;
        doc.setFont("helvetica", "bold");
        doc.setFontSize(13);
        doc.setTextColor(20, 20, 30);
        doc.text("Screen Test Results", margin, y);
        y += 18;

        doc.setFont("helvetica", "normal");
        doc.setFontSize(10.5);
        Object.entries(result.metrics as Record<string, string>).forEach(
          ([label, val]) => {
            doc.setTextColor(90, 90, 100);
            doc.text(label, margin, y);
            doc.setTextColor(20, 20, 30);
            doc.setFont("helvetica", "bold");
            doc.text(String(val), pageWidth - margin, y, { align: "right" });
            doc.setFont("helvetica", "normal");
            y += 18;
          },
        );

        y += 16;
        doc.setDrawColor(220, 220, 225);
        doc.line(margin, y, pageWidth - margin, y);
        y += 18;
        doc.setFont("helvetica", "italic");
        doc.setFontSize(8.5);
        doc.setTextColor(130, 130, 140);
        const disclaimer = doc.splitTextToSize(
          "Dead/stuck pixel and backlight bleed detection require visual inspection by the user — a browser cannot read back what the display physically shows. See laptopsspecial.com/how-accurate-are-these-tests/ for full methodology.",
          pageWidth - margin * 2,
        );
        doc.text(disclaimer, margin, y);
        y += disclaimer.length * 11 + 10;
        doc.setFont("helvetica", "normal");
        doc.setTextColor(0, 150, 200);
        doc.text("laptopsspecial.com/tools/screen-test/", margin, y);

        doc.save(`screen-diagnostic-report-${Date.now()}.pdf`);
        showToast("Diagnostic report downloaded");
      });

      // ---------- CSV export ----------
      document.getElementById("btn-export")?.addEventListener("click", () => {
        const raw = localStorage.getItem("ls_diag_screen");
        if (!raw) {
          showToast("Run the Full Screen Health Check first");
          return;
        }
        const result = JSON.parse(raw);
        const rows = [["Metric", "Value"]];
        rows.push(["Status", result.status]);
        rows.push(["Score", String(result.score)]);
        Object.entries(result.metrics as Record<string, string>).forEach(
          ([k, v]) => rows.push([k, v]),
        );
        const csv = rows
          .map((r) => r.map((c) => `"${c}"`).join(","))
          .join("\n");
        const blob = new Blob([csv], { type: "text/csv" });
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = `screen-test-${Date.now()}.csv`;
        a.click();
        showToast("Results exported as CSV");
      });

      // ---------- JSON export (dedicated button) ----------
      document.getElementById("btn-json")?.addEventListener("click", () => {
        const raw = localStorage.getItem("ls_diag_screen");
        if (!raw) {
          showToast("Run the Full Screen Health Check first");
          return;
        }
        const result = JSON.parse(raw);
        const blob = new Blob([JSON.stringify(result, null, 2)], {
          type: "application/json",
        });
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = `screen-test-${Date.now()}.json`;
        a.click();
        showToast("Results exported as JSON");
      });

      // Restore badge if a result already exists this session
      (function restoreBadge() {
        try {
          const raw = localStorage.getItem("ls_diag_screen");
          if (!raw) return;
          const r = JSON.parse(raw);
          lastResult = r;
          const badge = document.getElementById("screen-confidence");
          const badgeText = document.getElementById("screen-confidence-text");
          if (badge && badgeText) {
            badge.classList.add("show", `status-${r.status}`);
            badgeText.textContent =
              r.status === "good"
                ? "Good — no issues flagged"
                : r.status === "check"
                  ? "Check — issues flagged"
                  : "Investigate — issues flagged";
          }
          refreshNextBanner();
        } catch (e) {}
      })();

      document.addEventListener(
        "astro:before-swap",
        () => {
          if (autoTimer !== null) clearTimeout(autoTimer);
          if (refreshRaf !== null) cancelAnimationFrame(refreshRaf);
          if (motionRaf !== null) cancelAnimationFrame(motionRaf);
          document.body.style.overflow = "";
        },
        { once: true },
      );
    });
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
</Base>
