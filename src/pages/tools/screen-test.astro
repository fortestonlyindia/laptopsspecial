---
import Base from "@layouts/Base.astro";

const pageUrl = "https://laptopsspecial.com/tools/screen-test/";
const siteUrl = "https://laptopsspecial.com/";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${pageUrl}#breadcrumb`,
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    { "@type": "ListItem", position: 2, name: "Screen Test", item: pageUrl },
  ],
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "@id": `${pageUrl}#howto-pwm`,
  name: "How to Check for PWM Flicker on Your Laptop Screen",
  description:
    "Two manual methods to detect PWM (Pulse-Width Modulation) backlight flicker, since browsers cannot measure it directly.",
  step: [
    {
      "@type": "HowToStep",
      name: "Camera Slow-Motion Method",
      text: "Open your phone camera, switch to slow-motion video mode, set this tool's brightness swatch to Gray, dim your laptop brightness to around 30-50%, and film the screen. Horizontal dark bands scrolling through the recording indicate PWM flicker.",
    },
    {
      "@type": "HowToStep",
      name: "Quick Wave Test",
      text: "With the Gray swatch open, wave a pen or your finger quickly in front of the screen at low brightness. A smooth blur means no visible flicker; a stuttering, strobing trail suggests PWM at low brightness levels.",
    },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq`,
  mainEntity: [
    {
      "@type": "Question",
      name: "What is a dead pixel vs a stuck pixel?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "A dead pixel stays permanently black — it receives no power at all. A stuck pixel stays fixed on one color (usually red, green, or blue) because one sub-pixel is stuck on while others are off. Stuck pixels can sometimes be fixed with pressure or flickering methods; dead pixels usually cannot.",
      },
    },
    {
      "@type": "Question",
      name: "Can a browser detect dead pixels automatically?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. A browser has no way to read back what your screen is physically displaying — it can only show you solid colors to look at. Detecting a dead or stuck pixel still requires your eyes; this tool's job is to give you clean, full-screen reference colors to check against.",
      },
    },
    {
      "@type": "Question",
      name: "What is backlight bleed and how do I check for it?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Backlight bleed is light leaking around the edges or corners of an LCD panel, most visible on a full black screen in a dark room. Run the black screen test, dim your room lights, and look for uneven glowing patches near the bezel.",
      },
    },
    {
      "@type": "Question",
      name: "Why does my screen look slightly different in this test than in real use?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Browser color rendering depends on your display's color profile, OS color management, and any blue-light/night-mode filters running. For the most accurate test, disable night light mode and run this test at 100% brightness in a dim room.",
      },
    },
    {
      "@type": "Question",
      name: "Is this the same as a hardware dead pixel checker?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "It follows the same principle as dedicated hardware checkers — full-screen solid colors — but runs entirely in your browser with no download. For panels you suspect have an issue, testing in a dark room at full brightness gives the most reliable result.",
      },
    },
  ],
};
---

<Base
  title="Screen Test Online — Dead Pixel, Color & Refresh Rate Checker"
  description="Free browser-based screen test: dead pixel checker, stuck pixel test, backlight bleed check, color/grayscale/gradient screens, brightness, contrast, motion blur and a one-click Full Screen Health Check. No download needed."
  canonical={pageUrl}
  datePublished="2026-08-18"
  dateModified="2026-08-18"
>
  <style>
    .hero {
      text-align: center;
      padding: 3rem 1.5rem 1.5rem;
    }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(20, 184, 166, 0.12);
      border: 1px solid rgba(20, 184, 166, 0.3);
      color: #2dd4bf;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.3rem 0.8rem;
      border-radius: 100px;
      margin-bottom: 1.25rem;
    }
    [data-theme="light"] .hero-badge {
      color: #0d9488;
      border-color: rgba(13, 148, 136, 0.35);
    }
    .hero h1 {
      font-size: clamp(1.75rem, 4vw, 2.75rem);
      font-weight: 700;
      color: var(--text);
      margin-bottom: 0.75rem;
    }
    .hero h1 span {
      color: #2dd4bf;
    }
    [data-theme="light"] .hero h1 span {
      color: #0d9488;
    }
    .hero p {
      color: var(--text2);
      font-size: 1rem;
      max-width: 560px;
      margin: 0 auto;
    }

    .healthcheck-banner {
      max-width: 1080px;
      margin: 0 auto 1.5rem;
      padding: 0 1.5rem;
    }
    .healthcheck-inner {
      background: linear-gradient(
        135deg,
        rgba(20, 184, 166, 0.12),
        rgba(0, 212, 255, 0.08)
      );
      border: 1px solid rgba(20, 184, 166, 0.3);
      border-radius: 14px;
      padding: 1.4rem 1.6rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .healthcheck-text h3 {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 0.3rem;
    }
    .healthcheck-text p {
      font-size: 0.85rem;
      color: var(--text2);
      max-width: 480px;
    }
    .btn-healthcheck {
      background: #2dd4bf;
      color: #04231f;
      font-family: var(--font-display);
      font-size: 0.9rem;
      font-weight: 700;
      padding: 0.75rem 1.5rem;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      white-space: nowrap;
      transition: opacity 0.15s;
    }
    .btn-healthcheck:hover {
      opacity: 0.85;
    }

    .confidence-badge {
      display: none;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 0.45rem 0.9rem;
      border-radius: 100px;
      margin: 0 auto 1rem;
      width: fit-content;
    }
    .confidence-badge.show {
      display: flex;
    }
    .confidence-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .confidence-badge.status-good {
      background: rgba(34, 197, 94, 0.12);
      border: 1px solid rgba(34, 197, 94, 0.3);
      color: #22c55e;
    }
    .confidence-badge.status-good .confidence-dot {
      background: #22c55e;
    }
    .confidence-badge.status-check {
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.3);
      color: #f59e0b;
    }
    .confidence-badge.status-check .confidence-dot {
      background: #f59e0b;
    }
    .confidence-badge.status-investigate {
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #ef4444;
    }
    .confidence-badge.status-investigate .confidence-dot {
      background: #ef4444;
    }

    .tool-container {
      max-width: 1080px;
      margin: 0 auto;
      padding: 0 1.5rem 1.5rem;
    }
    .tool-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
    }
    .tool-header {
      padding: 0.9rem 1.5rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .tool-title {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text2);
    }
    .tool-actions {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .btn-sm {
      background: none;
      border: 1px solid var(--border);
      color: var(--muted);
      font-family: var(--font-display);
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.35rem 0.85rem;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
    }
    .btn-sm:hover {
      border-color: var(--muted);
      color: var(--text);
    }
    .btn-teal {
      border-color: rgba(20, 184, 166, 0.4);
      color: #2dd4bf;
    }
    [data-theme="light"] .btn-teal {
      color: #0d9488;
      border-color: rgba(13, 148, 136, 0.4);
    }
    .btn-teal:hover {
      background: rgba(20, 184, 166, 0.1);
    }
    .btn-pdf {
      border-color: rgba(0, 212, 255, 0.4);
      color: var(--accent);
      font-weight: 700;
    }
    .btn-pdf:hover {
      border-color: var(--accent);
      background: rgba(0, 212, 255, 0.08);
    }
    .btn-fulldiag {
      border-color: rgba(34, 197, 94, 0.4);
      color: #22c55e;
      font-weight: 700;
    }
    .btn-fulldiag:hover {
      border-color: #22c55e;
      background: rgba(34, 197, 94, 0.08);
    }

    /* SWATCH GRID */
    .swatch-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 0.75rem;
      padding: 1.5rem;
    }
    .swatch {
      position: relative;
      height: 90px;
      border-radius: 10px;
      border: 1px solid var(--border);
      cursor: pointer;
      display: flex;
      align-items: flex-end;
      padding: 0.6rem;
      font-size: 0.72rem;
      font-weight: 700;
      transition: transform 0.15s;
      overflow: hidden;
    }
    .swatch:hover {
      transform: translateY(-2px);
    }
    .swatch span {
      background: rgba(0, 0, 0, 0.5);
      color: #fff;
      padding: 0.15rem 0.5rem;
      border-radius: 5px;
    }
    .sw-black {
      background: #000;
    }
    .sw-white {
      background: #fff;
    }
    .sw-red {
      background: #ff0000;
    }
    .sw-green {
      background: #00ff00;
    }
    .sw-blue {
      background: #0000ff;
    }
    .sw-rgb {
      background: linear-gradient(
        90deg,
        #ff0000 0%,
        #ff0000 33%,
        #00ff00 33%,
        #00ff00 66%,
        #0000ff 66%,
        #0000ff 100%
      );
    }
    .sw-gradient {
      background: linear-gradient(90deg, #000, #fff);
    }
    .sw-grayscale {
      background: repeating-linear-gradient(90deg, #000, #fff 100%);
    }
    .sw-checker {
      background-image:
        linear-gradient(45deg, #000 25%, transparent 25%),
        linear-gradient(-45deg, #000 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, #000 75%),
        linear-gradient(-45deg, transparent 75%, #000 75%);
      background-size: 20px 20px;
      background-position:
        0 0,
        0 10px,
        10px -10px,
        -10px 0px;
      background-color: #fff;
    }
    .sw-uniformity {
      background: #808080;
    }
    .sw-banding {
      background: linear-gradient(
        90deg,
        #1a1a1a,
        #2a2a2a,
        #3a3a3a,
        #4a4a4a,
        #5a5a5a,
        #6a6a6a
      );
    }

    .fullscreen-hint {
      text-align: center;
      color: var(--muted);
      font-size: 0.8rem;
      padding: 0 1.5rem 1.25rem;
    }

    /* MOTION TEST */
    .motion-section {
      padding: 0 1.5rem 1.5rem;
    }
    .motion-zone {
      position: relative;
      height: 180px;
      background: #05070d;
      border-radius: 10px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-evenly;
    }
    [data-theme="light"] .motion-zone {
      background: #dbe2ec;
    }
    .motion-track {
      position: relative;
      height: 40px;
    }
    .motion-block {
      position: absolute;
      width: 34px;
      height: 34px;
      border-radius: 6px;
      top: 3px;
      left: 0;
      will-change: transform;
    }
    .mb-1 {
      background: #2dd4bf;
    }
    .mb-2 {
      background: #f59e0b;
    }
    .mb-3 {
      background: #a78bfa;
    }

    /* TEXT SHARPNESS */
    .sharpness-box {
      margin: 0 1.5rem 1.5rem;
      padding: 1.5rem;
      background: #fff;
      color: #000;
      border-radius: 10px;
      font-size: 0.95rem;
      line-height: 1.6;
    }
    .sharpness-box small {
      display: block;
      font-size: 0.6rem;
      margin-top: 0.5rem;
      color: #333;
    }

    /* FULLSCREEN OVERLAY */
    #fs-overlay {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: none;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      cursor: pointer;
    }
    #fs-overlay.active {
      display: flex;
    }
    #fs-color-layer {
      position: absolute;
      inset: 0;
    }
    .fs-hud {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem 1.5rem;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(6px);
      flex-wrap: wrap;
    }
    .fs-hud-label {
      color: #fff;
      font-size: 0.85rem;
      font-weight: 700;
      font-family: var(--font-display);
    }
    .fs-hud-sub {
      color: #b8c5d6;
      font-size: 0.72rem;
    }
    .fs-hud-actions {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .fs-btn {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.25);
      color: #fff;
      font-family: var(--font-display);
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.45rem 0.9rem;
      border-radius: 6px;
      cursor: pointer;
    }
    .fs-btn:hover {
      background: rgba(255, 255, 255, 0.2);
    }
    .fs-btn.issue {
      border-color: rgba(239, 68, 68, 0.6);
      color: #fca5a5;
    }
    .fs-progress-track {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: rgba(255, 255, 255, 0.15);
    }
    .fs-progress-fill {
      height: 100%;
      background: #2dd4bf;
      width: 0%;
      transition: width 0.1s linear;
    }
    .fs-refresh-display {
      position: absolute;
      top: 1.5rem;
      left: 50%;
      transform: translateX(-50%);
      text-align: center;
      color: #fff;
    }
    .fs-refresh-hz {
      font-family: var(--font-mono);
      font-size: 3.5rem;
      font-weight: 700;
      color: #2dd4bf;
    }
    .fs-refresh-sub {
      font-size: 0.75rem;
      color: #b8c5d6;
    }

    /* SUMMARY MODAL */
    #summary-modal {
      position: fixed;
      inset: 0;
      z-index: 10000;
      display: none;
      align-items: center;
      justify-content: center;
      background: rgba(0, 0, 0, 0.7);
      padding: 1.5rem;
    }
    #summary-modal.active {
      display: flex;
    }
    .summary-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.75rem;
      max-width: 480px;
      width: 100%;
      max-height: 85vh;
      overflow-y: auto;
    }
    .summary-card h3 {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 0.5rem;
    }
    .summary-list {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin: 1rem 0;
    }
    .summary-row {
      display: flex;
      justify-content: space-between;
      font-size: 0.82rem;
      padding: 0.5rem 0.75rem;
      background: var(--bg3);
      border-radius: 8px;
      color: var(--text2);
    }
    .summary-row.flagged {
      color: #ef4444;
      font-weight: 700;
    }
    .summary-actions {
      display: flex;
      gap: 0.6rem;
      flex-wrap: wrap;
      margin-top: 1.25rem;
    }
    .summary-actions button {
      flex: 1;
      min-width: 120px;
      padding: 0.6rem 1rem;
      border-radius: 8px;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 0.8rem;
      cursor: pointer;
    }
    .summary-actions .primary {
      background: #2dd4bf;
      color: #04231f;
      border: none;
    }
    .summary-actions .secondary {
      background: none;
      border: 1px solid var(--border);
      color: var(--text2);
    }

    /* CTA + CONTENT (shared pattern) */
    .cta-banner {
      max-width: 1080px;
      margin: 1.5rem auto;
      padding: 0 1.5rem;
    }
    .cta-inner {
      background: linear-gradient(
        135deg,
        rgba(20, 184, 166, 0.1),
        rgba(0, 212, 255, 0.08)
      );
      border: 1px solid rgba(20, 184, 166, 0.25);
      border-radius: 12px;
      padding: 1.1rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .cta-text {
      font-size: 0.88rem;
      color: var(--text2);
    }
    .cta-text strong {
      color: var(--text);
    }
    .cta-btn {
      background: #2dd4bf;
      color: #04231f;
      font-family: var(--font-display);
      font-size: 0.83rem;
      font-weight: 700;
      padding: 0.55rem 1.2rem;
      border-radius: 8px;
      text-decoration: none;
      transition: opacity 0.15s;
    }
    .cta-btn:hover {
      opacity: 0.85;
    }

    .content-section {
      max-width: 1080px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }
    .content-section h2 {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 0.7rem;
      color: var(--text);
    }
    .content-section p {
      color: var(--text2);
      line-height: 1.75;
      font-size: 0.88rem;
      margin-bottom: 0.75rem;
    }
    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin: 1rem 0;
    }
    .info-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1rem;
    }
    .info-card-icon {
      font-size: 1.2rem;
      margin-bottom: 0.45rem;
    }
    .info-card-title {
      font-size: 0.83rem;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 0.3rem;
    }
    .info-card-desc {
      font-size: 0.78rem;
      color: var(--text2);
      line-height: 1.55;
    }

    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-top: 1rem;
    }
    .faq-item {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1rem;
    }
    .faq-q {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 0.35rem;
    }
    .faq-a {
      font-size: 0.82rem;
      color: var(--text2);
      line-height: 1.65;
    }

    .toast {
      position: fixed;
      bottom: 1.5rem;
      left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: var(--bg3);
      border: 1px solid var(--border);
      color: var(--text);
      font-size: 0.82rem;
      font-weight: 600;
      padding: 0.65rem 1.1rem;
      border-radius: 8px;
      opacity: 0;
      pointer-events: none;
      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
      z-index: 10001;
    }
    .toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
    .ppi-calc {
      margin: 0 1.5rem 1.5rem;
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.1rem 1.25rem;
    }
    .ppi-calc-header {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 0.75rem;
    }
    .ppi-calc-body {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: wrap;
    }
    .ppi-calc-body label {
      font-size: 0.78rem;
      color: var(--text2);
      width: 100%;
    }
    .ppi-calc-body input {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--text);
      padding: 0.45rem 0.7rem;
      font-size: 0.85rem;
      width: 120px;
      font-family: var(--font-mono);
    }
    .ppi-result {
      width: 100%;
      margin-top: 0.9rem;
      padding-top: 0.9rem;
      border-top: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .ppi-result-row {
      display: flex;
      justify-content: space-between;
      font-size: 0.8rem;
      color: var(--text2);
    }
    .ppi-result-row span:last-child {
      color: var(--text);
      font-weight: 700;
      font-family: var(--font-mono);
    }
    .ppi-note {
      font-size: 0.74rem;
      color: var(--muted);
      margin-top: 0.4rem;
      line-height: 1.5;
    }

    .sw-banding-red {
      background: linear-gradient(
        90deg,
        #1a0000,
        #2a0000,
        #3a0000,
        #4a0000,
        #5a0000,
        #6a0000
      );
    }
