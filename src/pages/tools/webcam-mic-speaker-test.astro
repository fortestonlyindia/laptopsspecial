      // ===================== FREQUENCY RESPONSE (SPEAKER + MIC LOOPBACK) =====================
      const btnFreqResponse = document.getElementById(
        "btnFreqResponse",
      ) as HTMLButtonElement | null;
      const freqRespCanvas = document.getElementById(
        "freqResponseCanvas",
      ) as HTMLCanvasElement | null;
      const freqRespStatus = document.getElementById("freqResponseStatus");
      let lastFreqResponseData: { freq: number; db: number }[] | null = null;

      function refreshFreqResponseButtonState() {
        if (btnFreqResponse) btnFreqResponse.disabled = !micStream;
      }

      function drawFreqResponse(data: { freq: number; db: number }[]) {
        if (!freqRespCanvas) return;
        const ctx = freqRespCanvas.getContext("2d");
        if (!ctx) return;
        freqRespCanvas.width = freqRespCanvas.clientWidth;
        freqRespCanvas.height = 120;
        const w = freqRespCanvas.width;
        const h = freqRespCanvas.height;
        ctx.clearRect(0, 0, w, h);

        if (data.length < 2) return;

        const minDb = Math.min(...data.map((d) => d.db), -60);
        const maxDb = Math.max(...data.map((d) => d.db), 0);
        const range = Math.max(maxDb - minDb, 1);

        // gridlines
        ctx.strokeStyle = "rgba(255,255,255,0.08)";
        ctx.lineWidth = 1;
        for (let i = 0; i <= 3; i++) {
          const y = (h / 3) * i;
          ctx.beginPath();
          ctx.moveTo(0, y);
          ctx.lineTo(w, y);
          ctx.stroke();
        }

        // log-scale x position for a frequency (60Hz–8000Hz)
        const logMin = Math.log10(60);
        const logMax = Math.log10(8000);
        function xFor(freq: number) {
          const t = (Math.log10(freq) - logMin) / (logMax - logMin);
          return t * w;
        }
        function yFor(db: number) {
          return h - ((db - minDb) / range) * h;
        }

        const grad = ctx.createLinearGradient(0, 0, 0, h);
        grad.addColorStop(0, "rgba(0,212,255,0.35)");
        grad.addColorStop(1, "rgba(0,212,255,0.02)");

        ctx.beginPath();
        ctx.moveTo(xFor(data[0].freq), h);
        data.forEach((d) => ctx.lineTo(xFor(d.freq), yFor(d.db)));
        ctx.lineTo(xFor(data[data.length - 1].freq), h);
        ctx.closePath();
        ctx.fillStyle = grad;
        ctx.fill();

        ctx.beginPath();
        data.forEach((d, i) => {
          const x = xFor(d.freq);
          const y = yFor(d.db);
          i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
        });
        ctx.strokeStyle = "#00d4ff";
        ctx.lineWidth = 2;
        ctx.stroke();
      }

      btnFreqResponse?.addEventListener("click", async () => {
        if (!micStream || !analyser || !dataArrayTime) {
          showToast("Start the microphone first");
          return;
        }
        if (btnFreqResponse) btnFreqResponse.disabled = true;
        if (freqRespStatus)
          freqRespStatus.textContent = "Sweeping 60Hz → 8000Hz, listening...";

        stopTone();
        const ctx = ensureSpkCtx();
        const sweepDurationSec = 8;
        const startFreq = 60;
        const endFreq = 8000;

        const osc = ctx.createOscillator();
        const pan = ctx.createStereoPanner();
        pan.pan.value = 0;
        osc.connect(pan).connect(ctx.destination);
        osc.frequency.setValueAtTime(startFreq, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(
          endFreq,
          ctx.currentTime + sweepDurationSec,
        );
        osc.start();

        const samples: { freq: number; db: number }[] = [];
        const sampleIntervalMs = 100;
        const totalSamples = (sweepDurationSec * 1000) / sampleIntervalMs;
        let sampleIndex = 0;

        const sampleTimer = window.setInterval(() => {
          if (!analyser || !dataArrayTime) return;
          analyser.getByteTimeDomainData(
            dataArrayTime as Uint8Array<ArrayBuffer>,
          );
          let sumSquares = 0;
          for (let i = 0; i < dataArrayTime.length; i++) {
            const norm = (dataArrayTime[i] - 128) / 128;
            sumSquares += norm * norm;
          }
          const rms = Math.sqrt(sumSquares / dataArrayTime.length);
          const db = 20 * Math.log10(Math.max(rms, 0.0001));

          const t = sampleIndex / totalSamples;
          const freq = startFreq * Math.pow(endFreq / startFreq, t);
          samples.push({ freq, db });
          sampleIndex++;

          if (sampleIndex >= totalSamples) {
            clearInterval(sampleTimer);
            try {
              osc.stop();
            } catch (e) {}
            osc.disconnect();

            // Normalize so the loudest point sits at 0dB — makes relative
            // dips/peaks easy to read regardless of mic sensitivity/volume.
            const peakDb = Math.max(...samples.map((s) => s.db));
            const normalized = samples.map((s) => ({
              freq: s.freq,
              db: s.db - peakDb,
            }));
            lastFreqResponseData = normalized;
            drawFreqResponse(normalized);

            const dipThreshold = -18;
            const dips = normalized.filter((s) => s.db < dipThreshold);
            if (freqRespStatus) {
              freqRespStatus.textContent =
                dips.length > 0
                  ? `Done — noticeable dip(s) around ${Math.round(dips[0].freq)}Hz. Could be speaker, mic, or room — try repositioning and re-testing.`
                  : "Done — response looks reasonably flat across the sweep.";
            }
            if (btnFreqResponse) btnFreqResponse.disabled = false;
            showToast("Frequency response sweep complete");
          }
        }, sampleIntervalMs);
      });

      // ===================== THD (DISTORTION) ESTIMATE =====================
      const btnThdTest = document.getElementById(
        "btnThdTest",
      ) as HTMLButtonElement | null;
      const thdStatus = document.getElementById("thdStatus");
      let lastThdPercent: number | null = null;
      let lastThdFreq: number | null = null;

      function refreshThdButtonState() {
        if (btnThdTest) btnThdTest.disabled = !micStream || !micSourceNode;
      }

      function magnitudeAtFreq(
        freqData: Float32Array,
        binHz: number,
        targetFreq: number,
        searchBins = 2,
      ): number {
        const centerBin = Math.round(targetFreq / binHz);
        let maxDb = -Infinity;
        for (let b = centerBin - searchBins; b <= centerBin + searchBins; b++) {
          if (b >= 0 && b < freqData.length) {
            if (freqData[b] > maxDb) maxDb = freqData[b];
          }
        }
        if (maxDb === -Infinity) return 0;
        return Math.pow(10, maxDb / 20); // dB -> linear amplitude
      }

      btnThdTest?.addEventListener("click", async () => {
        if (!micSourceNode || !audioCtx) {
          showToast("Start the microphone first");
          return;
        }
        if (btnThdTest) btnThdTest.disabled = true;
        const resultBox = document.getElementById("thdResult");
        if (resultBox) resultBox.style.display = "none";

        stopTone();
        const ctx = ensureSpkCtx();
        // User picks the test frequency based on their speaker type — a
        // single fixed tone can't fairly represent both a laptop speaker
        // and a full-range/subwoofer setup. 1000Hz (mid) is the default
        // since it's the standard reference point most speakers reproduce
        // cleanly; bass/treble presets let bigger setups get tested where
        // they're actually likely to show real distortion.
        const freqSelect = document.getElementById(
          "thdFreqSelect",
        ) as HTMLSelectElement | null;
        const testFreq = freqSelect ? Number(freqSelect.value) : 1000;

        // Dedicated high-resolution analyser so harmonics (2000/3000/4000/5000Hz)
        // land in cleanly separated bins. Widen the dynamic range so a loud
        // tone doesn't get clipped at the default -30dB ceiling, which would
        // otherwise flatten the fundamental's reading and inflate the ratio.
        const thdAnalyser = audioCtx.createAnalyser();
        thdAnalyser.fftSize = 16384;
        thdAnalyser.smoothingTimeConstant = 0.2;
        thdAnalyser.minDecibels = -100;
        thdAnalyser.maxDecibels = 0;
        micSourceNode.connect(thdAnalyser);
        const thdFreqData = new Float32Array(thdAnalyser.frequencyBinCount);
        const binHz = audioCtx.sampleRate / thdAnalyser.fftSize;

        function readHarmonicSet(): {
          fundamental: number;
          h2: number;
          h3: number;
          h4: number;
          h5: number;
        } {
          thdAnalyser.getFloatFrequencyData(thdFreqData);
          return {
            fundamental: magnitudeAtFreq(thdFreqData, binHz, testFreq),
            h2: magnitudeAtFreq(thdFreqData, binHz, testFreq * 2),
            h3: magnitudeAtFreq(thdFreqData, binHz, testFreq * 3),
            h4: magnitudeAtFreq(thdFreqData, binHz, testFreq * 4),
            h5: magnitudeAtFreq(thdFreqData, binHz, testFreq * 5),
          };
        }

        // ---- Calibrate ambient noise floor BEFORE the tone plays ----
        // Must happen before the oscillator starts — otherwise the tone
        // itself leaks into this "noise" measurement. Average several
        // snapshots so one noisy moment (a click, a footstep) doesn't
        // skew the whole calibration.
        if (thdStatus) thdStatus.textContent = "Measuring room noise floor...";
        await sleep(300);
        const noiseReadings: ReturnType<typeof readHarmonicSet>[] = [];
        for (let i = 0; i < 4; i++) {
          noiseReadings.push(readHarmonicSet());
          await sleep(100);
        }
        function avgOf(key: "fundamental" | "h2" | "h3" | "h4" | "h5") {
          return (
            noiseReadings.reduce((a, r) => a + r[key], 0) / noiseReadings.length
          );
        }
        const noiseFundamental = avgOf("fundamental");
        const noiseH2 = avgOf("h2");
        const noiseH3 = avgOf("h3");
        const noiseH4 = avgOf("h4");
        const noiseH5 = avgOf("h5");

        // ---- Now start the tone ----
        if (thdStatus)
          thdStatus.textContent = `Playing ${testFreq}Hz test tone...`;
        const osc = ctx.createOscillator();
        const pan = ctx.createStereoPanner();
        pan.pan.value = 0;
        osc.frequency.value = testFreq;
        osc.connect(pan).connect(ctx.destination);
        osc.start();

        // let the tone/room settle before sampling
        await sleep(600);

        function subtractNoise(signal: number, noise: number): number {
          // power subtraction — signal and noise are uncorrelated, so their
          // powers (amplitude²) add, not their amplitudes directly.
          const diff = signal * signal - noise * noise;
          return diff > 0 ? Math.sqrt(diff) : 0;
        }

        const samples: number[] = [];
        const sampleCount = 10;
        for (let i = 0; i < sampleCount; i++) {
          const raw = readHarmonicSet();

          const fundamental = subtractNoise(raw.fundamental, noiseFundamental);
          const h2 = subtractNoise(raw.h2, noiseH2);
          const h3 = subtractNoise(raw.h3, noiseH3);
          const h4 = subtractNoise(raw.h4, noiseH4);
          const h5 = subtractNoise(raw.h5, noiseH5);

          // Only trust this sample if the fundamental is clearly audible
          // above the noise floor — otherwise the ratio is meaningless.
          if (fundamental > noiseFundamental * 2.5 && fundamental > 0.0015) {
            const harmonicRms = Math.sqrt(
              h2 * h2 + h3 * h3 + h4 * h4 + h5 * h5,
            );
            const pct = Math.min((harmonicRms / fundamental) * 100, 80);
            samples.push(pct);
          }
          await sleep(120);
        }

        try {
          osc.stop();
        } catch (e) {}
        osc.disconnect();
        micSourceNode.disconnect(thdAnalyser);

        if (btnThdTest) btnThdTest.disabled = false;

        if (samples.length < 3) {
          if (thdStatus)
            thdStatus.textContent =
              "Couldn't get a clean reading — turn up your speaker volume, move the mic closer, and try again.";
          showToast(
            "Distortion test inconclusive — try again at a higher volume",
          );
          return;
        }

        // median is more robust than mean against one noisy sample
        const sorted = [...samples].sort((a, b) => a - b);
        const median = sorted[Math.floor(sorted.length / 2)];
        lastThdPercent = median;
        lastThdFreq = testFreq;

        let rating = "Clean";
        let ratingColor = "#22c55e";
        if (median > 10) {
          rating = "High distortion";
          ratingColor = "#ef4444";
        } else if (median > 4) {
          rating = "Noticeable";
          ratingColor = "#f59e0b";
        }

        const thdValueEl = document.getElementById("thdValue");
        const thdRatingEl = document.getElementById("thdRating");
        if (thdValueEl) thdValueEl.textContent = `${median.toFixed(1)}%`;
        if (thdRatingEl) {
          thdRatingEl.textContent = rating;
          thdRatingEl.style.color = ratingColor;
        }
        if (resultBox) resultBox.style.display = "block";
        if (thdStatus)
          thdStatus.textContent = `Done — based on ${samples.length} samples at ${testFreq}Hz.`;
        showToast("Distortion test complete");
        recordHistorySnapshot();
        if (micStream) saveMicResult(peakLevel, clipCount);
      });

      document.addEventListener(
        "astro:before-swap",
        () => {
          if (camAnalysisTimer) clearInterval(camAnalysisTimer);
          if (micRafId) cancelAnimationFrame(micRafId);
          if (camStream) camStream.getTracks().forEach((t) => t.stop());
          if (micStream) micStream.getTracks().forEach((t) => t.stop());
          stopTone();
        },
        { once: true },
      );
    });
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />
</Base>
