---
import Base from "@layouts/Base.astro";

const pageUrl = "https://laptopsspecial.com/tools/webcam-mic-speaker-test/";
const siteUrl = "https://laptopsspecial.com/";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${pageUrl}#breadcrumb`,
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    {
      "@type": "ListItem",
      position: 2,
      name: "Webcam, Mic & Speaker Test",
      item: pageUrl,
    },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq`,
  mainEntity: [
    {
      "@type": "Question",
      name: "Can a browser tell me if my webcam or mic is 'good'?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Not with a single score. This tool reads the real settings your camera and microphone negotiated with the browser — resolution, live FPS, sample rate, noise floor, clipping — and gives you a live waveform and video feed so you can judge quality with your own eyes and ears, the same way a video call would use them.",
      },
    },
    {
      "@type": "Question",
      name: "Why does my mic level meter show a percentage instead of decibels?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Browsers cannot report a calibrated, absolute decibel (SPL) reading because that depends on microphone sensitivity and OS gain — hardware details the Web Audio API does not expose. The meter shows real relative signal strength (RMS amplitude), which is accurate for spotting clipping, silence, and inconsistency, but not for absolute loudness comparisons across different devices.",
      },
    },
    {
      "@type": "Question",
      name: "Why did the Left Only speaker test play from my right speaker?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "That means your channels are swapped somewhere in the audio chain — usually a wiring issue on external speakers, or a Windows/macOS audio balance setting. Since this test plays a real hard-panned tone, what you hear is exactly what's being sent to each channel; it is a genuine channel-routing issue, not a bug in the test.",
      },
    },
    {
      "@type": "Question",
      name: "Does the output device selector work in every browser?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. The setSinkId API, which lets a webpage route audio to a specific output device, is currently supported only in Chromium-based browsers (Chrome, Edge, Opera). In Firefox and Safari, audio always plays through your operating system's default output device.",
      },
    },
    {
      "@type": "Question",
      name: "Is my camera feed or recorded audio uploaded anywhere?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. The camera preview, microphone analysis, and the short test recording all run entirely inside your browser using local Web APIs (getUserMedia, Web Audio API, MediaRecorder). Nothing is sent to any server.",
      },
    },
    {
      "@type": "Question",
      name: "What does the Electrical Hum reading mean?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "It checks for elevated energy specifically at mains frequency (50Hz or 60Hz depending on your region) and its harmonics, which is a strong signature of ground loops, unshielded USB cables, or a mic placed too close to a power adapter. Try a different USB port or move the mic away from chargers if hum is detected.",
      },
    },
    {
      "@type": "Question",
      name: "What is AGC noise pumping and why does it matter?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Many drivers and cheap mics apply Automatic Gain Control, which boosts gain during quiet moments and reduces it during loud ones. This shows up as the background noise floor rising right after you stop talking, then settling back down — a pattern that can make quiet moments sound 'breathy' to others on a call.",
      },
    },
    {
      "@type": "Question",
      name: "How accurate is the speaker distortion (THD) test?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "It's a loopback estimate, not a lab measurement — it plays a test tone and listens back through your own microphone, so the mic's own harmonic response and room acoustics are baked into the number. Use it to compare volume levels or speaker positions on your own setup rather than against a manufacturer's published spec.",
      },
    },
  ],
};
---

<Base
  title="Webcam, Mic & Speaker Test — Check Camera, Microphone & Audio Free"
  description="Free browser-based webcam test, microphone test, and speaker test. Real live FPS, light-level and focus checks, mic waveform with clipping/noise-floor detection, record & playback, and a full left/right/sweep speaker test. No download needed."
  canonical={pageUrl}
  ogImage="https://laptopsspecial.com/og/webcam-mic-speaker-test.png"
>
  <style>
    .hero {
      text-align: center;
      padding: 3rem 1.5rem 1.5rem;
    }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(0, 212, 255, 0.12);
      border: 1px solid rgba(0, 212, 255, 0.3);
      color: var(--accent);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.3rem 0.8rem;
      border-radius: 100px;
      margin-bottom: 1.25rem;
    }
    .hero h1 {
      font-size: clamp(1.75rem, 4vw, 2.75rem);
      font-weight: 700;
      color: var(--text);
      margin-bottom: 0.75rem;
    }
    .hero h1 span {
      color: var(--accent);
    }
    .hero p {
      color: var(--text2);
      font-size: 1rem;
      max-width: 560px;
      margin: 0 auto;
    }

    .section-wrap {
      max-width: 1080px;
      margin: 0 auto;
      padding: 0 1.5rem 1.5rem;
    }
    .tool-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
      margin-bottom: 1.5rem;
    }
    .tool-header {
      padding: 0.9rem 1.5rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .tool-title {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text2);
    }
    .tool-actions {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .btn-sm {
      background: none;
      border: 1px solid var(--border);
      color: var(--muted);
      font-family: var(--font-display);
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.35rem 0.85rem;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s;
    }
    .btn-sm:hover {
      border-color: var(--muted);
      color: var(--text);
    }
    .btn-sm:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }
    .btn-export {
      border-color: rgba(124, 58, 237, 0.4);
      color: #a78bfa;
    }
    .btn-csv {
      border-color: rgba(34, 197, 94, 0.3);
      color: #22c55e;
    }
    .btn-pdf {
      border-color: rgba(0, 212, 255, 0.4);
      color: var(--accent);
      font-weight: 700;
    }
    .btn-fulldiag {
      border-color: rgba(34, 197, 94, 0.4);
      color: #22c55e;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
    }
    select {
      background: var(--bg3);
      border: 1px solid var(--border);
      color: var(--text);
      font-family: var(--font-display);
      font-size: 0.78rem;
      padding: 0.35rem 0.6rem;
      border-radius: 6px;
    }

    .body-pad {
      padding: 1.25rem 1.5rem;
    }

    /* WEBCAM */
    .cam-layout {
      display: grid;
      grid-template-columns: minmax(240px, 380px) 1fr;
      gap: 1.25rem;
    }
    @media (max-width: 640px) {
      .cam-layout {
        grid-template-columns: 1fr;
      }
    }
    .video-wrap {
      position: relative;
      background: #0a1020;
      border-radius: 12px;
      overflow: hidden;
      aspect-ratio: 4/3;
    }
    video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    canvas.hidden-canvas {
      display: none;
    }
    .overlay-badge {
      position: absolute;
      top: 10px;
      left: 10px;
      background: rgba(0, 0, 0, 0.6);
      color: #fff;
      padding: 0.3rem 0.7rem;
      border-radius: 6px;
      font-size: 0.72rem;
      font-weight: 600;
    }
    .stat-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 0.65rem;
      align-content: start;
    }
    .stat-item {
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.7rem 0.9rem;
    }
    .stat-item .label {
      font-size: 0.62rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      margin-bottom: 0.3rem;
      display: block;
    }
    .stat-item .value {
      font-family: var(--font-mono);
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--accent);
    }

    /* MIC */
    .meter-wrap {
      margin: 0.75rem 0;
    }
    #mic-waveform {
      width: 100%;
      height: 90px;
      border-radius: 8px;
      background: #0a1020;
      display: block;
    }
    #mic-spectrum {
      width: 100%;
      height: 60px;
      border-radius: 8px;
      background: #0a1020;
      display: block;
      margin-top: 0.5rem;
    }
    .meter-labels {
      display: flex;
      justify-content: space-between;
      font-size: 0.7rem;
      color: var(--muted);
      margin-top: 0.3rem;
    }
    .record-block {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-top: 1rem;
      flex-wrap: wrap;
    }
    audio {
      max-width: 260px;
    }

    /* SPEAKER */
    .speaker-buttons {
      display: flex;
      gap: 0.6rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }
    .spk-btn {
      background: var(--bg3);
      border: 1px solid var(--border);
      color: var(--text2);
      font-family: var(--font-display);
      font-size: 0.8rem;
      font-weight: 600;
      padding: 0.55rem 1rem;
      border-radius: 8px;
      cursor: pointer;
    }
    .spk-btn:hover {
      border-color: var(--accent);
      color: var(--text);
    }
    .spk-btn.stop {
      border-color: rgba(239, 68, 68, 0.4);
      color: #ef4444;
    }
    .freq-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin: 1rem 0;
      flex-wrap: wrap;
    }
    .freq-row input[type="range"] {
      flex: 1;
      min-width: 160px;
    }
    .balance-row {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      flex-wrap: wrap;
      margin-top: 0.75rem;
    }

    /* CONFIDENCE BADGE */
    .confidence-badge {
      display: none;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.78rem;
      font-weight: 700;
      padding: 0.4rem 0.85rem;
      border-radius: 100px;
      margin-top: 0.75rem;
      width: fit-content;
    }
    .confidence-badge.show {
      display: flex;
    }
    .confidence-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .confidence-badge.status-good {
      background: rgba(34, 197, 94, 0.12);
      border: 1px solid rgba(34, 197, 94, 0.3);
      color: #22c55e;
    }
    .confidence-badge.status-good .confidence-dot {
      background: #22c55e;
    }
    .confidence-badge.status-check {
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.3);
      color: #f59e0b;
    }
    .confidence-badge.status-check .confidence-dot {
      background: #f59e0b;
    }
    .confidence-badge.status-investigate {
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #ef4444;
    }
    .confidence-badge.status-investigate .confidence-dot {
      background: #ef4444;
    }

    .honesty-box {
      margin-top: 1rem;
      padding: 0.75rem 1rem;
      background: var(--bg3);
      border-left: 3px solid var(--accent);
      border-radius: 6px;
      font-size: 0.82rem;
      color: var(--text2);
      line-height: 1.6;
    }
    .honesty-box code {
      background: rgba(0, 212, 255, 0.08);
      padding: 0.1rem 0.35rem;
      border-radius: 4px;
      font-family: var(--font-mono);
      font-size: 0.78rem;
    }

    #next-step-banner {
      display: none;
      max-width: 1050px;
      margin: 0 auto 1.25rem;
      padding: 0.9rem 1.1rem;
      border-radius: 10px;
      border: 1px solid rgba(124, 58, 237, 0.3);
      background: rgba(124, 58, 237, 0.06);
      font-size: 0.85rem;
      color: var(--text2);
      text-align: center;
    }

    .cta-banner {
      max-width: 1080px;
      margin: 1.5rem auto;
      padding: 0 1.5rem;
    }
    .cta-inner {
      background: linear-gradient(
        135deg,
        rgba(0, 212, 255, 0.08),
        rgba(124, 58, 237, 0.1)
      );
      border: 1px solid rgba(0, 212, 255, 0.2);
      border-radius: 12px;
      padding: 1.2rem 1.6rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .cta-text {
      font-size: 0.9rem;
      color: var(--text2);
    }
    .cta-text strong {
      color: var(--text);
    }
    .cta-btn {
      background: var(--accent);
      color: #001018;
      font-family: var(--font-display);
      font-size: 0.85rem;
      font-weight: 700;
      padding: 0.6rem 1.25rem;
      border-radius: 8px;
      text-decoration: none;
    }

    .content-section {
      max-width: 1080px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }
    .content-section h2 {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 0.7rem;
      color: var(--text);
    }
    .content-section p {
      color: var(--text2);
      line-height: 1.75;
      font-size: 0.88rem;
      margin-bottom: 0.75rem;
    }
    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-top: 1rem;
    }
    .faq-item {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1rem;
    }
    .faq-q {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 0.35rem;
    }
    .faq-a {
      font-size: 0.82rem;
      color: var(--text2);
      line-height: 1.65;
    }

    .toast {
      position: fixed;
      bottom: 1.5rem;
      left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: var(--bg3);
      border: 1px solid var(--border);
      color: var(--text);
      font-size: 0.82rem;
      font-weight: 600;
      padding: 0.65rem 1.1rem;
      border-radius: 8px;
      opacity: 0;
      pointer-events: none;
      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
      z-index: 100;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    }
    .toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  </style>

  <div class="hero">
    <div class="hero-badge">🎙️ Camera + Mic + Speakers</div>
    <h1>Webcam, Mic <span>&amp; Speaker Test</span></h1>
    <p>
      Check your camera, microphone, and speakers the same way a video call
      would use them — real live readings, no fake scores.
    </p>
    <p style="font-size:0.85rem; margin-top:0.75rem;">
      New here? Read the <a
        href="/webcam-mic-speaker-test-guide/"
        data-astro-reload
        style="color:var(--accent); font-weight:600;">step-by-step guide</a
      > first, or dive straight into the tests below.
    </p>
  </div>

  <div class="section-wrap">
    <!-- ============ WEBCAM ============ -->
    <div class="tool-card" id="webcam-card">
      <div class="tool-header">
        <span class="tool-title">📷 Webcam Test</span>
        <div class="tool-actions">
          <select id="camSelect" aria-label="Select camera"></select>
          <button class="btn-sm" id="camStart">▶ Start</button>
          <button class="btn-sm" id="camStop" disabled>■ Stop</button>
        </div>
      </div>
      <div class="body-pad cam-layout">
        <div class="video-wrap">
          <video id="camPreview" autoplay playsinline muted></video>
          <canvas id="camAnalysisCanvas" class="hidden-canvas"></canvas>
          <div class="overlay-badge" id="camOverlay">Camera off</div>
        </div>
        <div>
          <div class="stat-grid">
            <div class="stat-item">
              <span class="label">Resolution</span><span
                class="value"
                id="camRes">—</span
              >
            </div>
            <div class="stat-item">
              <span class="label">Live FPS</span><span class="value" id="camFps"
                >—</span
              >
            </div>
            <div class="stat-item">
              <span class="label">Dropped Frames</span><span
                class="value"
                id="camDrops">—</span
              >
            </div>
            <div class="stat-item">
              <span class="label">Light Level</span><span
                class="value"
                id="camLight">—</span
              >
            </div>
            <div class="stat-item">
              <span class="label">Sharpness (rel.)</span><span
                class="value"
                id="camSharp">—</span
              >
            </div>
            <div class="stat-item">
              <span class="label">Device</span><span
                class="value"
                id="camLabel"
                style="font-size:0.8rem;">—</span
              >
            </div>
            <div class="stat-item">
              <span class="label">Focus/Exposure Stability</span><span
                class="value"
                id="camHunting">—</span
              >
            </div>
          </div>
          <div class="confidence-badge" id="cam-confidence">
            <span class="confidence-dot"></span>
            <span id="cam-confidence-text">—</span>
          </div>
        </div>
      </div>
      <div class="body-pad" style="padding-top:0;">
        <div class="honesty-box">
          ℹ️ Resolution/FPS come from <code>track.getSettings()</code> plus a live
          frame counter — not a guess. Light level and sharpness are relative measurements
          (average brightness and edge-contrast of the visible frame) meant to flag
          "too dark" or "clearly out of focus," not a lab-grade camera score. Focus/Exposure
          Stability watches those same readings over ~8 seconds — if they keep swinging
          even while you sit still, your camera is likely "hunting" (continuously
          re-focusing/re-exposing) instead of settling on a stable image.
        </div>

        <div
          style="margin-top:1.25rem; padding-top:1.1rem; border-top:1px solid var(--border);"
        >
          <div
            style="font-size:0.85rem; font-weight:700; color:var(--text); margin-bottom:0.5rem;"
          >
            ⏱ Capture Latency Test
          </div>
          <p
            style="font-size:0.78rem; color:var(--text2); margin-bottom:0.75rem; line-height:1.6;"
          >
            Point your camera at the flashing box below. It measures the time
            from when the box actually flashes white on your screen to when your
            camera captures that change — a real end-to-end pipeline latency
            test, not a spec-sheet number.
          </p>
          <div
            id="latencyFlashBox"
            style="width:100%; max-width:220px; height:120px; background:#000; border-radius:8px; border:2px solid var(--border); margin-bottom:0.75rem; display:flex; align-items:center; justify-content:center; color:#555; font-size:0.75rem; font-weight:700;"
          >
            Point camera here
          </div>
          <button class="btn-sm" id="btnCaptureLatency" disabled
            >🎯 Run Capture Latency Test (5 flashes)</button
          >
          <div
            id="latencyTestStatus"
            style="font-size:0.78rem; color:var(--muted); margin-top:0.5rem;"
          >
          </div>
          <div
            id="latencyTestResult"
            style="display:none; margin-top:0.75rem; background: var(--bg3); border: 1px solid var(--border); border-radius: 8px; padding: 0.75rem 1rem;"
          >
            <div class="stat-grid">
              <div class="stat-item">
                <span class="label">Avg Capture Latency</span><span
                  class="value"
                  id="latencyAvg">—</span
                >
              </div>
              <div class="stat-item">
                <span class="label">Min / Max</span><span
                  class="value"
                  id="latencyMinMax"
                  style="font-size:0.9rem;">—</span
                >
              </div>
              <div class="stat-item">
                <span class="label">Samples</span><span
                  class="value"
                  id="latencySamples">—</span
                >
              </div>
            </div>
          </div>
          <div class="honesty-box" style="margin-top:0.75rem;">
            ⚠️ This measures the <strong>full pipeline</strong> — your monitor's response
            time, the camera sensor/USB capture delay, and browser processing — all
            combined, not the webcam sensor in isolation. Works best in a dim room
            with the camera held steady a few inches from the screen.
          </div>
        </div>
      </div>
    </div>

    <!-- ============ MICROPHONE ============ -->
    <div class="tool-card" id="mic-card">
      <div class="tool-header">
        <span class="tool-title">🎤 Microphone Test</span>
        <div class="tool-actions">
          <select id="micSelect" aria-label="Select microphone"></select>
          <button class="btn-sm" id="micStart">▶ Start</button>
          <button class="btn-sm" id="micStop" disabled>■ Stop</button>
        </div>
      </div>
      <div class="body-pad">
        <div class="meter-wrap">
          <canvas id="mic-waveform"></canvas>
          <div class="meter-labels">
            <span>Waveform (live signal)</span><span id="micLevelNow">0%</span>
          </div>
          <canvas id="mic-spectrum"></canvas>
          <div class="meter-labels">
            <span>Bass</span><span>Mid</span><span>Treble</span>
          </div>
        </div>
        <div class="stat-grid">
          <div class="stat-item">
            <span class="label">Peak Level</span><span
              class="value"
              id="micPeak">—</span
            >
          </div>
          <div class="stat-item">
            <span class="label">Noise Floor</span><span
              class="value"
              id="micNoiseFloor">—</span
            >
          </div>
          <div class="stat-item">
            <span class="label">Clipping Events</span><span
              class="value"
              id="micClip">0</span
            >
          </div>
          <div class="stat-item">
            <span class="label">Plosives/Pops</span><span
              class="value"
              id="micPlosive">0</span
            >
          </div>
          <div class="stat-item">
            <span class="label">Sample Rate</span><span
