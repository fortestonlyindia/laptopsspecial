      function saveWebcamResult(avgLum: number, avgEdge: number) {
        const huntingText = readVal("camHunting");
        const isHunting = huntingText.startsWith("⚠");
        let status: "good" | "check" | "investigate" = "good";
        if (avgLum < 40 || avgEdge < 4) status = "check";
        if (isHunting && status === "good") status = "check";
        const score = status === "good" ? 90 : status === "check" ? 68 : 42;
        const metrics: Record<string, string> = {
          "Light level": `${Math.round((avgLum / 255) * 100)}%`,
          Sharpness: avgEdge.toFixed(1),
          "Focus/exposure stability": huntingText,
        };
        if (lastLatencyResults && lastLatencyResults.length > 0) {
          const avgLatency =
            lastLatencyResults.reduce((a, b) => a + b, 0) /
            lastLatencyResults.length;
          metrics["Capture latency"] = `${avgLatency.toFixed(0)} ms`;
        }
        try {
          localStorage.setItem(
            "ls_diag_webcam",
            JSON.stringify({
              tool: "webcam",
              score,
              status,
              metrics,
              timestamp: Date.now(),
              sessionId: getDiagSessionId(),
            }),
          );
          updateNextStepBanner();
        } catch (e) {}
      }

      function saveMicResult(peak: number, clips: number) {
        if (peak === 0) return;
        let status: "good" | "check" | "investigate" = "good";
        if (clips > 10) status = "investigate";
        else if (peak < 0.05) status = "check";
        // Electrical hum, AGC pumping, or heavy plosives also downgrade
        // an otherwise "good" reading, since they're real audio-quality
        // issues even when peak level and clipping look fine.
        if (
          status === "good" &&
          (lastHumResult === "50hz" ||
            lastHumResult === "60hz" ||
            lastAgcResult === "detected" ||
            plosiveCount > 5)
        ) {
          status = "check";
        }
        const score = status === "good" ? 90 : status === "check" ? 68 : 42;
        const humLabel =
          lastHumResult === "50hz"
            ? "50Hz detected"
            : lastHumResult === "60hz"
              ? "60Hz detected"
              : lastHumResult === "none"
                ? "None"
                : "Not checked";
        const agcLabel =
          lastAgcResult === "detected"
            ? "Pumping detected"
            : lastAgcResult === "clean"
              ? "Not detected"
              : "Not checked";
        const micMetrics: Record<string, string> = {
          "Peak level": `${Math.round(peak * 100)}%`,
          "Clipping events": String(clips),
          "Electrical hum": humLabel,
          "AGC / noise pumping": agcLabel,
          "Plosives/pops": String(plosiveCount),
        };
        if (lastThdPercent !== null && lastThdFreq !== null) {
          micMetrics["Speaker distortion (THD)"] =
            `${lastThdPercent.toFixed(1)}% @ ${lastThdFreq}Hz`;
        }
        try {
          localStorage.setItem(
            "ls_diag_mic",
            JSON.stringify({
              tool: "mic",
              score,
              status,
              metrics: micMetrics,
              timestamp: Date.now(),
              sessionId: getDiagSessionId(),
            }),
          );
          updateNextStepBanner();
        } catch (e) {}
      }

