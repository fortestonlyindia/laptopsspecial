  <!-- CONTENT -->
  <div class="content-section">
    <h2>Why This Goes Beyond a Basic Camera/Mic Checker</h2>
    <p>
      Most online webcam/mic testers just show a preview and a volume bar. This
      tool reads your camera's real negotiated resolution and a live measured
      FPS (not the value your driver claims), flags low light and blur, tracks
      your mic's live waveform and frequency spectrum, detects clipping and
      measures your actual noise floor, and runs real hard-panned speaker tones
      plus a frequency sweep — so you're diagnosing with real signals, not a
      single made-up score.
    </p>
    <h2>Frequently Asked Questions</h2>
    <div class="faq-list">
      <div class="faq-item">
        <div class="faq-q">
          Can a browser tell me if my webcam or mic is "good"?
        </div>
        <div class="faq-a">
          Not with a single score. This tool reads the real settings your camera
          and microphone negotiated with the browser — resolution, live FPS,
          sample rate, noise floor, clipping — and gives you a live waveform and
          video feed so you can judge quality with your own eyes and ears, the
          same way a video call would use them.
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-q">
          Why does my mic level meter show a percentage instead of decibels?
        </div>
        <div class="faq-a">
          Browsers cannot report a calibrated, absolute decibel (SPL) reading
          because that depends on microphone sensitivity and OS gain — hardware
          details the Web Audio API does not expose. The meter shows real
          relative signal strength (RMS amplitude), accurate for spotting
          clipping, silence, and inconsistency, but not for absolute loudness
          comparisons across devices.
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-q">
          Why did the Left Only speaker test play from my right speaker?
        </div>
        <div class="faq-a">
          That means your channels are swapped somewhere in the audio chain —
          usually a wiring issue on external speakers, or an OS audio balance
          setting. This test plays a real hard-panned tone, so what you hear is
          exactly what's being sent to each channel.
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-q">
          Does the output device selector work in every browser?
        </div>
        <div class="faq-a">
          No. The setSinkId API is currently supported only in Chromium-based
          browsers (Chrome, Edge, Opera). In Firefox and Safari, audio always
          plays through your operating system's default output device.
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-q">
          Is my camera feed or recorded audio uploaded anywhere?
        </div>
        <div class="faq-a">
          No. The camera preview, microphone analysis, and the short test
          recording all run entirely inside your browser using local Web APIs.
          Nothing is sent to any server.
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-q">What does the Electrical Hum reading mean?</div>
        <div class="faq-a">
          It checks for elevated energy specifically at mains frequency (50Hz or
          60Hz depending on your region) and its harmonics — a strong signature
          of ground loops, unshielded USB cables, or a mic placed too close to a
          power adapter. Try a different USB port or move the mic away from
          chargers if hum is detected.
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-q">
          What is AGC noise pumping and why does it matter?
        </div>
        <div class="faq-a">
          Many drivers and cheap mics apply Automatic Gain Control, which boosts
          gain during quiet moments and reduces it during loud ones. This shows
          up as the background noise floor rising right after you stop talking,
          then settling back down — a pattern that can make quiet moments sound
          "breathy" to others on a call.
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-q">
          How accurate is the speaker distortion (THD) test?
        </div>
        <div class="faq-a">
          It's a loopback estimate, not a lab measurement — it plays a test tone
          and listens back through your own microphone, so the mic's own
          harmonic response and room acoustics are baked into the number. Use it
          to compare volume levels or speaker positions on your own setup rather
          than against a manufacturer's published spec.
        </div>
      </div>
    </div>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    function getDiagSessionId(): string {
      let id = sessionStorage.getItem("ls_diag_session");
      if (!id) {
        id = `${Date.now()}-${Math.random().toString(36).slice(2)}`;
        sessionStorage.setItem("ls_diag_session", id);
      }
      return id;
    }

    function startFreshDiagSession() {
      try {
        localStorage.removeItem("ls_diag_monitor");
        localStorage.removeItem("ls_diag_keyboard");
        localStorage.removeItem("ls_diag_mouse");
        localStorage.removeItem("ls_diag_screen");
        localStorage.removeItem("ls_diag_webcam");
        localStorage.removeItem("ls_diag_mic");
        sessionStorage.removeItem("ls_diag_session");
      } catch (e) {
        // storage unavailable — ignore
      }
      location.reload();
    }

    document.addEventListener("astro:page-load", () => {
      const toastEl = document.getElementById("toast");
      let toastTimer: number | null = null;
      function showToast(msg: string) {
        if (!toastEl) return;
        toastEl.textContent = msg;
        toastEl.classList.add("show");
        if (toastTimer !== null) clearTimeout(toastTimer);
        toastTimer = window.setTimeout(
          () => toastEl.classList.remove("show"),
          2200,
        );
      }

      // ===================== DEVICE LISTS =====================
      const camSelect = document.getElementById(
        "camSelect",
      ) as HTMLSelectElement;
      const micSelect = document.getElementById(
        "micSelect",
      ) as HTMLSelectElement;
      const outSelect = document.getElementById(
        "outSelect",
      ) as HTMLSelectElement;
      const outputRow = document.getElementById(
        "outputSelectRow",
      ) as HTMLElement;

      async function refreshDeviceLists() {
        try {
          const devices = await navigator.mediaDevices.enumerateDevices();
          const cams = devices.filter((d) => d.kind === "videoinput");
          const mics = devices.filter((d) => d.kind === "audioinput");
          const outs = devices.filter((d) => d.kind === "audiooutput");
          camSelect.innerHTML = cams
            .map(
              (d, i) =>
                `<option value="${d.deviceId}">${d.label || "Camera " + (i + 1)}</option>`,
            )
            .join("");
          micSelect.innerHTML = mics
            .map(
              (d, i) =>
                `<option value="${d.deviceId}">${d.label || "Microphone " + (i + 1)}</option>`,
            )
            .join("");
          if (outs.length && (HTMLMediaElement.prototype as any).setSinkId) {
            outputRow.style.display = "flex";
            outSelect.innerHTML = outs
              .map(
                (d, i) =>
                  `<option value="${d.deviceId}">${d.label || "Speaker " + (i + 1)}</option>`,
              )
              .join("");
          }
        } catch (e) {}
      }
      refreshDeviceLists();

      // ===================== WEBCAM =====================
      const camStart = document.getElementById("camStart") as HTMLButtonElement;
      const camStop = document.getElementById("camStop") as HTMLButtonElement;
      const camPreview = document.getElementById(
        "camPreview",
      ) as HTMLVideoElement;
      const camOverlay = document.getElementById("camOverlay") as HTMLElement;
      const camRes = document.getElementById("camRes") as HTMLElement;
      const camFps = document.getElementById("camFps") as HTMLElement;
      const camDrops = document.getElementById("camDrops") as HTMLElement;
      const camLight = document.getElementById("camLight") as HTMLElement;
      const camSharp = document.getElementById("camSharp") as HTMLElement;
      const camLabel = document.getElementById("camLabel") as HTMLElement;
      const camCanvas = document.getElementById(
        "camAnalysisCanvas",
      ) as HTMLCanvasElement;
      const camCtx = camCanvas.getContext("2d", { willReadFrequently: true });
      const camConfBadge = document.getElementById(
        "cam-confidence",
      ) as HTMLElement;
      const camConfText = document.getElementById(
        "cam-confidence-text",
      ) as HTMLElement;

      let camStream: MediaStream | null = null;
      let camFrameTimes: number[] = [];
      let camVfcHandle: number | null = null;
      let camAnalysisTimer: number | null = null;
      let camTotalDrops = 0;
      let latencyTestRunning = false;

      // ---- Auto-focus / exposure "hunting" detector ----
      // A camera that's continuously re-focusing or re-exposing (rather
      // than settling on a stable reading) shows its light/sharpness
      // values oscillating over time even when pointed at a static scene.
      // We track recent history of both and measure how much they swing
      // relative to their own average — high relative swing = hunting.
      let huntingLumHistory: number[] = [];
      let huntingEdgeHistory: number[] = [];
      const HUNTING_HISTORY_SIZE = 16; // ~8s at 500ms/sample

      function stdDev(arr: number[]): number {
        if (arr.length < 2) return 0;
        const mean = arr.reduce((a, b) => a + b, 0) / arr.length;
        const variance =
          arr.reduce((a, b) => a + (b - mean) ** 2, 0) / arr.length;
        return Math.sqrt(variance);
      }

      function checkFocusExposureHunting(avgLum: number, avgEdge: number) {
        huntingLumHistory.push(avgLum);
        if (huntingLumHistory.length > HUNTING_HISTORY_SIZE)
          huntingLumHistory.shift();
        huntingEdgeHistory.push(avgEdge);
        if (huntingEdgeHistory.length > HUNTING_HISTORY_SIZE)
          huntingEdgeHistory.shift();

        const huntEl = document.getElementById("camHunting");
        if (huntingLumHistory.length < 8) {
          if (huntEl) huntEl.textContent = "Checking...";
          return;
        }

        const lumMean =
          huntingLumHistory.reduce((a, b) => a + b, 0) /
          huntingLumHistory.length;
        const edgeMean =
          huntingEdgeHistory.reduce((a, b) => a + b, 0) /
          huntingEdgeHistory.length;

        // Coefficient of variation (stddev / mean) — normalizes swing
        // relative to the signal's own scale, so a bright vs dark room
        // doesn't skew the comparison.
        const lumCV = lumMean > 5 ? stdDev(huntingLumHistory) / lumMean : 0;
        const edgeCV = edgeMean > 1 ? stdDev(huntingEdgeHistory) / edgeMean : 0;

        // Empirically, a genuinely settled camera has CV well under ~0.06;
        // continuous hunting pushes this noticeably higher.
        const isHunting = lumCV > 0.09 || edgeCV > 0.14;

        if (huntEl) {
          huntEl.textContent = isHunting ? "⚠ Hunting detected" : "Stable";
        }
      }

      function onVideoFrame(_now: number, meta: any) {
        camFrameTimes.push(performance.now());
        if (camFrameTimes.length > 60) camFrameTimes.shift();
        if (
          meta &&
          typeof meta.presentedFrames === "number" &&
          typeof meta.processingDuration === "number"
        ) {
          // presentedFrames vs expected can hint at drops; browsers vary in support
        }
        if ((camPreview as any).requestVideoFrameCallback) {
          camVfcHandle = (camPreview as any).requestVideoFrameCallback(
            onVideoFrame,
          );
        }
      }

      function analyzeFrame() {
        if (!camStream || !camCtx) return;
        const w = 160,
          h = 120;
        camCanvas.width = w;
        camCanvas.height = h;
        try {
          camCtx.drawImage(camPreview, 0, 0, w, h);
          const frame = camCtx.getImageData(0, 0, w, h).data;
          let sum = 0;
          let edgeSum = 0;
          for (let y = 1; y < h - 1; y++) {
            for (let x = 1; x < w - 1; x++) {
              const i = (y * w + x) * 4;
              const lum =
                0.299 * frame[i] + 0.587 * frame[i + 1] + 0.114 * frame[i + 2];
              sum += lum;
              const iRight = (y * w + (x + 1)) * 4;
              const iDown = ((y + 1) * w + x) * 4;
              const lumR =
                0.299 * frame[iRight] +
                0.587 * frame[iRight + 1] +
                0.114 * frame[iRight + 2];
              const lumD =
                0.299 * frame[iDown] +
                0.587 * frame[iDown + 1] +
                0.114 * frame[iDown + 2];
              edgeSum += Math.abs(lum - lumR) + Math.abs(lum - lumD);
            }
          }
          const avgLum = sum / (w * h);
          const avgEdge = edgeSum / (w * h);

          let lightLabel = "Good";
          if (avgLum < 40) lightLabel = "Too Dark";
          else if (avgLum > 220) lightLabel = "Overexposed";
          camLight.textContent = `${lightLabel} (${Math.round((avgLum / 255) * 100)}%)`;

          let sharpLabel = "Sharp";
          if (avgEdge < 4) sharpLabel = "Blurry";
          else if (avgEdge < 8) sharpLabel = "Soft";
          camSharp.textContent = `${sharpLabel} (${avgEdge.toFixed(1)})`;

          checkFocusExposureHunting(avgLum, avgEdge);

          // live FPS from frame timestamps
          if (camFrameTimes.length >= 2) {
            const span =
              camFrameTimes[camFrameTimes.length - 1] - camFrameTimes[0];
            const fps =
              span > 0
                ? Math.round(((camFrameTimes.length - 1) / span) * 1000)
                : 0;
            camFps.textContent = `${fps} fps`;
            const track = camStream.getVideoTracks()[0];
            const targetFps = track?.getSettings().frameRate || 30;
            if (fps < targetFps * 0.7) camTotalDrops++;
            camDrops.textContent = String(camTotalDrops);
          }

          camConfBadge.classList.add("show");
          camConfBadge.classList.remove(
            "status-good",
            "status-check",
            "status-investigate",
          );
          if (lightLabel === "Too Dark" || sharpLabel === "Blurry") {
            camConfBadge.classList.add("status-check");
            camConfText.textContent =
              lightLabel === "Too Dark"
                ? "Check — low light, try facing a light source"
                : "Check — image looks soft/out of focus";
          } else {
            camConfBadge.classList.add("status-good");
            camConfText.textContent = "Good — clear, well-lit image";
          }

          saveWebcamResult(avgLum, avgEdge);
          updateReadinessScore();
        } catch (e) {}
      }

      camStart.addEventListener("click", async () => {
        try {
          const deviceId = camSelect.value;
          camStream = await navigator.mediaDevices.getUserMedia({
            video: deviceId ? { deviceId: { exact: deviceId } } : true,
          });
          camPreview.srcObject = camStream;
          camOverlay.textContent = "Live";
          camEverStarted = true;
          camStart.disabled = true;
          camStop.disabled = false;
          camTotalDrops = 0;
          camFrameTimes = [];

          const track = camStream.getVideoTracks()[0];
          const settings = track.getSettings();
          camRes.textContent =
            settings.width && settings.height
              ? `${settings.width} × ${settings.height}`
              : "—";
          camLabel.textContent = track.label || "—";

          if ((camPreview as any).requestVideoFrameCallback) {
            camVfcHandle = (camPreview as any).requestVideoFrameCallback(
              onVideoFrame,
            );
          }
          camAnalysisTimer = window.setInterval(analyzeFrame, 500);
          const btnCapLatInit = document.getElementById(
            "btnCaptureLatency",
          ) as HTMLButtonElement | null;
          if (btnCapLatInit) btnCapLatInit.disabled = false;
          await refreshDeviceLists();
        } catch (e) {
          camOverlay.textContent = "Camera access denied or unavailable";
          showToast("Could not access camera");
        }
      });

      camStop.addEventListener("click", () => {
        if (camStream) camStream.getTracks().forEach((t) => t.stop());
        camStream = null;
        camPreview.srcObject = null;
        camOverlay.textContent = "Camera off";
        camStart.disabled = false;
        camStop.disabled = true;
        if (camAnalysisTimer) clearInterval(camAnalysisTimer);
        if (camVfcHandle && (camPreview as any).cancelVideoFrameCallback)
          (camPreview as any).cancelVideoFrameCallback(camVfcHandle);
        [
          "camRes",
          "camFps",
          "camDrops",
          "camLight",
          "camSharp",
          "camLabel",
          "camHunting",
        ].forEach((id) => {
          const el = document.getElementById(id);
          if (el) el.textContent = "—";
        });
        huntingLumHistory = [];
        huntingEdgeHistory = [];
        camConfBadge.classList.remove("show");
        const btnCapLatStop = document.getElementById(
          "btnCaptureLatency",
        ) as HTMLButtonElement | null;
        if (btnCapLatStop) btnCapLatStop.disabled = true;
        recordHistorySnapshot();
      });

      // ===================== CAPTURE LATENCY TEST =====================
      const btnCaptureLatency = document.getElementById(
        "btnCaptureLatency",
      ) as HTMLButtonElement | null;
      const latencyFlashBox = document.getElementById(
        "latencyFlashBox",
      ) as HTMLElement | null;
      const latencyTestStatus = document.getElementById("latencyTestStatus");
      let lastLatencyResults: number[] | null = null;

      function sleep(ms: number) {
        return new Promise((resolve) => setTimeout(resolve, ms));
      }

      // Samples the live camera frame and returns average brightness of a
      // small central region, using the same downscaled canvas approach as
      // analyzeFrame() (fast — 160x120).
      function sampleCameraBrightness(): number {
        if (!camStream || !camCtx) return 0;
        const w = 160,
          h = 120;
        camCanvas.width = w;
        camCanvas.height = h;
        try {
          camCtx.drawImage(camPreview, 0, 0, w, h);
          // sample a central box only — matches where the flash box should
          // appear if the camera is roughly pointed at the screen
          const region = camCtx.getImageData(
            w * 0.25,
            h * 0.25,
            w * 0.5,
            h * 0.5,
          ).data;
          let sum = 0;
          const pxCount = region.length / 4;
          for (let i = 0; i < region.length; i += 4) {
            sum +=
              0.299 * region[i] + 0.587 * region[i + 1] + 0.114 * region[i + 2];
          }
          return sum / pxCount;
        } catch (e) {
          return 0;
        }
      }

      async function runSingleFlashMeasurement(): Promise<number | null> {
        if (!latencyFlashBox) return null;

        // Ensure box is black and camera sees "dark" before flashing
        latencyFlashBox.style.background = "#000";
        await sleep(400);
        const baseline = sampleCameraBrightness();

        // Flash on the very next animation frame — this is our t0
        const flashStart: number = await new Promise((resolve) => {
          requestAnimationFrame((ts) => {
            latencyFlashBox!.style.background = "#fff";
            resolve(performance.now());
          });
        });

        const threshold = baseline + 35; // require a clear brightness jump
        const timeoutAt = flashStart + 1200;

        return new Promise((resolve) => {
          function poll() {
            const now = performance.now();
            const brightness = sampleCameraBrightness();
            if (brightness > threshold) {
              resolve(now - flashStart);
              return;
            }
            if (now > timeoutAt) {
              resolve(null); // no detection — camera likely not pointed at box
              return;
            }
            requestAnimationFrame(poll);
          }
          requestAnimationFrame(poll);
        });
      }

      btnCaptureLatency?.addEventListener("click", async () => {
        if (!camStream || latencyTestRunning) return;
        latencyTestRunning = true;
        btnCaptureLatency.disabled = true;
        const resultBox = document.getElementById("latencyTestResult");
        if (resultBox) resultBox.style.display = "none";

        const results: number[] = [];
        const totalFlashes = 5;

        for (let i = 0; i < totalFlashes; i++) {
          if (latencyTestStatus)
            latencyTestStatus.textContent = `Flash ${i + 1}/${totalFlashes}...`;
          const result = await runSingleFlashMeasurement();
          if (result !== null) results.push(result);

          if (latencyFlashBox) latencyFlashBox.style.background = "#000";
          // randomized gap so the camera's own frame timing can't
          // accidentally sync with our flash cadence
          await sleep(400 + Math.random() * 400);
        }

        latencyTestRunning = false;
        btnCaptureLatency.disabled = false;
        if (latencyFlashBox) {
          latencyFlashBox.style.background = "#000";
        }

        if (results.length === 0) {
          if (latencyTestStatus)
            latencyTestStatus.textContent =
              "No flashes detected — make sure your camera is pointed directly at the box above, a few inches away, in a dim room.";
          showToast("Couldn't detect the flash — check camera positioning");
          return;
        }

        lastLatencyResults = results;
        const avg = results.reduce((a, b) => a + b, 0) / results.length;
        const min = Math.min(...results);
        const max = Math.max(...results);

        const avgEl = document.getElementById("latencyAvg");
        const minMaxEl = document.getElementById("latencyMinMax");
        const samplesEl = document.getElementById("latencySamples");
        if (avgEl) avgEl.textContent = `${avg.toFixed(0)} ms`;
        if (minMaxEl)
          minMaxEl.textContent = `${min.toFixed(0)} / ${max.toFixed(0)} ms`;
        if (samplesEl)
          samplesEl.textContent = `${results.length} / ${totalFlashes}`;
        if (resultBox) resultBox.style.display = "block";

        if (latencyTestStatus) {
          latencyTestStatus.textContent =
            results.length < totalFlashes
              ? `Done — ${totalFlashes - results.length} flash(es) missed. Try holding the camera steadier for a cleaner reading.`
              : "Done — all flashes detected cleanly.";
        }
        showToast("Capture latency test complete");
      });

      // ===================== MICROPHONE =====================
      const micStart = document.getElementById("micStart") as HTMLButtonElement;
      const micStop = document.getElementById("micStop") as HTMLButtonElement;
      const micWave = document.getElementById(
        "mic-waveform",
      ) as HTMLCanvasElement;
      const micSpectrumCvs = document.getElementById(
        "mic-spectrum",
      ) as HTMLCanvasElement;
      const waveCtx = micWave.getContext("2d");
      const specCtx = micSpectrumCvs.getContext("2d");
      const micPeakEl = document.getElementById("micPeak") as HTMLElement;
      const micLevelNow = document.getElementById("micLevelNow") as HTMLElement;
      const micRateEl = document.getElementById("micRate") as HTMLElement;
      const micEchoEl = document.getElementById("micEcho") as HTMLElement;
      const micNoiseSettingEl = document.getElementById(
        "micNoiseSetting",
      ) as HTMLElement;
      const micClipEl = document.getElementById("micClip") as HTMLElement;
      const micNoiseFloorEl = document.getElementById(
        "micNoiseFloor",
      ) as HTMLElement;
      const micRecordBtn = document.getElementById(
        "micRecord",
      ) as HTMLButtonElement;
      const micNoiseCheckBtn = document.getElementById(
        "micNoiseCheck",
      ) as HTMLButtonElement;
      const micRecordStatus = document.getElementById(
        "micRecordStatus",
      ) as HTMLElement;
      const micPlayback = document.getElementById(
        "micPlayback",
      ) as HTMLAudioElement;
      const micConfBadge = document.getElementById(
        "mic-confidence",
      ) as HTMLElement;
      const micConfText = document.getElementById(
        "mic-confidence-text",
      ) as HTMLElement;
      const btnLatency = document.getElementById(
        "btnLatency",
      ) as HTMLButtonElement;

      let micStream: MediaStream | null = null;
      let audioCtx: AudioContext | null = null;
      let analyser: AnalyserNode | null = null;
      let dataArrayTime: Uint8Array | null = null;
      let dataArrayFreq: Uint8Array | null = null;
      let micRafId: number | null = null;
      let peakLevel = 0;
      let clipCount = 0;
      let mediaRecorder: MediaRecorder | null = null;
      let micSourceNode: MediaStreamAudioSourceNode | null = null;

      // ---- Electrical hum detector (50Hz/60Hz mains interference) ----
      let humAnalyser: AnalyserNode | null = null;
      let humDataArray: Uint8Array | null = null;
      let humFrameCounter = 0;
      let lastHumResult: "none" | "50hz" | "60hz" | "checking" = "checking";
      let humVotes: ("none" | "50hz" | "60hz")[] = [];
      const HUM_VOTE_WINDOW = 10; // ~5 seconds of history at 0.5s/check

      // ---- AGC / noise-pumping detector ----
      // Classic AGC signature: right after a loud passage, the background
      // noise floor temporarily rises (the AGC boosts gain to compensate
      // for the sudden silence), then decays back down over 1-2 seconds.
      // We watch for that rise-then-settle pattern relative to a long-term
      // "true" floor.
      let agcRmsWindow: number[] = [];
      const AGC_LONGTERM_WINDOW = 40; // ~20s of history at 0.5s/check
      let agcPumpEvents: number[] = [];
      let lastAgcResult: "checking" | "clean" | "detected" = "checking";

      // ---- Plosive / pop detector ----
      // P/B/T sounds create a sharp, short burst of low-frequency (bass)
      // energy with a fast attack — very different from normal speech
      // which builds more gradually across a wider frequency range. We
      // track a short rolling average of bass-band energy and flag a
      // spike whenever the current reading jumps well above it.
      let plosiveBassHistory: number[] = [];
      const PLOSIVE_HISTORY_SIZE = 8; // short window — plosives are fast, ~50-150ms
      let plosiveCount = 0;
      let plosiveCooldownUntil = 0;

      function checkPlosive(freqData: Uint8Array, binHz: number) {
        const now = performance.now();
        const loBin = Math.max(1, Math.round(60 / binHz));
        const hiBin = Math.min(freqData.length - 1, Math.round(200 / binHz));
        let bassSum = 0;
        let bassCount = 0;
        for (let b = loBin; b <= hiBin; b++) {
          bassSum += freqData[b];
          bassCount++;
        }
        const bassEnergy = bassCount > 0 ? bassSum / bassCount : 0;

        plosiveBassHistory.push(bassEnergy);
        if (plosiveBassHistory.length > PLOSIVE_HISTORY_SIZE)
          plosiveBassHistory.shift();

        if (plosiveBassHistory.length < 4) return;

        // Compare current reading against the average of everything
        // BEFORE it, so a sustained loud bass note doesn't keep
        // re-triggering once it's already part of its own baseline.
        const priorSamples = plosiveBassHistory.slice(0, -1);
        const priorAvg =
          priorSamples.reduce((a, b) => a + b, 0) / priorSamples.length;

        const isSpike =
          bassEnergy > priorAvg * 1.8 &&
          bassEnergy - priorAvg > 25 &&
          bassEnergy > 60;

        if (isSpike && now > plosiveCooldownUntil) {
          plosiveCount++;
          plosiveCooldownUntil = now + 250; // debounce — one pop shouldn't count multiple times
          const plosiveEl = document.getElementById("micPlosive");
          if (plosiveEl) plosiveEl.textContent = String(plosiveCount);
        }
      }

      // ---- Video Call Readiness Score ----
      // Combines webcam + mic + speaker signals into one overall verdict.
      // Webcam and mic are auto-scored from live readings; speaker can't be
      // auto-graded (no way to verify sound was actually heard), so it's
      // scored as "tested / not tested" based on whether the user has run
      // any speaker button at least once.
      let speakerTested = false;
      let camEverStarted = false;
      let micEverStarted = false;

      function updateReadinessScore() {
        const scoreEl = document.getElementById("readinessScore");
        const labelEl = document.getElementById("readinessLabel");
        const listEl = document.getElementById("readinessChecklist");
        if (!scoreEl || !labelEl || !listEl) return;

        if (!camEverStarted && !micEverStarted && !speakerTested) {
          scoreEl.textContent = "—";
          scoreEl.style.color = "var(--muted)";
          labelEl.textContent = "Run the tests above to see your score";
          listEl.innerHTML = "";
          return;
        }

        const checks: { label: string; ok: boolean | null; weight: number }[] =
          [];

        // ---- Webcam checks (40 pts) ----
        if (camEverStarted) {
          const lightText = readVal("camLight");
          const sharpText = readVal("camSharp");
          const fpsText = readVal("camFps");
          const huntingText = readVal("camHunting");
          const lightOk =
            lightText !== "—" &&
            !lightText.includes("Too Dark") &&
            !lightText.includes("Overexposed");
          const sharpOk = sharpText !== "—" && !sharpText.includes("Blurry");
          const fpsVal = parseInt(fpsText, 10);
          const fpsOk = !isNaN(fpsVal) && fpsVal >= 15;
          const huntingOk = !huntingText.startsWith("⚠");
          checks.push({ label: "Camera lighting", ok: lightOk, weight: 12 });
          checks.push({
            label: "Camera focus/sharpness",
            ok: sharpOk,
            weight: 12,
          });
          checks.push({ label: "Camera frame rate", ok: fpsOk, weight: 8 });
          checks.push({
            label: "Camera focus/exposure stable",
            ok: huntingOk,
            weight: 8,
          });
        } else {
          checks.push({ label: "Camera — not tested", ok: null, weight: 40 });
        }

        // ---- Mic checks (40 pts) ----
        if (micEverStarted) {
          const peakText = readVal("micPeak");
          const peakVal = parseInt(peakText, 10);
          const peakOk = !isNaN(peakVal) && peakVal >= 5;
          const clipVal = parseInt(readVal("micClip"), 10) || 0;
          const clipOk = clipVal <= 10;
          const humText = readVal("micHum");
          const humOk = !humText.startsWith("⚠");
          const agcText = readVal("micAgc");
          const agcOk = !agcText.startsWith("⚠");
          checks.push({ label: "Mic signal level", ok: peakOk, weight: 12 });
          checks.push({
            label: "Mic clipping/distortion",
            ok: clipOk,
            weight: 12,
          });
          checks.push({ label: "No electrical hum", ok: humOk, weight: 8 });
          checks.push({ label: "No AGC noise pumping", ok: agcOk, weight: 8 });
        } else {
          checks.push({
            label: "Microphone — not tested",
            ok: null,
            weight: 40,
          });
        }

        // ---- Speaker check (20 pts) ----
        checks.push({
          label: speakerTested
            ? "Speaker — tested (confirm audibly by ear)"
            : "Speaker — not tested yet",
          ok: speakerTested ? true : null,
          weight: 20,
        });

        let earned = 0;
        let possible = 0;
        checks.forEach((c) => {
          possible += c.weight;
          if (c.ok === true) earned += c.weight;
          else if (c.ok === null) earned += c.weight * 0.5; // neutral credit for untested
        });
        const score = Math.round((earned / possible) * 100);

        scoreEl.textContent = String(score);
        let color = "#22c55e";
        let label = "🟢 Ready for your call";
        if (score < 60) {
          color = "#ef4444";
          label = "🔴 Fix issues before your call";
        } else if (score < 85) {
          color = "#f59e0b";
          label = "🟡 Mostly ready — a few things to check";
        }
        scoreEl.style.color = color;
        labelEl.textContent = label;

        listEl.innerHTML = checks
          .map((c) => {
            const icon = c.ok === true ? "✅" : c.ok === false ? "❌" : "⚪";
            return `<div>${icon} ${c.label}</div>`;
          })
          .join("");
      }

      function checkAgcPumping(currentRms: number) {
        agcRmsWindow.push(currentRms);
        if (agcRmsWindow.length > AGC_LONGTERM_WINDOW) agcRmsWindow.shift();

        const agcEl = document.getElementById("micAgc");
        if (agcRmsWindow.length < 8) {
          if (agcEl) agcEl.textContent = "Checking...";
          return;
        }

        const longTermFloor = Math.min(...agcRmsWindow);
        const recentSlice = agcRmsWindow.slice(-6); // last ~3 seconds
        const recentPeak = Math.max(...recentSlice);
        const recentFloor = Math.min(...recentSlice);

        // Only evaluate when there was a genuine loud-then-quiet transition
        // in the recent window — otherwise a steady-loud or steady-quiet
        // signal has nothing to "pump" against.
        const hadLoudMoment =
          recentPeak > 0.22 && recentPeak > recentFloor * 2.5;
        const floorRatio =
          longTermFloor > 0.001 ? recentFloor / longTermFloor : 1;

        if (hadLoudMoment && floorRatio > 1.8) {
          const now = performance.now();
          agcPumpEvents.push(now);
          agcPumpEvents = agcPumpEvents.filter((t) => now - t < 30000);
        }

        if (agcPumpEvents.length >= 3) {
          lastAgcResult = "detected";
          if (agcEl) agcEl.textContent = "⚠ Pumping detected";
        } else {
          lastAgcResult = "clean";
          if (agcEl) agcEl.textContent = "Not detected";
        }
      }

      function bandEnergy(
        freqData: Uint8Array,
        binHz: number,
        targetFreq: number,
        widthBins = 1,
      ): number {
        const centerBin = Math.round(targetFreq / binHz);
        let sum = 0;
        let count = 0;
        for (let b = centerBin - widthBins; b <= centerBin + widthBins; b++) {
          if (b >= 0 && b < freqData.length) {
            sum += freqData[b];
            count++;
          }
        }
        return count > 0 ? sum / count : 0;
      }

      function checkElectricalHum() {
        if (!humAnalyser || !humDataArray || !audioCtx) return;
        humAnalyser.getByteFrequencyData(
          humDataArray as Uint8Array<ArrayBuffer>,
        );
        const binHz = audioCtx.sampleRate / humAnalyser.fftSize;

        // Overall baseline: average energy across the low-mid band (20Hz-300Hz),
        // EXCLUDING bins near the hum candidate frequencies themselves —
        // otherwise a genuine hum inflates the very baseline used to detect it,
        // and the threshold rises right along with the signal we're looking for.
        const loBin = Math.max(1, Math.round(20 / binHz));
        const hiBin = Math.min(
          humDataArray.length - 1,
          Math.round(300 / binHz),
        );
        const excludeBins = new Set<number>();
        [50, 60, 100, 120].forEach((f) => {
          const c = Math.round(f / binHz);
          for (let b = c - 2; b <= c + 2; b++) excludeBins.add(b);
        });
        let baselineSum = 0;
        let baselineCount = 0;
        for (let b = loBin; b <= hiBin; b++) {
          if (excludeBins.has(b)) continue;
          baselineSum += humDataArray[b];
          baselineCount++;
        }
        const baseline = baselineCount > 0 ? baselineSum / baselineCount : 0;

        const e50 = bandEnergy(humDataArray, binHz, 50);
        const e100 = bandEnergy(humDataArray, binHz, 100);
        const e60 = bandEnergy(humDataArray, binHz, 60);
        const e120 = bandEnergy(humDataArray, binHz, 120);

        const score50 = e50 + e100 * 0.6;
        const score60 = e60 + e120 * 0.6;

        const threshold = Math.max(baseline * 1.5, 15);

        let currentVote: "none" | "50hz" | "60hz";
        if (score50 < threshold && score60 < threshold) {
          currentVote = "none";
        } else if (score50 >= score60) {
          currentVote = "50hz";
        } else {
          currentVote = "60hz";
        }

        // Smooth out single noisy readings — only change the displayed
        // result once a clear majority of the recent checks agree.
        humVotes.push(currentVote);
        if (humVotes.length > HUM_VOTE_WINDOW) humVotes.shift();

        const counts = { none: 0, "50hz": 0, "60hz": 0 };
        humVotes.forEach((v) => counts[v]++);

        let winner: "none" | "50hz" | "60hz" = "none";
        let winnerCount = 0;
        (Object.keys(counts) as Array<keyof typeof counts>).forEach((k) => {
          if (counts[k] > winnerCount) {
            winnerCount = counts[k];
            winner = k;
          }
        });

        // Require the winning vote to hold at least 60% of the window
        // before switching the displayed state — prevents flicker.
        const micHumEl = document.getElementById("micHum");
        if (humVotes.length < 6) {
          if (micHumEl) micHumEl.textContent = "Checking...";
          return;
        }
        if (winnerCount / humVotes.length < 0.75) {
          // No clear consensus yet — keep showing the last stable result
          if (lastHumResult === "checking" && micHumEl) {
            micHumEl.textContent = "Checking...";
          }
          return;
        }

        lastHumResult = winner;
        if (micHumEl) {
          micHumEl.textContent =
            winner === "none"
              ? "None detected"
              : winner === "50hz"
                ? "⚠ 50Hz mains hum"
                : "⚠ 60Hz mains hum";
        }
      }

      micStart.addEventListener("click", async () => {
        try {
          const deviceId = micSelect.value;
          micStream = await navigator.mediaDevices.getUserMedia({
            audio: deviceId ? { deviceId: { exact: deviceId } } : true,
          });
          micEverStarted = true;
          const track = micStream.getAudioTracks()[0];
          const settings = track.getSettings();
          micRateEl.textContent = settings.sampleRate
            ? `${settings.sampleRate} Hz`
            : "—";
          micEchoEl.textContent =
            settings.echoCancellation === undefined
              ? "—"
              : settings.echoCancellation
                ? "On"
                : "Off";
          micNoiseSettingEl.textContent =
            settings.noiseSuppression === undefined
              ? "—"
              : settings.noiseSuppression
                ? "On"
                : "Off";

          audioCtx = new (
            window.AudioContext || (window as any).webkitAudioContext
          )();
          const source = audioCtx.createMediaStreamSource(micStream);
          micSourceNode = source;
          analyser = audioCtx.createAnalyser();
          analyser.fftSize = 2048;
          dataArrayTime = new Uint8Array(analyser.frequencyBinCount);
          dataArrayFreq = new Uint8Array(analyser.frequencyBinCount);
          source.connect(analyser);

          // Separate, higher-resolution analyser just for hum detection —
          // a bigger fftSize gives finer Hz-per-bin resolution without
          // affecting the waveform/spectrum visualizers above.
          humAnalyser = audioCtx.createAnalyser();
          humAnalyser.fftSize = 8192;
          humAnalyser.smoothingTimeConstant = 0.8;
          humDataArray = new Uint8Array(humAnalyser.frequencyBinCount);
          source.connect(humAnalyser);
          lastHumResult = "checking";
          const micHumElInit = document.getElementById("micHum");
          if (micHumElInit) micHumElInit.textContent = "Checking...";

          peakLevel = 0;
          clipCount = 0;
          plosiveCount = 0;
          plosiveBassHistory = [];
          plosiveCooldownUntil = 0;
          const plosiveElInit = document.getElementById("micPlosive");
          if (plosiveElInit) plosiveElInit.textContent = "0";
          drawMic();

          micStart.disabled = true;
          micStop.disabled = false;
          micRecordBtn.disabled = false;
          micNoiseCheckBtn.disabled = false;
          btnLatency.disabled = false;
          refreshFreqResponseButtonState();
          refreshThdButtonState();
          await refreshDeviceLists();
        } catch (e) {
          micRecordStatus.textContent = "Mic access denied or unavailable";
          showToast("Could not access microphone");
        }
      });

      function drawMic() {
        micRafId = requestAnimationFrame(drawMic);
        if (
          !analyser ||
          !dataArrayTime ||
          !dataArrayFreq ||
          !waveCtx ||
          !specCtx
        )
          return;

        micWave.width = micWave.clientWidth;
        micWave.height = 90;
        micSpectrumCvs.width = micSpectrumCvs.clientWidth;
        micSpectrumCvs.height = 60;

        analyser.getByteTimeDomainData(
          dataArrayTime as Uint8Array<ArrayBuffer>,
        );
        let sumSquares = 0;
        let sampleClipped = false;
        for (let i = 0; i < dataArrayTime.length; i++) {
          const norm = (dataArrayTime[i] - 128) / 128;
          sumSquares += norm * norm;
          if (Math.abs(norm) > 0.98) sampleClipped = true;
        }
        const rms = Math.sqrt(sumSquares / dataArrayTime.length);
        peakLevel = Math.max(peakLevel, rms);
        if (sampleClipped) {
          clipCount++;
          micClipEl.textContent = String(clipCount);
        }
        micPeakEl.textContent = `${Math.round(peakLevel * 100)}%`;
        micLevelNow.textContent = `${Math.round(rms * 100)}%`;

        waveCtx.fillStyle = "#0a1020";
        waveCtx.fillRect(0, 0, micWave.width, micWave.height);
        waveCtx.lineWidth = 2;
        waveCtx.strokeStyle = sampleClipped ? "#ef4444" : "#00d4ff";
        waveCtx.beginPath();
        const sliceW = micWave.width / dataArrayTime.length;
        let x = 0;
        for (let i = 0; i < dataArrayTime.length; i++) {
          const v = dataArrayTime[i] / 128.0;
          const y = (v * micWave.height) / 2;
          i === 0 ? waveCtx.moveTo(x, y) : waveCtx.lineTo(x, y);
          x += sliceW;
        }
        waveCtx.stroke();

        analyser.getByteFrequencyData(dataArrayFreq as Uint8Array<ArrayBuffer>);

        if (audioCtx) {
          const specBinHz = audioCtx.sampleRate / analyser.fftSize;
          checkPlosive(dataArrayFreq, specBinHz);
        }

        specCtx.fillStyle = "#0a1020";
        specCtx.fillRect(0, 0, micSpectrumCvs.width, micSpectrumCvs.height);
        const barCount = 48;
        const barW = micSpectrumCvs.width / barCount;
        const step = Math.floor(dataArrayFreq.length / barCount);
        for (let i = 0; i < barCount; i++) {
          const v = dataArrayFreq[i * step] / 255;
          const barH = v * micSpectrumCvs.height;
          specCtx.fillStyle = `hsl(${190 - v * 100}, 90%, 55%)`;
          specCtx.fillRect(
            i * barW,
            micSpectrumCvs.height - barH,
            barW - 1,
            barH,
          );
        }

        // Check for electrical hum roughly twice per second (every ~30 frames)
        humFrameCounter++;
        if (humFrameCounter >= 30) {
          humFrameCounter = 0;
          checkElectricalHum();
          checkAgcPumping(rms);
          updateReadinessScore();
        }

        // confidence badge (throttled visually by natural rAF cadence)
        micConfBadge.classList.add("show");
        micConfBadge.classList.remove(
          "status-good",
          "status-check",
          "status-investigate",
        );
        if (clipCount > 10) {
          micConfBadge.classList.add("status-investigate");
          micConfText.textContent =
            "Investigate — frequent clipping, lower your mic input volume";
        } else if (peakLevel < 0.05) {
          micConfBadge.classList.add("status-check");
          micConfText.textContent =
            "Check — very low signal, speak closer or raise input volume";
        } else {
          micConfBadge.classList.add("status-good");
          micConfText.textContent = "Good — clean, usable signal";
        }
      }

      micStop.addEventListener("click", () => {
        if (micRafId) cancelAnimationFrame(micRafId);
        if (audioCtx) audioCtx.close();
        if (micStream) micStream.getTracks().forEach((t) => t.stop());
        if (waveCtx) waveCtx.clearRect(0, 0, micWave.width, micWave.height);
        if (specCtx)
          specCtx.clearRect(0, 0, micSpectrumCvs.width, micSpectrumCvs.height);
        micStart.disabled = false;
        micStop.disabled = true;
        micRecordBtn.disabled = true;
        micNoiseCheckBtn.disabled = true;
        btnLatency.disabled = true;
        refreshFreqResponseButtonState();
        refreshThdButtonState();
        [
          "micPeak",
          "micRate",
          "micEcho",
          "micNoiseSetting",
          "micNoiseFloor",
          "micHum",
          "micAgc",
        ].forEach((id) => {
          const el = document.getElementById(id);
          if (el) el.textContent = "—";
        });
        micClipEl.textContent = "0";
        const plosiveElReset = document.getElementById("micPlosive");
        if (plosiveElReset) plosiveElReset.textContent = "0";
        plosiveBassHistory = [];
        micConfBadge.classList.remove("show");
        humAnalyser = null;
        humDataArray = null;
        humFrameCounter = 0;
        humVotes = [];
        lastHumResult = "checking";
        agcRmsWindow = [];
        agcPumpEvents = [];
        lastAgcResult = "checking";
        micSourceNode = null;
        const btnThdStop = document.getElementById(
          "btnThdTest",
        ) as HTMLButtonElement | null;
        if (btnThdStop) btnThdStop.disabled = true;
        saveMicResult(peakLevel, clipCount);
        updateReadinessScore();
        recordHistorySnapshot();
      });

      micNoiseCheckBtn.addEventListener("click", () => {
        if (!analyser || !dataArrayTime) return;
        micNoiseCheckBtn.disabled = true;
        micRecordStatus.textContent =
          "Measuring noise floor — stay silent for 2s...";
        let maxDuringSilence = 0;
        const start = performance.now();
        function sample() {
          if (!analyser || !dataArrayTime) return;
          analyser.getByteTimeDomainData(
            dataArrayTime as Uint8Array<ArrayBuffer>,
          );
          let sumSquares = 0;
          for (let i = 0; i < dataArrayTime.length; i++) {
            const norm = (dataArrayTime[i] - 128) / 128;
            sumSquares += norm * norm;
          }
          const rms = Math.sqrt(sumSquares / dataArrayTime.length);
          maxDuringSilence = Math.max(maxDuringSilence, rms);
          if (performance.now() - start < 2000) {
            requestAnimationFrame(sample);
          } else {
            micNoiseFloorEl.textContent = `${Math.round(maxDuringSilence * 100)}%`;
            micRecordStatus.textContent =
              maxDuringSilence > 0.08
                ? "Noticeable background noise detected"
                : "Quiet background — good";
            micNoiseCheckBtn.disabled = false;
          }
        }
        requestAnimationFrame(sample);
      });

      micRecordBtn.addEventListener("click", () => {
        if (!micStream) return;
        const chunks: BlobPart[] = [];
        mediaRecorder = new MediaRecorder(micStream);
        mediaRecorder.ondataavailable = (e) => chunks.push(e.data);
        mediaRecorder.onstop = () => {
          const blob = new Blob(chunks, { type: "audio/webm" });
          micPlayback.src = URL.createObjectURL(blob);
          micPlayback.style.display = "block";
          micRecordStatus.textContent =
            "Recorded — press play to hear yourself";
        };
        mediaRecorder.start();
        micRecordStatus.textContent = "Recording... speak now (3s)";
        micRecordBtn.disabled = true;
        setTimeout(() => {
          mediaRecorder?.stop();
          micRecordBtn.disabled = false;
        }, 3000);
      });

      // ===================== SPEAKERS =====================
      const freqSlider = document.getElementById(
        "freqSlider",
      ) as HTMLInputElement;
      const freqVal = document.getElementById("freqVal") as HTMLElement;
      const latencyResult = document.getElementById(
        "latencyResult",
      ) as HTMLElement;
      let spkCtx: AudioContext | null = null;
      let oscillator: OscillatorNode | null = null;
      let panner: StereoPannerNode | null = null;
      let sweepTimer: number | null = null;
      let balanceTimer: number | null = null;

      freqSlider.addEventListener("input", () => {
        freqVal.textContent = freqSlider.value;
        if (oscillator && spkCtx)
          oscillator.frequency.setValueAtTime(
            Number(freqSlider.value),
            spkCtx.currentTime,
          );
      });

      function ensureSpkCtx() {
        if (!spkCtx)
          spkCtx = new (
            window.AudioContext || (window as any).webkitAudioContext
          )();
        if (spkCtx.state === "suspended") spkCtx.resume();
        return spkCtx;
      }

      function stopTone() {
        if (sweepTimer) {
          clearInterval(sweepTimer);
          sweepTimer = null;
        }
        if (balanceTimer) {
          clearInterval(balanceTimer);
          balanceTimer = null;
        }
        if (oscillator) {
          try {
            oscillator.stop();
          } catch (e) {}
          oscillator.disconnect();
          oscillator = null;
        }
      }

      function playTone(pan: number, freq?: number) {
        stopTone();
        const ctx = ensureSpkCtx();
        oscillator = ctx.createOscillator();
        panner = ctx.createStereoPanner();
        oscillator.frequency.value = freq ?? Number(freqSlider.value);
        panner.pan.value = pan;
        oscillator.connect(panner).connect(ctx.destination);
        oscillator.start();
      }

      function markSpeakerTested() {
        speakerTested = true;
        updateReadinessScore();
      }

      document.getElementById("btnLeft")?.addEventListener("click", () => {
        playTone(-1);
        markSpeakerTested();
      });
      document.getElementById("btnBoth")?.addEventListener("click", () => {
        playTone(0);
        markSpeakerTested();
      });
      document.getElementById("btnRight")?.addEventListener("click", () => {
        playTone(1);
        markSpeakerTested();
      });
      document
        .getElementById("btnStopTone")
        ?.addEventListener("click", stopTone);

      document.getElementById("btnSweep")?.addEventListener("click", () => {
        markSpeakerTested();
        stopTone();
        const ctx = ensureSpkCtx();
        oscillator = ctx.createOscillator();
        panner = ctx.createStereoPanner();
        panner.pan.value = 0;
        oscillator.connect(panner).connect(ctx.destination);
        oscillator.frequency.setValueAtTime(60, ctx.currentTime);
        oscillator.frequency.exponentialRampToValueAtTime(
          8000,
          ctx.currentTime + 6,
        );
        oscillator.start();
        showToast("Sweeping 60Hz → 8000Hz over 6 seconds");
        sweepTimer = window.setTimeout(
          () => stopTone(),
          6200,
        ) as unknown as number;
      });

      document.getElementById("btnBalance")?.addEventListener("click", () => {
        markSpeakerTested();
        stopTone();
        showToast("Alternating Left / Right every 800ms");
        let goingLeft = true;
        playTone(-1);
        balanceTimer = window.setInterval(() => {
          goingLeft = !goingLeft;
          playTone(goingLeft ? -1 : 1);
        }, 800);
        window.setTimeout(() => stopTone(), 4800);
      });

      btnLatency.addEventListener("click", async () => {
        if (!analyser || !dataArrayTime || (!spkCtx && !audioCtx)) {
          showToast("Start the microphone first");
          return;
        }
        latencyResult.textContent = "Listening...";
        const ctx = ensureSpkCtx();
        const clickOsc = ctx.createOscillator();
        const gain = ctx.createGain();
        clickOsc.frequency.value = 2000;
        gain.gain.setValueAtTime(0.4, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.05);
        clickOsc.connect(gain).connect(ctx.destination);
        const playStart = performance.now();
        clickOsc.start();
        clickOsc.stop(ctx.currentTime + 0.05);

        let detected = false;
        const detectStart = performance.now();
        function poll() {
          if (!analyser || !dataArrayTime || detected) return;
          analyser.getByteTimeDomainData(
            dataArrayTime as Uint8Array<ArrayBuffer>,
          );
          let sumSquares = 0;
          for (let i = 0; i < dataArrayTime.length; i++) {
            const norm = (dataArrayTime[i] - 128) / 128;
            sumSquares += norm * norm;
          }
          const rms = Math.sqrt(sumSquares / dataArrayTime.length);
          if (rms > 0.15) {
            detected = true;
            const rt = Math.round(performance.now() - playStart);
            latencyResult.textContent = `~${rt} ms round-trip (speaker → mic, includes OS/driver delay)`;
            return;
          }
          if (performance.now() - detectStart < 1500)
            requestAnimationFrame(poll);
          else
            latencyResult.textContent =
              "No clear echo detected — try raising volume or moving mic closer to speaker";
        }
        requestAnimationFrame(poll);
      });

      outSelect?.addEventListener("change", async () => {
        if ((micPlayback as any).setSinkId) {
          try {
            await (micPlayback as any).setSinkId(outSelect.value);
          } catch (e) {}
        }
      });

      document
        .getElementById("btn-fresh-start")
        ?.addEventListener("click", startFreshDiagSession);

      // ===================== TREND HISTORY (localStorage, this browser only) =====================
      const HISTORY_KEY = "ls_history_webcam_mic";
      const HISTORY_MAX_ENTRIES = 10;

      interface HistoryEntry {
        timestamp: number;
        micPeak: number | null; // 0-100
        clipCount: number | null;
        hum: string | null;
        thdPercent: number | null;
        camLight: number | null; // 0-100
        camSharp: number | null;
      }

      function loadHistory(): HistoryEntry[] {
        try {
          const raw = localStorage.getItem(HISTORY_KEY);
          if (!raw) return [];
          const parsed = JSON.parse(raw);
          return Array.isArray(parsed) ? parsed : [];
        } catch (e) {
          return [];
        }
      }

      function saveHistory(entries: HistoryEntry[]) {
        try {
          localStorage.setItem(HISTORY_KEY, JSON.stringify(entries));
        } catch (e) {
          // storage unavailable — ignore
        }
      }

      // Called after camera or mic finishes a run — captures whatever
      // metrics are currently on screen into a rolling history. Multiple
      // calls within a short window update the same "current session"
      // entry rather than creating duplicates, so starting cam then mic
      // in the same sitting produces one combined row, not two.
      let currentSessionHistoryId: number | null = null;

      function recordHistorySnapshot() {
        const history = loadHistory();

        const parsePercent = (text: string): number | null => {
          const m = text.match(/(-?\d+(\.\d+)?)/);
          return m ? parseFloat(m[1]) : null;
        };

        const micPeakText = readVal("micPeak");
        const camLightText = readVal("camLight");
        const camSharpText = readVal("camSharp");
        const thdText = readVal("thdValue");
        const humText = readVal("micHum");
        const clipText = readVal("micClip");

        const hasMicData = micPeakText !== "—";
        const hasCamData = camLightText !== "—";
        if (!hasMicData && !hasCamData) return;

        const now = Date.now();
        const entry: HistoryEntry = {
          timestamp: now,
          micPeak: hasMicData ? parsePercent(micPeakText) : null,
          clipCount: hasMicData ? parseInt(clipText, 10) || 0 : null,
          hum: hasMicData ? humText : null,
          thdPercent: thdText !== "—" ? parsePercent(thdText) : null,
          camLight: hasCamData ? parsePercent(camLightText) : null,
          camSharp: hasCamData
            ? parseFloat((camSharpText.match(/\(([\d.]+)\)/) || [])[1] || "")
            : null,
        };
        if (entry.camSharp !== undefined && isNaN(entry.camSharp as number))
          entry.camSharp = null;

        // Merge into the same row if we recorded something within the last
        // 5 minutes (i.e. still the same testing session), so cam+mic tested
        // back to back land in one row instead of two sparse ones.
        if (
          currentSessionHistoryId !== null &&
          history.length > 0 &&
          history[history.length - 1].timestamp === currentSessionHistoryId &&
          now - currentSessionHistoryId < 5 * 60 * 1000
        ) {
          const last = history[history.length - 1];
          history[history.length - 1] = {
            timestamp: last.timestamp,
            micPeak: entry.micPeak ?? last.micPeak,
            clipCount: entry.clipCount ?? last.clipCount,
            hum: entry.hum ?? last.hum,
            thdPercent: entry.thdPercent ?? last.thdPercent,
            camLight: entry.camLight ?? last.camLight,
            camSharp: entry.camSharp ?? last.camSharp,
          };
        } else {
          history.push(entry);
          currentSessionHistoryId = entry.timestamp;
          if (history.length > HISTORY_MAX_ENTRIES) history.shift();
        }

        saveHistory(history);
        renderHistory();
      }

      function formatRelativeTime(ts: number): string {
        const diffMs = Date.now() - ts;
        const mins = Math.floor(diffMs / 60000);
        if (mins < 1) return "Just now";
        if (mins < 60) return `${mins}m ago`;
        const hours = Math.floor(mins / 60);
        if (hours < 24) return `${hours}h ago`;
        const days = Math.floor(hours / 24);
        if (days < 7) return `${days}d ago`;
        return new Date(ts).toLocaleDateString();
      }

      function renderHistory() {
        const history = loadHistory();
        const emptyEl = document.getElementById("historyEmpty");
        const tableEl = document.getElementById(
          "historyTable",
        ) as HTMLTableElement | null;
        const tbody = document.getElementById("historyTableBody");
        const sparkCvs = document.getElementById(
          "historySparkline",
        ) as HTMLCanvasElement | null;

        if (history.length === 0) {
          if (emptyEl) emptyEl.style.display = "block";
          if (tableEl) tableEl.style.display = "none";
          if (sparkCvs) {
            const ctx = sparkCvs.getContext("2d");
            if (ctx) ctx.clearRect(0, 0, sparkCvs.width, sparkCvs.height);
          }
          return;
        }

        if (emptyEl) emptyEl.style.display = "none";
        if (tableEl) tableEl.style.display = "table";

        if (tbody) {
          tbody.innerHTML = [...history]
            .reverse()
            .map((e) => {
              const hum =
                e.hum && e.hum.startsWith("⚠")
                  ? `<span style="color:#f59e0b;">${e.hum}</span>`
                  : e.hum || "—";
              return `<tr style="border-top:1px solid var(--border);">
                <td style="padding:0.5rem 0.7rem; color:var(--text2);">${formatRelativeTime(e.timestamp)}</td>
                <td style="padding:0.5rem 0.7rem; color:var(--text);">${e.micPeak !== null ? e.micPeak + "%" : "—"}</td>
                <td style="padding:0.5rem 0.7rem; color:var(--text);">${e.clipCount !== null ? e.clipCount : "—"}</td>
                <td style="padding:0.5rem 0.7rem;">${hum}</td>
                <td style="padding:0.5rem 0.7rem; color:var(--text);">${e.thdPercent !== null ? e.thdPercent.toFixed(1) + "%" : "—"}</td>
                <td style="padding:0.5rem 0.7rem; color:var(--text);">${e.camLight !== null ? e.camLight + "%" : "—"}</td>
                <td style="padding:0.5rem 0.7rem; color:var(--text);">${e.camSharp !== null ? e.camSharp.toFixed(1) : "—"}</td>
              </tr>`;
            })
            .join("");
        }

        // Sparkline: mic peak level trend across sessions
        if (sparkCvs) {
          const ctx = sparkCvs.getContext("2d");
          if (ctx) {
            sparkCvs.width = sparkCvs.clientWidth;
            sparkCvs.height = 60;
            const w = sparkCvs.width,
              h = sparkCvs.height;
            ctx.clearRect(0, 0, w, h);

            const points = history
              .map((e) => e.micPeak)
              .filter((v): v is number => v !== null);

            if (points.length >= 2) {
              const max = Math.max(...points, 10);
              const min = Math.min(...points, 0);
              const range = Math.max(max - min, 1);
              const stepX = w / (points.length - 1);

              ctx.beginPath();
              ctx.moveTo(0, h);
              points.forEach((v, i) => {
                const y = h - ((v - min) / range) * (h - 10) - 5;
                ctx.lineTo(i * stepX, y);
              });
              ctx.lineTo(w, h);
              ctx.closePath();
              const grad = ctx.createLinearGradient(0, 0, 0, h);
              grad.addColorStop(0, "rgba(0,212,255,0.3)");
              grad.addColorStop(1, "rgba(0,212,255,0.02)");
              ctx.fillStyle = grad;
              ctx.fill();

              ctx.beginPath();
              points.forEach((v, i) => {
                const y = h - ((v - min) / range) * (h - 10) - 5;
                i === 0 ? ctx.moveTo(i * stepX, y) : ctx.lineTo(i * stepX, y);
              });
              ctx.strokeStyle = "#00d4ff";
              ctx.lineWidth = 2;
              ctx.stroke();

              ctx.fillStyle = "#8899aa";
              ctx.font = "10px sans-serif";
              ctx.fillText("Mic peak level trend", 6, 14);
            } else {
              ctx.fillStyle = "#8899aa";
              ctx.font = "11px sans-serif";
              ctx.fillText(
                "Run the mic test a few more times to see a trend",
                10,
                34,
              );
            }
          }
        }
      }

