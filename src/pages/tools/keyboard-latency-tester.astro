---
import { getProductsByPage, urlFor } from "../../lib/sanity";
import Base from "@layouts/Base.astro";

let products: any[] = [];
try {
  products = (await getProductsByPage("keyboard")) || [];
} catch (e) {
  products = [];
}
const pageUrl = "https://laptopsspecial.com/tools/keyboard-latency-tester/";
const siteUrl = "https://laptopsspecial.com/";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${pageUrl}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Keyboard Latency Tester",
      item: pageUrl,
    },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What is average keyboard latency?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Most keyboards fall between 1ms and 15ms depending on switch type (mechanical vs membrane) and connection method.",
      },
    },
    {
      "@type": "Question",
      name: "Which keyboard has the lowest latency?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The Logitech G915 TKL achieves as low as 1.3ms in wired mode, placing it among the fastest available keyboards today.",
      },
    },
    {
      "@type": "Question",
      name: "How can I reduce keyboard latency on Windows?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Update keyboard drivers, disable Filter Keys in accessibility settings, use a wired USB 3.0 connection, and close unnecessary background applications.",
      },
    },
    {
      "@type": "Question",
      name: "Does polling rate affect keyboard latency?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, it sets the maximum reporting interval — at 125Hz that's up to 8ms, at 1000Hz up to 1ms. Total latency also depends on switch debounce time and system processing, so a higher polling rate lowers the ceiling on latency rather than guaranteeing a lower number every time.",
      },
    },
    {
      "@type": "Question",
      name: "How is keyboard scan rate calculated?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "This tool actually measures your fastest recorded key-press duration, not the keyboard's true hardware scan rate, since scan rate is a fixed controller spec that can't be derived from press timing in a browser. Press duration is still useful for comparing individual keys or spotting a sluggish one.",
      },
    },
    {
      "@type": "Question",
      name: "Is 1ms keyboard latency actually noticeable?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Not for everyday typing — but in competitive FPS games running at 240fps, a single frame is only 4.17ms, so even 1-2ms of extra latency can shift your reaction window in close encounters.",
      },
    },
  ],
};
---

<Base
  title="Keyboard Tester Online | Full 104-Key Test — Latency & Polling Rate"
  description="Test every key on your full-size 104-key keyboard including numpad, arrows, navigation cluster, and function keys. Free browser-based keyboard tester — no download needed."
  canonical="https://laptopsspecial.com/tools/keyboard-latency-tester/"
>
  <style>
    /* ═══════════════════════════════════
     HERO
  ═══════════════════════════════════ */
    .hero {
      text-align: center;
      padding: 2.5rem 1.5rem 1.25rem;
    }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(0, 212, 255, 0.1);
      border: 1px solid rgba(0, 212, 255, 0.25);
      color: #00d4ff;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.3rem 0.8rem;
      border-radius: 100px;
      margin-bottom: 1.1rem;
    }
    [data-theme="light"] .hero-badge {
      background: rgba(2, 132, 199, 0.1);
      border-color: rgba(2, 132, 199, 0.3);
      color: #0284c7;
    }
    .hero h1 {
      font-size: clamp(1.6rem, 3.5vw, 2.5rem);
      font-weight: 700;
      line-height: 1.2;
      margin-bottom: 0.6rem;
      color: var(--text);
    }
    .hero h1 span {
      color: var(--accent);
    }
    .hero p {
      color: var(--text2);
      font-size: 0.95rem;
      max-width: 520px;
      margin: 0 auto;
    }

    /* ═══════════════════════════════════
     STATS ROW
  ═══════════════════════════════════ */
    .stats-row {
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      padding: 1.25rem 1.5rem;
      max-width: 1200px;
      margin: 0 auto;
    }
    .stat-card {
      min-width: 0;
    }
    .stat-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1rem 1.4rem;
      text-align: center;
      min-width: 140px;
      flex: 1;
      transition: border-color 0.2s;
    }
    .stat-card:hover {
      border-color: rgba(0, 212, 255, 0.35);
    }
    .stat-label {
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted);
      margin-bottom: 0.4rem;
    }
    .stat-value {
      font-family: var(--font-mono);
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--accent);
    }
    .stat-unit {
      font-size: 0.72rem;
      color: var(--muted);
      margin-top: 0.1rem;
    }

    /* ═══════════════════════════════════
     TOOL CARD WRAPPER
  ═══════════════════════════════════ */
    .tool-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1rem 1.5rem;
    }
    .tool-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
    }
    .tool-header {
      padding: 0.85rem 1.25rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .tool-title {
      font-size: 0.83rem;
      font-weight: 600;
      color: var(--text2);
    }
    .tool-status {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.76rem;
      font-weight: 600;
      color: var(--text2);
    }
    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #22c55e;
      animation: pulse 2s infinite;
      flex-shrink: 0;
    }
    @keyframes pulse {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0.3;
      }
    }

    /* ═══════════════════════════════════
     KEYBOARD SHELL
  ═══════════════════════════════════ */
    .kb-area {
      padding: 1.5rem 1.25rem 1rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .kb-prompt {
      text-align: center;
      color: var(--muted);
      font-size: 0.83rem;
      margin-bottom: 1rem;
    }

    /* Outer shell (mimics keyboard body) */
    .keyboard-shell {
      display: inline-flex;
      flex-direction: column;
      gap: 0;
      background: linear-gradient(160deg, #1a2540 0%, #111928 100%);
      border: 1px solid #243050;
      border-bottom: 4px solid #0a1020;
      border-radius: 12px;
      padding: 12px 14px 16px;
      box-shadow:
        0 12px 40px rgba(0, 0, 0, 0.6),
        inset 0 1px 0 rgba(255, 255, 255, 0.05);
      user-select: none;
      min-width: max-content;
    }
    [data-theme="light"] .keyboard-shell {
      background: linear-gradient(160deg, #c8d0dc 0%, #b8c2cc 100%);
      border-color: #9aa8b8;
      border-bottom-color: #7888a0;
      box-shadow:
        0 8px 28px rgba(0, 0, 0, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.7);
    }

    /* The 3 sections sit in a horizontal row */
    .kb-body {
      display: flex;
      gap: 14px;
      align-items: flex-start;
    }

    /* ═══════════════════════════════════
     KEY BASE STYLE
  ═══════════════════════════════════ */
    .k {
      position: relative;
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 38px;
      min-width: 38px;
      background: linear-gradient(
        180deg,
        #212e48 0%,
        #18243a 60%,
        #111d30 100%
      );
      border: 1px solid #2a3a58;
      border-bottom: 3px solid #090f1c;
      border-radius: 5px;
      font-family: var(--font-mono);
      font-size: 0.58rem;
      font-weight: 600;
      color: #9dbbd8;
      cursor: default;
      transition:
        background 0.07s,
        border-color 0.07s,
        transform 0.07s,
        color 0.07s,
        box-shadow 0.07s;
      white-space: nowrap;
      flex-shrink: 0;
      line-height: 1.1;
    }
    [data-theme="light"] .k {
      background: linear-gradient(180deg, #ffffff 0%, #eaeff6 100%);
      border-color: #c0ccd8;
      border-bottom-color: #8a9ab0;
      color: #2d4060;
    }

    /* Dual-legend keys: top symbol + main char */
    .k .sym {
      font-size: 0.5rem;
      color: #7a9ab8;
      line-height: 1;
      margin-bottom: 1px;
    }
    [data-theme="light"] .k .sym {
      color: #6080a0;
    }
    .k .ch {
      font-size: 0.6rem;
    }

    /* Pressed state */
    .k.pressed {
      background: linear-gradient(
        180deg,
        rgba(0, 212, 255, 0.3) 0%,
        rgba(0, 170, 210, 0.2) 100%
      ) !important;
      border-color: #00d4ff !important;
      border-bottom-color: rgba(0, 200, 240, 0.45) !important;
      color: #00d4ff !important;
      transform: translateY(2px) !important;
      box-shadow: 0 0 14px rgba(0, 212, 255, 0.3) !important;
    }
    .k.pressed .sym {
      color: #00d4ff !important;
    }
    [data-theme="light"] .k.pressed {
      color: #0284c7 !important;
      border-color: #0284c7 !important;
    }

    /* ═══════════════════════════════════
     KEY WIDTH TOKENS  (1u = 38px + gap)
     Gap between keys = 4px
     1u   = 38px
     1.25u= 49px
     1.5u = 60px
     1.75u= 71px
     2u   = 80px
     2.25u= 91px
     2.75u= 113px
     6.25u= 257px (space)
  ═══════════════════════════════════ */
    .w-125 {
      min-width: 49px;
    }
    .w-150 {
      min-width: 60px;
    }
    .w-175 {
      min-width: 71px;
    }
    .w-200 {
      min-width: 80px;
    }
    .w-225 {
      min-width: 91px;
    }
    .w-275 {
      min-width: 113px;
    }
    .w-625 {
      min-width: 257px;
    }

    /* ═══════════════════════════════════
     ROW LAYOUT
  ═══════════════════════════════════ */
    .kb-section {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .kb-row {
      display: flex;
      gap: 4px;
      align-items: flex-end;
    }

    /* Function row sits above main section with small gap */
    .fn-row {
      margin-bottom: 6px;
    }
    /* Small gap between F4/F5 and F8/F9 */
    .fn-gap {
      width: 10px;
      flex-shrink: 0;
    }

    /* ═══════════════════════════════════
     NUMPAD TALL KEYS  (2u tall)
  ═══════════════════════════════════ */
    .k-tall {
      height: 80px; /* 2 keys + 1 gap = 38+4+38 */
      justify-content: center;
    }

    /* ═══════════════════════════════════
     NAV CLUSTER — special layout
  ═══════════════════════════════════ */
    .nav-top-row {
      display: flex;
      gap: 4px;
    }
    .nav-mid-row {
      display: flex;
      gap: 4px;
      margin-top: 4px;
    }
    .nav-space {
      height: 38px;
      width: 38px;
      visibility: hidden;
    } /* invisible spacer */

    /* Arrow cluster */
    .arrow-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-top: 4px;
    }
    .arrow-top {
      display: flex;
      justify-content: center;
    }
    .arrow-bot {
      display: flex;
      gap: 4px;
    }

    /* ═══════════════════════════════════
     KEY HISTORY
  ═══════════════════════════════════ */
    .history-section {
      padding: 0 1.25rem 1.25rem;
    }
    .history-label {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted);
      margin-bottom: 0.6rem;
    }
    .history-feed {
      display: flex;
      flex-direction: column;
      gap: 6px;
      max-height: 320px;
      overflow-y: auto;
      padding-right: 4px;
    }
    .history-feed::-webkit-scrollbar {
      width: 6px;
    }
    .history-feed::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 3px;
    }
    .hkey {
      display: flex !important;
      flex-direction: row !important;
      align-items: center !important;
      justify-content: space-between !important;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 600;
      background: rgba(0, 212, 255, 0.1);
      border: 1px solid rgba(0, 212, 255, 0.22);
      color: #00d4ff;
      padding: 0.5rem 0.75rem;
      border-radius: 6px;
      animation: fadeIn 0.12s ease;
      width: 100%;
      box-sizing: border-box;
    }
    .hkey-key {
      flex: 0 0 auto;
      font-weight: 700;
      margin-right: 1rem;
    }
    .hkey-time {
      flex: 1 1 auto;
      text-align: right;
      font-size: 0.68rem;
      font-weight: 600;
      color: var(--muted);
      white-space: nowrap;
    }
    [data-theme="light"] .hkey {
      background: rgba(2, 132, 199, 0.1);
      border-color: rgba(2, 132, 199, 0.25);
      color: #0284c7;
    }
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: scale(0.75);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }
    .btn-reset {
      display: block;
      margin: 0.9rem auto 0;
      background: none;
      border: 1px solid var(--border);
      color: var(--muted);
      font-family: var(--font-display);
      font-size: 0.78rem;
      font-weight: 600;
      padding: 0.4rem 1.2rem;
      border-radius: 7px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-reset:hover {
      border-color: var(--muted);
      color: var(--text2);
    }

    /* ═══════════════════════════════════
     CTA + CONTENT
  ═══════════════════════════════════ */
    .cta-banner {
      max-width: 1200px;
      margin: 1.25rem auto;
      padding: 0 1rem;
    }
    .cta-inner {
      background: linear-gradient(
        135deg,
        rgba(124, 58, 237, 0.13),
        rgba(0, 212, 255, 0.08)
      );
      border: 1px solid rgba(124, 58, 237, 0.28);
      border-radius: 12px;
      padding: 1.1rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .cta-text {
      font-size: 0.88rem;
      color: var(--text2);
    }
    .cta-text strong {
      color: var(--text);
    }
    .cta-btn {
      background: var(--accent);
      color: #0a0e1a;
      font-family: var(--font-display);
      font-size: 0.83rem;
      font-weight: 700;
      padding: 0.55rem 1.2rem;
      border-radius: 8px;
      text-decoration: none;
      transition: opacity 0.2s;
    }
    .cta-btn:hover {
      opacity: 0.85;
    }

    .content-section {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1rem;
    }
    .content-section h2 {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 0.7rem;
      color: var(--text);
    }
    .content-section p {
      color: var(--text2);
      line-height: 1.75;
      font-size: 0.88rem;
      margin-bottom: 0.75rem;
    }
    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
      margin: 1rem 0;
    }
    .product-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      transition:
        border-color 0.2s,
        transform 0.2s;
    }
    .product-card:hover {
      border-color: rgba(0, 212, 255, 0.35);
      transform: translateY(-2px);
    }
    .product-img {
      width: 100%;
      aspect-ratio: 3/2;
      object-fit: cover;
    }
    .product-body {
      padding: 1rem;
    }
    .product-name {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 0.4rem;
    }
    .product-desc {
      font-size: 0.78rem;
      color: var(--text2);
      line-height: 1.5;
      margin-bottom: 0.6rem;
    }
    .product-cta {
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--accent);
    }
    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin: 1rem 0;
    }
    .info-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1rem;
    }
    .info-card-icon {
      font-size: 1.2rem;
      margin-bottom: 0.45rem;
    }
    .info-card-title {
      font-size: 0.83rem;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 0.3rem;
    }
    .info-card-desc {
      font-size: 0.78rem;
      color: var(--text2);
      line-height: 1.55;
    }
    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
      margin-top: 1rem;
    }
    .faq-item {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 0.95rem;
    }
    .faq-q {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 0.35rem;
    }
    .faq-a {
      font-size: 0.8rem;
      color: var(--text2);
      line-height: 1.65;
    }

    /* ═══════════════════════════════════
     MOBILE — shrink keyboard to fit
  ═══════════════════════════════════ */
    @media (max-width: 900px) {
      .keyboard-shell {
        transform: scale(0.62);
        transform-origin: top left;
      }
      .kb-area {
        min-height: 260px;
      }
    }
    @media (max-width: 540px) {
      .keyboard-shell {
        transform: scale(0.45);
        transform-origin: top left;
      }
      .kb-area {
        min-height: 200px;
      }
    }
    .confidence-badge {
      display: none;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 0.4rem 0.8rem;
      border-radius: 100px;
      width: fit-content;
      flex-shrink: 0;
    }
    .confidence-badge.show {
      display: flex;
    }
    .confidence-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .confidence-badge.status-good {
      background: rgba(34, 197, 94, 0.12);
      border: 1px solid rgba(34, 197, 94, 0.3);
      color: #22c55e;
    }
    .confidence-badge.status-good .confidence-dot {
      background: #22c55e;
    }

    .confidence-badge.status-check {
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.3);
      color: #f59e0b;
    }
    .confidence-badge.status-check .confidence-dot {
      background: #f59e0b;
    }

    .confidence-badge.status-investigate {
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #ef4444;
    }
    .confidence-badge.status-investigate .confidence-dot {
      background: #ef4444;
    }
    .kb-actions {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      align-items: center;
    }
    .btn-sm {
      background: none;
      border: 1px solid var(--border);
      color: var(--muted);
      font-family: var(--font-display);
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.35rem 0.85rem;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
    }
    .btn-sm:hover {
      border-color: var(--muted);
      color: var(--text);
    }
    .btn-pdf {
      border-color: rgba(0, 212, 255, 0.4);
      color: var(--accent);
      font-weight: 700;
    }
    .btn-pdf:hover {
      border-color: var(--accent);
      background: rgba(0, 212, 255, 0.08);
    }
    .btn-fulldiag {
      border-color: rgba(34, 197, 94, 0.4);
      color: #22c55e;
      font-weight: 700;
    }
    .btn-fulldiag:hover {
      border-color: #22c55e;
      background: rgba(34, 197, 94, 0.08);
    }
  </style>
  <style is:global>
    .history-feed .hkey {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 600;
      background: rgba(0, 212, 255, 0.1);
      border: 1px solid rgba(0, 212, 255, 0.22);
      color: #00d4ff;
      padding: 0.5rem 0.75rem;
      border-radius: 6px;
      width: 100%;
