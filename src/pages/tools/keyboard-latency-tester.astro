    <h2 style="margin-top:2rem;">Frequently Asked Questions</h2>
    <div class="faq-list">
      <div class="faq-item">
        <div class="faq-q">What is average keyboard latency?</div><div
          class="faq-a"
        >
          Most keyboards fall between 1ms and 15ms depending on switch type
          (mechanical vs membrane) and connection method.
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-q">Which keyboard has the lowest latency?</div><div
          class="faq-a"
        >
          The Logitech G915 TKL achieves as low as 1.3ms in wired mode, placing
          it among the fastest available keyboards today.
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-q">
          How can I reduce keyboard latency on Windows?
        </div><div class="faq-a">
          Update keyboard drivers, disable Filter Keys in accessibility
          settings, use a wired USB 3.0 connection, and close unnecessary
          background applications.
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-q">Does polling rate affect keyboard latency?</div><div
          class="faq-a"
        >
          Yes, it sets the maximum reporting interval — at 125Hz that's up to
          8ms, at 1000Hz up to 1ms. Total latency also depends on switch
          debounce time and system processing, so a higher polling rate lowers
          the ceiling on latency rather than guaranteeing a lower number every
          time.
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-q">How is keyboard scan rate calculated?</div>
        <div class="faq-a">
          This tool actually measures your fastest recorded key-press duration,
          not the keyboard's true hardware scan rate, since scan rate is a fixed
          controller spec that can't be derived from press timing in a browser.
          Press duration is still useful for comparing individual keys or
          spotting a sluggish one.
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-q">Is 1ms keyboard latency actually noticeable?</div>
        <div class="faq-a">
          Not for everyday typing — but in competitive FPS games running at
          240fps, a single frame is only 4.17ms, so even 1-2ms of extra latency
          can shift your reaction window in close encounters.
        </div>
      </div>
    </div>
  </div>

  <!-- ════════════════════════
     JAVASCRIPT
════════════════════════ -->
  <script>
    // A module-scoped controller keeps track of the currently active
    // keydown/keyup listeners. Since this script tag is part of the
    // page content that gets swapped by View Transitions, "astro:page-load"
    // fires every time this page becomes active again (including when
    // navigating away and back) — that's what makes the tool work again
    // without a manual reload. The controller lets us cleanly remove the
    // previous run's listeners first, so they don't stack up.
    let controller: AbortController | null = null;

    function getKeyEl(code: string): HTMLElement | null {
      return document.querySelector(`.k[data-code="${code}"]`);
    }
    function getDiagSessionId(): string {
      let id = sessionStorage.getItem("ls_diag_session");
      if (!id) {
        id = `${Date.now()}-${Math.random().toString(36).slice(2)}`;
        sessionStorage.setItem("ls_diag_session", id);
      }
      return id;
    }

    function isFromThisSession(key: string): boolean {
      try {
        const raw = localStorage.getItem(key);
        if (!raw) return false;
        const parsed = JSON.parse(raw);
        return parsed.sessionId === getDiagSessionId();
      } catch {
        return false;
      }
    }
    function startFreshDiagSession() {
      try {
        localStorage.removeItem("ls_diag_monitor");
        localStorage.removeItem("ls_diag_keyboard");
        localStorage.removeItem("ls_diag_mouse");
        localStorage.removeItem("ls_diag_screen");
        sessionStorage.removeItem("ls_diag_session");
      } catch (e) {
        // storage unavailable — ignore
      }
      location.reload();
    }
    document.addEventListener("astro:page-load", () => {
      const sShort = document.getElementById("s-short");
      const sScan = document.getElementById("s-scan");
      const sCount = document.getElementById("s-count");
      const sUnique = document.getElementById("s-unique");
      const feed = document.getElementById("history-feed");
      const kbPrompt = document.getElementById("kb-prompt");
      const btnReset = document.getElementById("btn-reset");

      if (!feed) return;

      // Remove any listeners left over from a previous page-load
      // (e.g. the user navigated away and came back to this page).
      controller?.abort();
      controller = new AbortController();
      const { signal } = controller;

      let shortestPress = Infinity;
      let totalKeys = 0;
      let historyCleared = false;
      const keyDownTimes = new Map<string, number>();
      const pressedCodes = new Set<string>();
      const recentDurations: number[] = [];

      document.addEventListener(
        "keydown",
        (e: KeyboardEvent) => {
          // Agar user Ctrl, Alt, ya Meta (Windows/Mac) key use kar raha hai, ya F1-F12 daba raha hai
          // toh usko block mat karo, browser apna kaam karega.
          if (!e.ctrlKey && !e.metaKey && !e.altKey && !e.key.startsWith("F")) {
            // Sirf in keys par scroll roko taaki test karte waqt page upar-niche jump na kare
            if (
              [
                "Space",
                "ArrowUp",
                "ArrowDown",
                "ArrowLeft",
                "ArrowRight",
              ].includes(e.code)
            ) {
              e.preventDefault();
            }
          }

          // Yahan se purana code shuru hota hai jo keys ko screen par highlight karta hai
          const el = getKeyEl(e.code);
          if (el) el.classList.add("pressed");

          if (!keyDownTimes.has(e.code)) {
            keyDownTimes.set(e.code, performance.now());
          }
          if (kbPrompt) kbPrompt.style.display = "none";
        },
        { signal },
      );

      document.addEventListener(
        "keyup",
        (e: KeyboardEvent) => {
          const el = getKeyEl(e.code);
          if (el) el.classList.remove("pressed");

          const t = keyDownTimes.get(e.code);
          if (t === undefined) return;
          keyDownTimes.delete(e.code);

          const dur = performance.now() - t;

          recentDurations.push(dur);
          if (recentDurations.length > 8) recentDurations.shift();
          const avgRecentDur =
            recentDurations.reduce((a, b) => a + b, 0) / recentDurations.length;

          if (!historyCleared) {
            feed.innerHTML = "";
            historyCleared = true;
          }

          // History tag
          const keyLabel =
            e.key === " "
              ? "Space"
              : e.key.length > 8
                ? e.code
                    .replace("Key", "")
                    .replace("Digit", "")
                    .replace("Numpad", "Num")
                : e.key;

          const now = new Date();
          const timeLabel = now.toLocaleTimeString("en-US", {
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
          });

          const tag = document.createElement("div");
          tag.className = "hkey";
          tag.title = `${dur.toFixed(1)} ms — ${timeLabel}`;

          const keySpan = document.createElement("span");
          keySpan.className = "hkey-key";
          keySpan.textContent = keyLabel;

          const timeSpan = document.createElement("span");
          timeSpan.className = "hkey-time";
          timeSpan.textContent = `${dur.toFixed(1)}ms · ${timeLabel}`;

          tag.appendChild(keySpan);
          tag.appendChild(timeSpan);
          feed.prepend(tag);

          // Stats
          totalKeys++;
          if (sCount) sCount.textContent = String(totalKeys);

          pressedCodes.add(e.code);
          if (sUnique) sUnique.textContent = String(pressedCodes.size);

          if (dur < shortestPress) {
            shortestPress = dur;
          }
          if (sShort) sShort.textContent = shortestPress.toFixed(1);
          if (sScan) sScan.textContent = dur.toFixed(1);

          const kbBadge = document.getElementById("kb-confidence");
          const kbBadgeText = document.getElementById("kb-confidence-text");
          if (kbBadge && kbBadgeText && recentDurations.length >= 3) {
            kbBadge.classList.add("show");
            kbBadge.classList.remove(
              "status-good",
              "status-check",
              "status-investigate",
            );
            if (avgRecentDur < 20) {
              kbBadge.classList.add("status-good");
              kbBadgeText.textContent = "Good — response time is healthy";
            } else if (avgRecentDur < 60) {
              kbBadge.classList.add("status-check");
              kbBadgeText.textContent =
                "Check — slightly slow, test a few more keys";
            } else {
              kbBadge.classList.add("status-investigate");
              kbBadgeText.textContent =
                "Investigate — consistently slow response";
            }
          }

          const interpretBox = document.getElementById("result-interpret");
          const interpretText = document.getElementById(
            "result-interpret-text",
          );
          if (interpretBox && interpretText) {
            interpretBox.style.display = "block";
            if (dur < 20) {
              interpretText.textContent =
                "Fast, consistent response — this key is behaving normally, in line with a typical 1-15ms range depending on your keyboard's switch type.";
            } else if (dur < 60) {
              interpretText.textContent =
                "Slightly higher than typical, but still within normal range for everyday typing. Test a few more keys to see if this is consistent or specific to one key.";
            } else {
              interpretText.textContent =
                "Noticeably slower than average. If this happens on one specific key repeatedly, it could indicate a sticky switch or debris under the keycap — worth cleaning or investigating further.";
            }
            // ---- Save result for combined Full Diagnostic Report ----

            try {
              const consistency = Math.round((pressedCodes.size / 104) * 100);

              let kbStatus: "good" | "check" | "investigate" = "good";

              if (shortestPress >= 60) kbStatus = "investigate";
              else if (shortestPress >= 20) kbStatus = "check";

              const kbScore =
                kbStatus === "good" ? 92 : kbStatus === "check" ? 72 : 45;

              localStorage.setItem(
                "ls_diag_keyboard",

                JSON.stringify({
                  tool: "keyboard",

                  score: kbScore,

                  status: kbStatus,

                  metrics: {
                    "Keyboard response": `${shortestPress.toFixed(1)} ms`,

                    "Keys tested": `${pressedCodes.size} / 104 (${consistency}%)`,
                  },

                  timestamp: Date.now(),
                  sessionId: getDiagSessionId(),
                }),
              );
            } catch (e) {
              // localStorage unavailable — silently skip
            }

            // ---- Next-step nudge ----
            const nextBanner = document.getElementById("next-step-banner");
            const nextText = document.getElementById("next-step-text");
            if (nextBanner && nextText) {
              const remaining: { label: string; url: string }[] = [];
              if (!isFromThisSession("ls_diag_mouse"))
                remaining.push({
                  label: "mouse",
                  url: "/tools/mouse-rate-test/",
                });
              if (!isFromThisSession("ls_diag_monitor"))
                remaining.push({
                  label: "monitor",
                  url: "/tools/monitor-refresh-rate-test/",
                });
              if (!isFromThisSession("ls_diag_screen"))
                remaining.push({
                  label: "screen",
                  url: "/tools/screen-test/",
                });

              let newHtml: string;
              if (remaining.length === 0) {
                newHtml =
                  '🎉 All tests done! <a href="/full-diagnostic-report/" target="_blank" rel="noopener" data-astro-reload style="color:var(--accent);font-weight:700;">View your Full Diagnostic Report →</a>';
              } else if (remaining.length === 1) {
                const r = remaining[0];
                newHtml = `✅ Keyboard done. Next: <a href="${r.url}" data-astro-reload style="color:var(--accent);font-weight:700;">test your ${r.label} →</a>`;
              } else {
                const last = remaining[remaining.length - 1];
                const rest = remaining.slice(0, -1);
                newHtml = `✅ Keyboard done. Complete these for your full report: ${rest.map((r) => `<a href="${r.url}" data-astro-reload style="color:var(--accent);font-weight:700;">${r.label}</a>`).join(", ")} &amp; <a href="${last.url}" data-astro-reload style="color:var(--accent);font-weight:700;">${last.label}</a>`;
              }

              nextBanner.style.display = "block";
              if (nextText.dataset.currentHtml !== newHtml) {
                nextText.innerHTML = newHtml;
                nextText.dataset.currentHtml = newHtml;
              }
            }
          }
        },
        { signal },
      );

      btnReset?.addEventListener(
        "click",
        () => {
          shortestPress = Infinity;
          totalKeys = 0;
          historyCleared = false;
          pressedCodes.clear();
          keyDownTimes.clear();
          recentDurations.length = 0;
          if (sShort) sShort.textContent = "—";
          if (sScan) sScan.textContent = "—";
          if (sCount) sCount.textContent = "0";
          if (sUnique) sUnique.textContent = "0";
          feed.innerHTML =
            '<span style="color:var(--muted);font-size:.78rem;">Keys will appear here…</span>';
          document
            .querySelectorAll(".k.pressed")
            .forEach((k) => k.classList.remove("pressed"));
          if (kbPrompt) kbPrompt.style.display = "";
        },
        { signal },
      );
      document
        .getElementById("btn-fresh-start")
        ?.addEventListener("click", startFreshDiagSession);
      // ---- Download PDF Report ----
      document.getElementById("btn-pdf")?.addEventListener("click", () => {
        if (totalKeys < 5) {
          return;
        }
        const jsPDFLib = (window as any).jspdf;
        if (!jsPDFLib || !jsPDFLib.jsPDF) {
          return;
        }

        const consistency = Math.round((pressedCodes.size / 104) * 100);
        let statusLabel = "Good";
        let statusNote = "Response time is healthy across tested keys.";
        if (shortestPress >= 60) {
          statusLabel = "Investigate";
          statusNote =
            "Consistently slow response detected — check for a sticky switch or debris under the keycap.";
        } else if (shortestPress >= 20) {
          statusLabel = "Check";
          statusNote =
            "Slightly higher than typical response time. Test a few more keys to confirm.";
        }

        const { jsPDF } = jsPDFLib;
        const doc = new jsPDF({ unit: "pt", format: "a4" });
        const pageWidth = doc.internal.pageSize.getWidth();
        const margin = 48;
        let y = 56;

        doc.setFillColor(10, 14, 26);
        doc.rect(0, 0, pageWidth, 90, "F");
        doc.setTextColor(255, 255, 255);
        doc.setFont("helvetica", "bold");
        doc.setFontSize(18);
        doc.text("Laptops Special — Hardware Diagnostic Report", margin, 40);
        doc.setFont("helvetica", "normal");
        doc.setFontSize(10);
        doc.setTextColor(180, 190, 210);
        doc.text("Device: Keyboard", margin, 60);
        doc.text(`Generated: ${new Date().toLocaleString()}`, margin, 75);

        y = 120;
        const statusColor: [number, number, number] =
          statusLabel === "Good"
            ? [34, 197, 94]
            : statusLabel === "Check"
              ? [245, 158, 11]
              : [239, 68, 68];
        doc.setFillColor(...statusColor);
        doc.roundedRect(margin, y, 90, 22, 4, 4, "F");
        doc.setTextColor(255, 255, 255);
        doc.setFont("helvetica", "bold");
        doc.setFontSize(11);
        doc.text(statusLabel, margin + 45, y + 15, { align: "center" });

        y += 40;
        doc.setTextColor(60, 60, 70);
        doc.setFont("helvetica", "normal");
        doc.setFontSize(10);
        const noteLines = doc.splitTextToSize(
          statusNote,
          pageWidth - margin * 2,
        );
        doc.text(noteLines, margin, y);
        y += noteLines.length * 13 + 20;

        doc.setDrawColor(220, 220, 225);
        doc.line(margin, y, pageWidth - margin, y);
        y += 22;
        doc.setFont("helvetica", "bold");
        doc.setFontSize(13);
        doc.setTextColor(20, 20, 30);
        doc.text("Keyboard Test Results", margin, y);
        y += 18;

        const rows: [string, string][] = [
          ["Shortest Press (session best)", `${shortestPress.toFixed(1)} ms`],
          ["Total Keys Pressed", String(totalKeys)],
          [
            "Unique Keys Tested",
            `${pressedCodes.size} / 104 (${consistency}%)`,
          ],
        ];
        doc.setFont("helvetica", "normal");
        doc.setFontSize(10.5);
        rows.forEach(([label, val]) => {
          doc.setTextColor(90, 90, 100);
          doc.text(label, margin, y);
          doc.setTextColor(20, 20, 30);
          doc.setFont("helvetica", "bold");
          doc.text(val, pageWidth - margin, y, { align: "right" });
          doc.setFont("helvetica", "normal");
          y += 18;
        });

        y += 16;
        doc.setDrawColor(220, 220, 225);
        doc.line(margin, y, pageWidth - margin, y);
        y += 18;
        doc.setFont("helvetica", "italic");
        doc.setFontSize(8.5);
        doc.setTextColor(130, 130, 140);
        const disclaimer = doc.splitTextToSize(
          "This tool measures browser-observed key-press duration, not the keyboard's true hardware scan rate. See laptopsspecial.com/how-accurate-are-these-tests/ for full methodology.",
          pageWidth - margin * 2,
        );
        doc.text(disclaimer, margin, y);
        y += disclaimer.length * 11 + 10;
        doc.setFont("helvetica", "normal");
        doc.setTextColor(0, 150, 200);
        doc.text(
          "laptopsspecial.com/tools/keyboard-latency-tester/",
          margin,
          y,
        );

        doc.save(`keyboard-diagnostic-report-${Date.now()}.pdf`);
      });
    });

    // Belt-and-braces: also clean up right before a page swap happens,
    // so listeners never survive across a navigation even in edge cases.
    document.addEventListener("astro:before-swap", () => {
      controller?.abort();
    });
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />
</Base>
