---
import Base from "@layouts/Base.astro";

const siteUrl = "https://laptopsspecial.com/";
const pageUrl = siteUrl;

const seoTitle =
  "Free PC Diagnostic Tools — Keyboard, Mouse, Monitor Testers & Screen Tester";
const seoDescription =
  "All free browser-based hardware testing tools in one place. Test your keyboard latency, mouse polling rate, and monitor refresh rate — no downloads, no signup.";

const tools = [
  {
    icon: "⌨️",
    name: "Keyboard Tester",
    url: "/tools/keyboard-latency-tester/",
    color: "#00d4ff",
    badge: "Full 104-Key Test",
    description:
      "Test every key on your full-size keyboard including numpad, arrows, and function keys. Measures fastest key response live in your browser.",
    tags: ["Latency test", "Key response", "104-key layout"],
    cta: "Test Keyboard Debounce & Latency",
  },
  {
    icon: "🖱",
    name: "Mouse Rate Test",
    url: "/tools/mouse-rate-test/",
    color: "#a78bfa",
    badge: "Up to 8000Hz",
    description:
      "Check your mouse's browser-observed polling rate, click latency, jitter, and movement speed. Includes a live heatmap and CPS counter, with JSON/CSV export for deeper analysis.",
    tags: ["Polling rate", "Jitter", "Click latency"],
    cta: "Test Mouse Polling & Latency",
  },
  {
    icon: "🖥️",
    name: "Monitor Refresh Rate Test",
    url: "/tools/monitor-refresh-rate-test/",
    color: "#f59e0b",
    badge: "Live Hz + Grade",
    description:
      "Measure your screen's browser-observed refresh rate and frame consistency with a stability grade. Includes a motion clarity test and a VRR/G-Sync simulator to see the difference.",
    tags: ["Refresh rate", "Frame timing", "VRR simulator"],
    cta: "Test Monitor Refresh Rate",
  },
  {
    icon: "🟦",
    name: "Screen Test",
    url: "/tools/screen-test/",
    color: "#2dd4bf",
    badge: "Dead Pixel + Color",
    description:
      "Check for dead/stuck pixels, backlight bleed, color accuracy, motion blur, and text sharpness — plus a one-click Full Screen Health Check that runs the full sequence automatically.",
    tags: ["Dead pixel", "Backlight bleed", "Color accuracy"],
    cta: "Check for Dead Pixels",
  },
  {
    icon: "🎙️",
    name: "Webcam/Mic/Speaker Test",
    url: "/tools/webcam-mic-speaker-test/",
    color: "#f472b6",
    badge: "Live FPS + Audio",
    description:
      "Check your webcam's live FPS, light and focus, mic waveform with clipping detection, and a full left/right speaker channel test — all in one place.",
    tags: ["Webcam FPS", "Mic test", "Speaker test"],
    cta: "Test Webcam, Mic & Speakers",
  },
];

// CollectionPage + ItemList schema — @id references point at the real
// tool pages (each tool page should carry a matching #webapp / #software
// @id in its own schema block).
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${pageUrl}#collection`,
  url: pageUrl,
  name: seoTitle,
  description: seoDescription,
  isPartOf: { "@id": `${siteUrl}#website` },
  about: {
    "@type": "ItemList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        url: `${siteUrl}tools/keyboard-latency-tester/#webapp`,
        name: "Keyboard Tester",
      },
      {
        "@type": "ListItem",
        position: 2,
        url: `${siteUrl}tools/mouse-rate-test/#webapp`,
        name: "Mouse Rate Test",
      },
      {
        "@type": "ListItem",
        position: 3,
        url: `${siteUrl}tools/monitor-refresh-rate-test/#software`,
        name: "Monitor Refresh Rate Test",
      },
      {
        "@type": "ListItem",
        position: 4,
        url: `${siteUrl}tools/screen-test/#webapp`,
        name: "Screen Test",
      },
      {
        "@type": "ListItem",
        position: 5,
        url: `${siteUrl}tools/webcam-mic-speaker-test/#webapp`,
        name: "Webcam/Mic/Speaker Test",
      },
      {
        "@type": "ListItem",
        position: 5,
        url: `${siteUrl}tools/webcam-mic-speaker-test/#webapp`,
        name: "Webcam/Mic/Speaker Test",
      },
    ],
  },
};

// Homepage is the root — no breadcrumb trail needed above it.
// (Previously this pointed to a non-existent /tools/ page and 404'd.)

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is my data uploaded or stored anywhere?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. Every test runs locally in your browser. Data never leaves your device or gets sent to any server.",
      },
    },
    {
      "@type": "Question",
      name: "Why does my 1000Hz mouse show a lower polling rate in the test?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "This is a browser limitation, not a mouse problem. Browsers throttle input event updates to conserve battery and CPU, so a 1000Hz mouse may display 60-120Hz in-browser even while reporting correctly at full rate.",
      },
    },
    {
      "@type": "Question",
      name: "Why is my keyboard stuck at 125Hz even on a gaming keyboard?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Standard office and budget keyboards are hardware-locked to 125Hz regardless of software settings. Only keyboards explicitly rated 1000Hz+ can exceed this.",
      },
    },
    {
      "@type": "Question",
      name: "Are these tests actually accurate, or just an estimate?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Browser-based tests measure input as it reaches your operating system, making them reliable for comparison. However, browsers typically cap visual updates around 60-120Hz, so a 1000Hz mouse may show a lower reading even when the hardware works correctly.",
      },
    },
    {
      "@type": "Question",
      name: "Do I need to install anything to use these tools?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. All five tools run entirely in your browser using native web APIs — nothing is installed, and no drivers are required.",
      },
    },
    {
      "@type": "Question",
      name: "Do these tools work on laptops and trackpads?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes — the keyboard and mouse testers work with built-in laptop keyboards and trackpads as well as external peripherals, on any modern browser.",
      },
    },
    {
      "@type": "Question",
      name: "Which browser gives the most accurate results?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Chromium-based browsers (Chrome, Edge) generally expose the most precise timing APIs for polling-rate and refresh-rate measurement.",
      },
    },
    {
      "@type": "Question",
      name: "Can these tools detect a faulty or dying peripheral?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, indirectly. Inconsistent jitter, keys that fail to register, or a refresh rate that won't hold steady are all signs worth investigating before assuming you need a replacement.",
      },
    },
    {
      "@type": "Question",
      name: "Can I check for dead pixels before buying a laptop?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes — run the Screen Test's Full Health Check in a dark room at full brightness. It cycles through black, white, and color screens so you can spot dead or stuck pixels and backlight bleed in under a minute.",
      },
    },
    {
      "@type": "Question",
      name: "Can this tool tell if my webcam or mic is actually broken?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "It can rule out a lot of false alarms — no signal at all usually means a permissions or device-selection issue, not broken hardware. Persistent clipping, a stuck-low FPS in good light, or audio from the wrong speaker channel are stronger signs worth investigating further.",
      },
    },
  ],
};
---

<Base
  title={`${seoTitle} | Laptops Special`}
  description={seoDescription}
  canonical={pageUrl}
  noWebAppSchema={true}
>
  <style>
    .hub-hero {
      text-align: center;
      padding: 3rem 1.5rem 2rem;
    }
    .hub-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(0, 212, 255, 0.1);
      border: 1px solid rgba(0, 212, 255, 0.25);
      color: #00d4ff;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.3rem 0.8rem;
      border-radius: 100px;
      margin-bottom: 1.1rem;
    }
    [data-theme="light"] .hub-badge {
      background: rgba(2, 132, 199, 0.1);
      border-color: rgba(2, 132, 199, 0.3);
      color: #0284c7;
    }
    .hub-hero h1 {
      font-size: clamp(1.75rem, 4vw, 2.75rem);
      font-weight: 700;
      color: var(--text);
      margin-bottom: 0.75rem;
    }
    .hub-hero p {
      color: var(--text2);
      font-size: 1rem;
      max-width: 560px;
      margin: 0 auto;
      line-height: 1.7;
    }

    .tool-grid {
      max-width: 1080px;
      margin: 0 auto;
      padding: 1rem 1.5rem 3rem;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.25rem;
    }
    .tool-hub-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      transition:
        border-color 0.2s,
        transform 0.2s;
    }
    .tool-hub-card:hover {
      transform: translateY(-3px);
    }
    .tool-hub-icon {
      font-size: 2rem;
      margin-bottom: 0.75rem;
    }
    .tool-hub-badge {
      display: inline-block;
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 0.2rem 0.55rem;
      border-radius: 100px;
      margin-bottom: 0.6rem;
      width: fit-content;
    }
    .tool-hub-name {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 0.5rem;
    }
    .tool-hub-desc {
      font-size: 0.85rem;
      color: var(--text2);
      line-height: 1.65;
      margin-bottom: 1rem;
      flex-grow: 1;
    }
    .tool-hub-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 1.1rem;
    }
    .tool-hub-tag {
      font-size: 0.68rem;
      font-weight: 600;
      color: var(--muted);
      background: var(--bg3);
      border: 1px solid var(--border);
      padding: 0.2rem 0.55rem;
      border-radius: 6px;
    }
    .tool-hub-cta {
      font-size: 0.85rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }

    .hub-content {
      max-width: 760px;
      margin: 0 auto;
      padding: 1rem 1.5rem 4rem;
    }
    .hub-content h2 {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text);
      margin: 2rem 0 0.75rem;
    }
    .hub-content p {
      color: var(--text2);
      font-size: 0.88rem;
      line-height: 1.8;
      margin-bottom: 0.9rem;
    }
    .info-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      margin: 1.5rem 0;
    }
    @media (max-width: 900px) {
      .info-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 560px) {
      .info-grid {
        grid-template-columns: 1fr;
      }
    }
    .info-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1rem;
    }
    .info-card-icon {
      font-size: 1.2rem;
      margin-bottom: 0.45rem;
    }
    .info-card-title {
      font-size: 0.83rem;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 0.3rem;
    }
    .info-card-desc {
      font-size: 0.78rem;
      color: var(--text2);
      line-height: 1.55;
    }
    .trust-strip {
      display: flex;
      justify-content: center;
      gap: 1.5rem;
      flex-wrap: wrap;
      padding: 0 1.5rem 2rem;
      max-width: 900px;
      margin: 0 auto;
    }
    .trust-item {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.78rem;
      color: var(--muted);
      font-weight: 600;
    }
    .pro-section {
      max-width: 1080px;
      margin: 0 auto;
      padding: 1rem 1.5rem 0.5rem;
    }
    .pro-badge-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 0.9rem 0 1.1rem;
    }
    .pro-badge {
      font-size: 0.76rem;
      font-weight: 700;
      color: var(--text2);
      background: var(--bg3);
      border: 1px solid var(--border);
      padding: 0.3rem 0.75rem;
      border-radius: 100px;
    }
    .pro-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1rem;
    }
    .pro-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.1rem 1.25rem;
    }
    .pro-card-title {
      font-size: 0.86rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 0.4rem;
    }
    .pro-card-desc {
      font-size: 0.8rem;
      color: var(--text2);
      line-height: 1.6;
    }

    .diagnosis-section {
      max-width: 1080px;
      margin: 0 auto;
      padding: 0.5rem 1.5rem 2rem;
    }
    .diagnosis-header {
      text-align: center;
      margin-bottom: 1.5rem;
    }
    .diagnosis-header h2 {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 0.4rem;
    }
    .diagnosis-header p {
      font-size: 0.85rem;
      color: var(--text2);
      max-width: 480px;
      margin: 0 auto;
      line-height: 1.6;
    }
    .diagnosis-steps {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      position: relative;
    }
    @media (max-width: 800px) {
      .diagnosis-steps {
        grid-template-columns: 1fr;
        gap: 0.9rem;
      }
      .diag-arrow {
        display: none;
      }
    }
    .diag-step {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.25rem 1.1rem;
      text-align: center;
      position: relative;
    }
    .diag-step-num {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: rgba(0, 212, 255, 0.12);
      border: 1px solid rgba(0, 212, 255, 0.3);
      color: #00d4ff;
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 0.78rem;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 0.6rem;
    }
    [data-theme="light"] .diag-step-num {
      background: rgba(2, 132, 199, 0.1);
      border-color: rgba(2, 132, 199, 0.3);
      color: #0284c7;
    }
    .diag-step-icon {
      font-size: 1.5rem;
      margin-bottom: 0.4rem;
    }
    .diag-step-title {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 0.35rem;
    }
    .diag-step-desc {
      font-size: 0.76rem;
      color: var(--text2);
      line-height: 1.5;
    }
    .diag-arrow {
      position: absolute;
      top: 50%;
      right: -14px;
      transform: translateY(-50%);
      color: var(--muted);
      font-size: 1.1rem;
      z-index: 2;
    }
    .diagnosis-cta {
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-top: 1.5rem;
    }
    .diag-cta-btn {
      background: var(--accent);
      color: #0a0e1a;
      font-family: var(--font-display);
      font-size: 0.82rem;
      font-weight: 700;
      padding: 0.55rem 1.15rem;
      border-radius: 8px;
      text-decoration: none;
      transition: opacity 0.15s;
    }
    .diag-cta-btn:hover {
      opacity: 0.85;
    }
    .diag-cta-btn.secondary {
      background: none;
      border: 1px solid var(--border);
      color: var(--text2);
    }

    .why-section {
      max-width: 1080px;
      margin: 0 auto;
      padding: 0 1.5rem 1rem;
    }
    .why-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1rem;
      margin-top: 1rem;
    }
    .why-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.1rem 1.25rem;
    }
    .why-card-title {
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 0.4rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .why-card-desc {
      font-size: 0.8rem;
      color: var(--text2);
      line-height: 1.6;
    }
    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
      margin-top: 1rem;
    }
    .faq-item {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 0.95rem;
    }
    .faq-q {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 0.35rem;
    }
    .faq-a {
      font-size: 0.8rem;
      color: var(--text2);
      line-height: 1.65;
    }
  </style>

  <div class="hub-hero">
    <div class="hub-badge">🟢 100% Free — No Signup</div>
    <h1>Free PC Diagnostic Tools</h1>
    <p>
      Not just pass/fail testers — these tools measure jitter, stability, and
      consistency, explain what the numbers actually mean, and are upfront about
      what a browser can and can't measure. Test your keyboard, mouse, and
      monitor instantly, no downloads required.
    </p>
  </div>
  <div class="trust-strip">
    <span class="trust-item">🚫 No downloads</span>
    <span class="trust-item">🔒 Runs locally in your browser</span>
    <span class="trust-item">⚡ Instant results</span>
    <span class="trust-item">🆓 100% free, no signup</span>
  </div>
  <div class="tool-grid">
    {
      tools.map((tool) => (
        <a href={tool.url} class="tool-hub-card" data-astro-reload>
          <div class="tool-hub-icon">{tool.icon}</div>
          <span
            class="tool-hub-badge"
            style={`background: ${tool.color}1A; color: ${tool.color}; border: 1px solid ${tool.color}40;`}
          >
            {tool.badge}
          </span>
          <div class="tool-hub-name">{tool.name}</div>
          <div class="tool-hub-desc">{tool.description}</div>
          <div class="tool-hub-tags">
            {tool.tags.map((tag) => (
              <span class="tool-hub-tag">{tag}</span>
            ))}
          </div>
          <span class="tool-hub-cta" style={`color: ${tool.color};`}>
            {tool.cta} →
          </span>
        </a>
      ))
    }
  </div>

  <!-- QUICK DIAGNOSIS — turns "here are 3 tools" into "we'll help you diagnose the problem" -->
  <div class="diagnosis-section">
    <div class="diagnosis-header">
      <h2>Not Sure What's Wrong?</h2>
      <p>
        Don't know if it's a hardware fault or a settings issue? Follow this in
        under 2 minutes.
      </p>
    </div>
    <div class="diagnosis-steps">
      <div class="diag-step">
        <span class="diag-arrow" aria-hidden="true">→</span>
        <div class="diag-step-icon">🎯</div>
        <div class="diag-step-num">1</div>
        <div class="diag-step-title">Choose Your Device</div>
        <div class="diag-step-desc">
          Keyboard, mouse, or monitor — pick whichever one is acting up.
        </div>
      </div>
      <div class="diag-step">
        <span class="diag-arrow" aria-hidden="true">→</span>
        <div class="diag-step-icon">▶️</div>
        <div class="diag-step-num">2</div>
        <div class="diag-step-title">Run the Test</div>
        <div class="diag-step-desc">
          Usually done in under 60 seconds. No download, runs right in your
          browser.
        </div>
      </div>
      <div class="diag-step">
        <span class="diag-arrow" aria-hidden="true">→</span>
        <div class="diag-step-icon">📊</div>
        <div class="diag-step-num">3</div>
        <div class="diag-step-title">Understand the Result</div>
        <div class="diag-step-desc">
          Every metric is explained — good, needs investigation, or a known
          browser limitation.
        </div>
      </div>
      <div class="diag-step">
        <div class="diag-step-icon">🛠️</div>
        <div class="diag-step-num">4</div>
        <div class="diag-step-title">Fix the Problem</div>
        <div class="diag-step-desc">
          Follow the linked guide to fix a setting, or confirm it's genuinely a
          hardware issue.
        </div>
      </div>
    </div>
    <div class="diagnosis-cta">
      <a
        href="/tools/keyboard-latency-tester/"
        class="diag-cta-btn"
        data-astro-reload>⌨️ Start with Keyboard</a
      >
      <a href="/tools/mouse-rate-test/" class="diag-cta-btn" data-astro-reload
        >🖱 Start with Mouse</a
      >
      <a
        href="/tools/monitor-refresh-rate-test/"
        class="diag-cta-btn secondary"
        data-astro-reload>🖥️ Start with Monitor</a
      >
      <a
        href="/tools/screen-test/"
        class="diag-cta-btn secondary"
        data-astro-reload>🟦 Start with Screen</a
      >
      <a
        href="/tools/webcam-mic-speaker-test/"
        class="diag-cta-btn secondary"
        data-astro-reload
        >🎙️ Start with Webcam
      </a>
    </div>

    <!-- WHY US — differentiation block, not present before -->
    <div class="why-section">
      <h2
        style="font-size:1.15rem;font-weight:700;color:var(--text);margin-bottom:0.4rem;"
      >
        What Makes These Tools Different
      </h2>
      <p
        style="font-size:0.85rem;color:var(--text2);line-height:1.7;max-width:720px;"
      >
        Most online testers give you one number and stop there. Ours are built
        to be measurement instruments, not just pass/fail checkers.
      </p>
      <div class="why-grid">
        <div class="why-card">
          <div class="why-card-title">
            📊 Real statistics, not just averages
          </div>
          <div class="why-card-desc">
            Jitter, peak vs average, stability grading, min/max intervals — the
            numbers that tell you whether a reading is trustworthy.
          </div>
        </div>
        <div class="why-card">
          <div class="why-card-title">🎯 Honest about browser limits</div>
          <div class="why-card-desc">
            We tell you upfront where browser throttling affects a reading,
            instead of presenting every number as gospel.
