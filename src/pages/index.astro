---
import Base from "@layouts/Base.astro";

const pageUrl = "https://laptopsspecial.com/tools/";
const siteUrl = "https://laptopsspecial.com/";

const seoTitle = "Free PC Diagnostic Tools — Keyboard, Mouse & Monitor Testers";
const seoDescription =
    "All free browser-based hardware testing tools in one place. Test your keyboard latency, mouse polling rate, and monitor refresh rate — no downloads, no signup.";

const tools = [
    {
        icon: "⌨️",
        name: "Keyboard Tester",
        url: "/tools/keyboard-latency-tester/",
        color: "#00d4ff",
        badge: "Full 104-Key Test",
        description:
            "Test every key on your full-size keyboard including numpad, arrows, and function keys. Measures shortest press time and estimated scan rate live in your browser.",
        tags: ["Latency test", "Scan rate", "104-key layout"],
    },
    {
        icon: "🖱",
        name: "Mouse Rate Test",
        url: "/tools/mouse-rate-test/",
        color: "#a78bfa",
        badge: "Up to 8000Hz",
        description:
            "Check your mouse's real polling rate, click latency, jitter, and movement speed. Includes a live heatmap and CPS counter, with JSON/CSV export for deeper analysis.",
        tags: ["Polling rate", "Jitter", "Click latency"],
    },
    {
        icon: "🖥️",
        name: "Monitor Refresh Rate Test",
        url: "/tools/monitor-refresh-rate-test/",
        color: "#f59e0b",
        badge: "Live Hz + Grade",
        description:
            "Measure your screen's real refresh rate and frame consistency with a stability grade. Includes a motion clarity test and a VRR/G-Sync simulator to see the difference.",
        tags: ["Refresh rate", "Frame timing", "VRR simulator"],
    },
];

// CollectionPage + ItemList schema tying the hub together with the
// existing WebApplication pages via @id references.
// NOTE: item 3 uses "#software" fragment while items 1-2 use "#webapp" —
// verify this matches the actual @id set in monitor-refresh-rate-test.astro's
// own schema block. If that page also uses "#webapp", change this to match.
const collectionSchema = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${pageUrl}#collection`,
    url: pageUrl,
    name: seoTitle,
    description: seoDescription,
    isPartOf: { "@id": `${siteUrl}#website` },
    about: {
        "@type": "ItemList",
        itemListElement: [
            {
                "@type": "ListItem",
                position: 1,
                url: `${siteUrl}#webapp`,
                name: "Keyboard Tester",
            },
            {
                "@type": "ListItem",
                position: 2,
                url: `${siteUrl}mouse-rate-test/#webapp`,
                name: "Mouse Rate Test",
            },
            {
                "@type": "ListItem",
                position: 3,
                url: `${siteUrl}monitor-refresh-rate-test/#software`,
                name: "Monitor Refresh Rate Test",
            },
        ],
    },
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
        { "@type": "ListItem", position: 2, name: "Free Tools", item: pageUrl },
    ],
};

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
        {
            "@type": "Question",
            name: "Is my data uploaded or stored anywhere?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "No. Every test runs locally in your browser. Data never leaves your device or gets sent to any server.",
            },
        },
        {
            "@type": "Question",
            name: "Why does my 1000Hz mouse show a lower polling rate in the test?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "This is a browser limitation, not a mouse problem. Browsers throttle input event updates to conserve battery and CPU, so a 1000Hz mouse may display 60-120Hz in-browser even while reporting correctly at full rate.",
            },
        },
        {
            "@type": "Question",
            name: "Why is my keyboard stuck at 125Hz even on a gaming keyboard?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "Standard office and budget keyboards are hardware-locked to 125Hz regardless of software settings. Only keyboards explicitly rated 1000Hz+ can exceed this.",
            },
        },
        {
            "@type": "Question",
            name: "Are these tests actually accurate, or just an estimate?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "Browser-based tests measure input as it reaches your operating system, making them reliable for comparison. However, browsers typically cap visual updates around 60-120Hz, so a 1000Hz mouse may show a lower reading even when the hardware works correctly.",
            },
        },
        {
            "@type": "Question",
            name: "Do I need to install anything to use these tools?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "No. All three tools run entirely in your browser using native web APIs — nothing is installed, and no drivers are required.",
            },
        },
        {
            "@type": "Question",
            name: "Do these tools work on laptops and trackpads?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "Yes — the keyboard and mouse testers work with built-in laptop keyboards and trackpads as well as external peripherals, on any modern browser.",
            },
        },
        {
            "@type": "Question",
            name: "Which browser gives the most accurate results?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "Chromium-based browsers (Chrome, Edge) generally expose the most precise timing APIs for polling-rate and refresh-rate measurement.",
            },
        },
        {
            "@type": "Question",
            name: "Can these tools detect a faulty or dying peripheral?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "Yes, indirectly. Inconsistent jitter, keys that fail to register, or a refresh rate that won't hold steady are all signs worth investigating before assuming you need a replacement.",
            },
        },
    ],
};
---

<Base
    title={`${seoTitle} | Laptops Special`}
    description={seoDescription}
    canonical={pageUrl}
    noWebAppSchema={true}
>
    <style>
        .hub-hero {
            text-align: center;
            padding: 3rem 1.5rem 2rem;
        }
        .hub-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: rgba(0, 212, 255, 0.1);
            border: 1px solid rgba(0, 212, 255, 0.25);
            color: #00d4ff;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 0.3rem 0.8rem;
            border-radius: 100px;
            margin-bottom: 1.1rem;
        }
        [data-theme="light"] .hub-badge {
            background: rgba(2, 132, 199, 0.1);
            border-color: rgba(2, 132, 199, 0.3);
            color: #0284c7;
        }
        .hub-hero h1 {
            font-size: clamp(1.75rem, 4vw, 2.75rem);
            font-weight: 700;
            color: var(--text);
            margin-bottom: 0.75rem;
        }
        .hub-hero p {
            color: var(--text2);
            font-size: 1rem;
            max-width: 560px;
            margin: 0 auto;
            line-height: 1.7;
        }

        .tool-grid {
            max-width: 1080px;
            margin: 0 auto;
            padding: 1rem 1.5rem 3rem;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.25rem;
        }
        .tool-hub-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 1.5rem;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            transition: border-color 0.2s, transform 0.2s;
        }
        .tool-hub-card:hover {
            transform: translateY(-3px);
        }
        .tool-hub-icon {
            font-size: 2rem;
            margin-bottom: 0.75rem;
        }
        .tool-hub-badge {
            display: inline-block;
            font-size: 0.68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            padding: 0.2rem 0.55rem;
            border-radius: 100px;
            margin-bottom: 0.6rem;
            width: fit-content;
        }
        .tool-hub-name {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 0.5rem;
        }
        .tool-hub-desc {
            font-size: 0.85rem;
            color: var(--text2);
            line-height: 1.65;
            margin-bottom: 1rem;
            flex-grow: 1;
        }
        .tool-hub-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
            margin-bottom: 1.1rem;
        }
        .tool-hub-tag {
            font-size: 0.68rem;
            font-weight: 600;
            color: var(--muted);
            background: var(--bg3);
            border: 1px solid var(--border);
            padding: 0.2rem 0.55rem;
            border-radius: 6px;
        }
        .tool-hub-cta {
            font-size: 0.85rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }

        .hub-content {
            max-width: 760px;
            margin: 0 auto;
            padding: 1rem 1.5rem 4rem;
        }
        .hub-content h2 {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--text);
            margin: 2rem 0 0.75rem;
        }
        .hub-content p {
            color: var(--text2);
            font-size: 0.88rem;
            line-height: 1.8;
            margin-bottom: 0.9rem;
        }
        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
            margin: 1.5rem 0;
        }
        @media (max-width: 900px) {
            .info-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        @media (max-width: 560px) {
            .info-grid {
                grid-template-columns: 1fr;
            }
        }
        .info-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 1rem;
        }
        .info-card-icon {
            font-size: 1.2rem;
            margin-bottom: 0.45rem;
        }
        .info-card-title {
            font-size: 0.83rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 0.3rem;
        }
        .info-card-desc {
            font-size: 0.78rem;
            color: var(--text2);
            line-height: 1.55;
        }
        .trust-strip {
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            flex-wrap: wrap;
            padding: 0 1.5rem 2rem;
            max-width: 900px;
            margin: 0 auto;
        }
        .trust-item {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.78rem;
            color: var(--muted);
            font-weight: 600;
        }
        .faq-list {
            display: flex;
            flex-direction: column;
            gap: 0.7rem;
            margin-top: 1rem;
        }
        .faq-item {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 0.95rem;
        }
        .faq-q {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 0.35rem;
        }
        .faq-a {
            font-size: 0.8rem;
            color: var(--text2);
            line-height: 1.65;
        }
    </style>

    <div class="hub-hero">
        <div class="hub-badge">🟢 100% Free — No Signup</div>
        <h1>Free PC Diagnostic Tools</h1>
        <p>
            Browser-based tools to test your keyboard, mouse, and monitor —
            instantly, with no downloads. Built for gamers, builders, and
            anyone troubleshooting their setup.
        </p>
    </div>
    <div class="trust-strip">
        <span class="trust-item">🚫 No downloads</span>
        <span class="trust-item">🔒 Runs locally in your browser</span>
        <span class="trust-item">⚡ Instant results</span>
        <span class="trust-item">🆓 100% free, no signup</span>
    </div>
    <div class="tool-grid">
        {tools.map((tool) => (
            <a href={tool.url} class="tool-hub-card" data-astro-reload>
                <div class="tool-hub-icon">{tool.icon}</div>
                <span
                    class="tool-hub-badge"
                    style={`background: ${tool.color}1A; color: ${tool.color}; border: 1px solid ${tool.color}40;`}
                >
                    {tool.badge}
                </span>
                <div class="tool-hub-name">{tool.name}</div>
                <div class="tool-hub-desc">{tool.description}</div>
                <div class="tool-hub-tags">
                    {tool.tags.map((tag) => (
                        <span class="tool-hub-tag">{tag}</span>
                    ))}
                </div>
                <span class="tool-hub-cta" style={`color: ${tool.color};`}>
                    Open tool →
                </span>
            </a>
        ))}
    </div>

    <div class="hub-content">
        <h2>Common Problems These Tools Help You Diagnose</h2>
        <div class="info-grid">
            <div class="info-card">
                <div class="info-card-icon">⌨️</div>
                <div class="info-card-title">Keys not registering or repeating</div>
                <div class="info-card-desc">
                    Stuck keys, double inputs, or dead zones on your keyboard? Test
                    every key individually before assuming it's a hardware failure.
                </div>
            </div>
            <div class="info-card">
                <div class="info-card-icon">🖱</div>
                <div class="info-card-title">Cursor feels laggy or inconsistent</div>
                <div class="info-card-desc">
                    Verify your mouse is actually hitting its rated polling rate —
                    many "gaming" mice ship running below spec out of the box.
                </div>
            </div>
            <div class="info-card">
                <div class="info-card-icon">🖥️</div>
                <div class="info-card-title">Monitor not showing full refresh rate</div>
                <div class="info-card-desc">
                    A 144Hz monitor plugged in wrong (cable, port, or Windows
                    setting) often silently runs at 60Hz. Confirm what you're
                    actually getting.
                </div>
            </div>
            <div class="info-card">
                <div class="info-card-icon">🛒</div>
                <div class="info-card-title">Buying a used or refurbished PC</div>
                <div class="info-card-desc">
                    Before buying secondhand hardware, run a full check on the
                    keyboard, mouse, and display — takes under a minute per device.
                </div>
            </div>
        </div>

        <h2>Why Test Online Instead of Calling a Technician?</h2>
        <p>
            Most keyboard, mouse, and monitor issues aren't hardware failures — they're
            driver conflicts, wrong Windows settings, or a cable running below spec.
            Testing in-browser first means you skip the diagnostic fee and know
            exactly what's wrong before spending money on a repair or replacement.
        </p>

        <h2>Frequently Asked Questions</h2>
        <div class="faq-list">
            <div class="faq-item">
                <div class="faq-q">Is my data uploaded or stored anywhere?</div>
                <div class="faq-a">
                    No. Every test runs locally in your browser. Key presses, mouse
                    movement, and refresh-rate measurements never leave your device
                    or get sent to any server.
                </div>
            </div>
            <div class="faq-item">
                <div class="faq-q">Why does my 1000Hz mouse show a lower polling rate in the test?</div>
                <div class="faq-a">
                    This is a browser limitation, not a problem with your mouse.
                    Browsers typically throttle input event updates to conserve
                    battery and CPU, so a 1000Hz mouse may display 60–120Hz in-browser
                    even though the hardware is reporting correctly at full rate.
                </div>
            </div>
            <div class="faq-item">
                <div class="faq-q">Why is my keyboard stuck at 125Hz even on a gaming keyboard?</div>
                <div class="faq-a">
                    Standard office and budget keyboards are hardware-locked to
                    125Hz regardless of software settings. Only keyboards explicitly
                    marketed with 1000Hz+ polling (common in gaming keyboards) can
                    exceed this — check your keyboard's spec sheet to confirm.
                </div>
            </div>
            <div class="faq-item">
                <div class="faq-q">Are these tests actually accurate, or just an estimate?</div>
                <div class="faq-a">
                    Browser-based tests measure input as it reaches your operating
                    system — through the same path any game or app would receive it.
                    This makes them highly reliable for comparison purposes, though a
                    browser can't bypass OS-level polling limits. For example, most
                    browsers cap visual updates around 60–120Hz, so a 1000Hz mouse
                    may show a lower number even when the hardware itself is working
                    correctly.
                </div>
            </div>
            <div class="faq-item">
                <div class="faq-q">Do I need to install anything to use these tools?</div>
                <div class="faq-a">
                    No. All three tools run entirely in your browser using native
                    web APIs — nothing is installed, and no drivers are required.
                </div>
            </div>
            <div class="faq-item">
                <div class="faq-q">Do these tools work on laptops and trackpads?</div>
                <div class="faq-a">
                    Yes — the keyboard and mouse testers work with built-in laptop
                    keyboards and trackpads as well as external peripherals, on any
                    modern browser.
                </div>
            </div>
            <div class="faq-item">
                <div class="faq-q">Which browser gives the most accurate results?</div>
                <div class="faq-a">
                    Chromium-based browsers (Chrome, Edge) generally expose the most
                    precise timing APIs for polling-rate and refresh-rate
                    measurement. Firefox and Safari work fine too, but numbers can
                    vary slightly between browsers due to differences in event
                    throttling.
                </div>
            </div>
            <div class="faq-item">
                <div class="faq-q">Can these tools detect a faulty or dying peripheral?</div>
                <div class="faq-a">
                    Yes, indirectly. Inconsistent jitter on the mouse test, keys that
                    fail to register on the keyboard tester, or a refresh rate that
                    won't hold steady on the monitor test are all signs worth
                    investigating further — often before assuming you need a
                    replacement.
                </div>
            </div>
        </div>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Base>
