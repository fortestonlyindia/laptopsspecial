      color: var(--text2);
    }
    .cta-box {
      background: linear-gradient(
        135deg,
        rgba(0, 212, 255, 0.08),
        rgba(124, 58, 237, 0.1)
      );
      border: 1px solid rgba(0, 212, 255, 0.2);
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
      margin: 2rem 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .cta-box a {
