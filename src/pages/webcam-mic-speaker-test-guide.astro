      font-weight: 600;
      color: var(--text);
      margin-bottom: 0.35rem;
    }
    .faq-a {
      font-size: 0.82rem;
      color: var(--text2);
      line-height: 1.65;
    }
    table.spec-table {
      width: 100%;
      border-collapse: collapse;
      margin: 1rem 0;
      font-size: 0.84rem;
    }
