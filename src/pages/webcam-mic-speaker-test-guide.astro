---
import Base from "@layouts/Base.astro";

const pageUrl = "https://laptopsspecial.com/webcam-mic-speaker-test-guide/";
const siteUrl = "https://laptopsspecial.com/";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${pageUrl}#breadcrumb`,
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    {
      "@type": "ListItem",
      position: 2,
      name: "Webcam, Mic & Speaker Test Guide",
      item: pageUrl,
    },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq`,
  mainEntity: [
    {
      "@type": "Question",
      name: "Why is my webcam FPS lower than advertised?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Most webcams auto-drop their frame rate in low light to keep the image bright enough, trading FPS for exposure time. This is a driver-level decision, not a browser limitation — try adding more light and re-testing.",
      },
    },
    {
      "@type": "Question",
      name: "What's a normal mic noise floor?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "In a quiet room, your mic's noise floor reading should sit well under 10% on a relative 0-100% scale. Readings consistently above that during silence usually point to fan noise, USB interference, or mic gain set too high rather than a broken microphone.",
      },
    },
    {
      "@type": "Question",
      name: "Why does audio clip even though my mic volume looks normal in Windows?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Windows/macOS input volume sliders don't always reflect the gain applied before the signal reaches the browser. If the clipping counter in the test climbs while you talk at a normal volume, lower the input gain a few steps in your OS sound settings and re-test.",
      },
    },
    {
      "@type": "Question",
      name: "What does the Electrical Hum reading mean?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "It checks for elevated energy specifically at mains frequency (50Hz or 60Hz depending on your region) and its harmonics, which is a strong signature of ground loops, unshielded USB cables, or a mic placed too close to a power adapter. Try a different USB port or move the mic away from chargers if hum is detected.",
      },
    },
    {
      "@type": "Question",
      name: "What is AGC noise pumping and why does it matter?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Many drivers and cheap mics apply Automatic Gain Control, which boosts gain during quiet moments and reduces it during loud ones. This shows up as the background noise floor rising right after you stop talking, then settling back down — a pattern that can make quiet moments sound 'breathy' to others on a call.",
      },
    },
    {
      "@type": "Question",
      name: "How accurate is the speaker distortion (THD) test?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "It's a loopback estimate, not a lab measurement — it plays a test tone and listens back through your own microphone, so the mic's own harmonic response and room acoustics are baked into the number. Use it to compare volume levels or speaker positions on your own setup rather than against a manufacturer's published spec.",
      },
    },
  ],
};
---

<Base
  title="Webcam, Mic & Speaker Test Guide — How to Read the Results"
  description="Understand what FPS, light level, sharpness, mic noise floor, clipping, and speaker channel tests actually mean, and how to fix the most common camera/mic/speaker problems."
  canonical={pageUrl}
  ogImage="https://laptopsspecial.com/og/webcam-mic-speaker-test-guide.png"
>
  <style>
    .guide-wrap {
      max-width: 760px;
      margin: 0 auto;
      padding: 3rem 1.5rem 4rem;
    }
    .guide-wrap h1 {
